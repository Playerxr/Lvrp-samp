// [ARMEE] Solde de l'etat-major : montant, periode, et QUELLE faction.
// ARMEE_PAIE_MEMBER = 13 : la Marine uniquement. L'Armee de Terre (11) et
// l'Armee de l'Air (12) ne touchent rien. Changer ce seul nombre suffit a
// deplacer la solde sur une autre faction.
#define ARMEE_PAIE_MEMBER  13
#define ARMEE_PAIE_RANG6   300000
#define ARMEE_PAIE_MINUTES 30
new ArmeePaie_Time[MAX_PLAYERS];

// [DEPLACE] PaieAuto_Tick et Peage_Tick - timers critiques pour les paies/peages

// ----------------------------------------------------------------------------
// Salaire par job (montants en $, payes chaque heure de jeu en service)
stock GetJobPaie(jobid)
{
    switch(jobid)
    {
        case 1: return 8000;   // Routier
        case 2: return 7500;   // Boueur
        case 3: return 9000;   // Bus / Taxi
        case 4: return 10000;  // Mecano
        case 5: return 6000;   // Pecheur
        case 6: return 8500;   // Livreur Pizza
        case 7: return 7000;   // Forestier
        case 8: return 9500;   // Convoyeur
        case 9: return 7000;   // Agriculteur
        case 10: return 8000;  // Pilote
    }
    return 5000; // Defaut
}

public PaieAuto_Tick()
{
    for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
    {
        if(!IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
        if(gPlayerLogged[i] != 1) continue;

        // [ARMEE] Solde du rang 6 de la MARINE uniquement : 300.000$ / 30 min.
        // Placee AVANT le "continue" des jobs : un amiral n'a pas de job civil,
        // sinon il ne serait jamais paye.
        // Le rang est teste avec == et non >= : seul le rang 6 est concerne.
        if(PlayerInfo[i][pMember] == ARMEE_PAIE_MEMBER && PlayerInfo[i][pRank] == 6)
        {
            // Seul le temps passe EN SERVICE compte : sans cette condition, un
            // amiral touchait 300.000$ en restant gare chez lui.
            // Sortir du service met le compteur en PAUSE au lieu de le remettre
            // a zero : le grade se perd, pas les minutes deja servies. Un
            // aller-retour hors service ne fait donc ni gagner ni perdre de
            // temps, il n'y a rien a exploiter dans un sens ni dans l'autre.
            if(armee_Duty[i] == 1)
            {
                ArmeePaie_Time[i]++;
                if(ArmeePaie_Time[i] >= ARMEE_PAIE_MINUTES)
                {
                    ArmeePaie_Time[i] = 0;
                    SafeGivePlayerMoney(i, ARMEE_PAIE_RANG6, "Solde etat-major marine");
                    new astring[200];
                    format(astring, sizeof(astring), "{00CED1} Marine {FFFFFF} Solde d'etat-major : ${FFFF00}%d{FFFFFF} (%d minutes de service).", ARMEE_PAIE_RANG6, ARMEE_PAIE_MINUTES);
                    msg_Client(i, COLOR_WHITE, astring);
                }
            }
        }
        // Quitter la Marine ou perdre le rang 6 remet bien le compteur a zero.
        else ArmeePaie_Time[i] = 0;

        new currentJob = PlayerInfo[i][pJob];
        // Paie auto pour les JOBS uniquement (les factions l�gales sont payees par le systeme existant duty)
        if(currentJob <= 0) continue;

        // Reset compteur si changement de job
        if(PaieAuto_LastJob[i] != currentJob)
        {
            PaieAuto_Time[i] = 0;
            PaieAuto_LastJob[i] = currentJob;
        }

        // Incremente compteur (1 minute par tick)
        PaieAuto_Time[i]++;

        // Toutes les 60 minutes (1h de service), on paie
        if(PaieAuto_Time[i] >= 60)
        {
            PaieAuto_Time[i] = 0;
            new montant = GetJobPaie(currentJob);
            // [BIENVENUE] boost 72h premiere apparition : paie horaire doublee
            new mult = Bienvenue_PayMultiplier(i);
            montant *= mult;
            SafeGivePlayerMoney(i, montant, "Paie horaire job");
            Saison_AddXp(i, SAI_XP_PAIE);   // [SAISON] travailler fait progresser
            Obj_Progress(i, OBJ_ARGENT, montant);   // [OBJECTIFS] argent gagne en travaillant
            new pstring[180];
            if(mult > 1)
                format(pstring, sizeof(pstring), "{00FF00}\xbb Paie horaire \xab{FFFFFF} Vous recevez ${FFFF00}%d{FFFFFF} pour 1h de travail {FFD700}(x%d bonus nouveau joueur){FFFFFF}.", montant, mult);
            else
                format(pstring, sizeof(pstring), "{00FF00}\xbb Paie horaire \xab{FFFFFF} Vous recevez ${FFFF00}%d{FFFFFF} pour 1h de travail.", montant);
            msg_Client(i, COLOR_WHITE, pstring);
        }
    }
    return 1;
}

public Peage_Tick()
{
    new Float:px, Float:py, Float:pz;
    new tnow = gettime();

    // 1) Auto-fermeture des barrieres dont le timer est expir�
    for(new p=0; p<MAX_PEAGES; p++)
    {
        if(Peages[p][peActive] != 1) continue;
        if(Peages[p][peBarrier] != 0 && Peages[p][peBarrierOpenUntil] != 0 && tnow >= Peages[p][peBarrierOpenUntil])
        {
            // Fermer la barriere (rotation Y a 0)
            MoveDynamicObject(Peages[p][peBarrier],
                Peages[p][peX], Peages[p][peY], Peages[p][peZ] - 0.2,
                2.0,
                0.0, 0.0, Peages[p][peAngle]);
            Peages[p][peBarrierOpenUntil] = 0;
        }
    }

    // 2) Detection joueurs et facturation
    for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
    {
        if(!IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
        if(gPlayerLogged[i] != 1) continue;
        if(!IsPlayerInAnyVehicle(i)) continue; // Peage seulement en voiture

        GetPlayerPos(i, px, py, pz);
        new currentZone = -1;
        for(new p=0; p<MAX_PEAGES; p++)
        {
            if(Peages[p][peActive] != 1) continue;
            new Float:dx = px - Peages[p][peX];
            new Float:dy = py - Peages[p][peY];
            if(floatsqroot(dx*dx + dy*dy) < Peages[p][peRadius])
            {
                currentZone = p;
                break;
            }
        }
        if(currentZone != -1 && Peage_PlayerLastZone[i] != currentZone)
        {
            Peage_PlayerLastZone[i] = currentZone;
            // Police/FBI/Mairie/Pompiers/Medic/Armee/Justice/Hopital = exemption
            new pmem = PlayerInfo[i][pMember];
            if((pmem >= 1 && pmem <= 13) || pmem == FACTION_JUSTICE || pmem == FACTION_HOPITAL || AdminDuty[i] == 1)
            {
                msg_Client(i, COLOR_WHITE, "{FFAA00}\xbb P\xe9age \xab{FFFFFF} Service de l'Etat - passage gratuit.");
                // Ouvrir la barriere quand meme pour qu'il passe (rotation Y a 90)
                if(Peages[currentZone][peBarrier] != 0)
                {
                    MoveDynamicObject(Peages[currentZone][peBarrier],
                        Peages[currentZone][peX], Peages[currentZone][peY], Peages[currentZone][peZ] - 0.2,
                        2.0,
                        0.0, 90.0, Peages[currentZone][peAngle]);
                    Peages[currentZone][peBarrierOpenUntil] = tnow + PEAGE_OPEN_DURATION;
                }
                continue;
            }
            // Verif cash
            if(PlayerInfo[i][pCash] < Peages[currentZone][pePrix])
            {
                new ps[160];
                format(ps, sizeof(ps), "{FFAA00}\xbb P\xe9age \xab{FFFFFF} Pas assez d'argent ! Co\xfbt : {FF0000}%d${FFFFFF}. Barri\xe8re ferm\xe9e.", Peages[currentZone][pePrix]);
                msg_Client(i, COLOR_WHITE, ps);
                continue;
            }
            // Paiement OK
            SafeGivePlayerMoney(i, -Peages[currentZone][pePrix], "Peage");
            new ps[140];
            format(ps, sizeof(ps), "{FFAA00}\xbb P\xe9age \xab{FFFFFF} %s : {FF0000}-%d${FFFFFF}", Peages[currentZone][peName], Peages[currentZone][pePrix]);
            msg_Client(i, COLOR_WHITE, ps);
            // Ouvrir la barriere (rotation Y a 90)
            if(Peages[currentZone][peBarrier] != 0)
            {
                MoveDynamicObject(Peages[currentZone][peBarrier],
                    Peages[currentZone][peX], Peages[currentZone][peY], Peages[currentZone][peZ] - 0.2,
                    2.0,
                    0.0, 90.0, Peages[currentZone][peAngle]);
                Peages[currentZone][peBarrierOpenUntil] = tnow + PEAGE_OPEN_DURATION;
            }
        }
        else if(currentZone == -1 && Peage_PlayerLastZone[i] != -1)
        {
            Peage_PlayerLastZone[i] = -1;
        }
    }
    return 1;
}

// ============================================================================
// === SYSTEME GANG ZONES / TERRITOIRES (visible sur la map style GTA SA) ===
// ============================================================================
// Necessite la table MySQL `lvrp_turfs` :
//   CREATE TABLE IF NOT EXISTS lvrp_turfs (
//     id INT AUTO_INCREMENT PRIMARY KEY,
//     Name VARCHAR(64) DEFAULT '',
//     MinX FLOAT DEFAULT 0, MinY FLOAT DEFAULT 0,
//     MaxX FLOAT DEFAULT 0, MaxY FLOAT DEFAULT 0,
//     Color INT UNSIGNED DEFAULT 4278190158,  -- 0xFF00009E
//     Owner VARCHAR(64) DEFAULT 'Aucun'
//   );

#define MAX_TURFS 50

enum TurfInfoEnum
{
    tUsed,
    tName[64],
    Float:tMinX,
    Float:tMinY,
    Float:tMaxX,
    Float:tMaxY,
    tColor,
    tOwner[64],
    tSQLID,
    tGangZone,
    tType,           // 0=gang (capturable), 1=police (protection vert), 2=hopital (protection rose)
    tLastCapture     // Timestamp gettime() de la derniere capture (cooldown 6h)
};
new Turfs[MAX_TURFS][TurfInfoEnum];
new turf_LoadedCount = 0;
new player_CurrentTurf[MAX_PLAYERS] = {-1, ...};  // [TURF] Zone actuelle de chaque joueur (-1 = hors zone)
new player_TurfColorId[MAX_PLAYERS] = {-1, ...};  // [TURF] Id de la zone en cours d'�dition de couleur
new player_FactionBuyModel[MAX_PLAYERS] = {0, ...};  // [FACTION BUY] model en cours d'achat
new player_FactionBuyFacID[MAX_PLAYERS] = {-1, ...}; // [FACTION BUY] faction qui achet�

// === SYSTEME DE CAPTURE DE TERRITOIRE ===
#define TURF_CAPTURE_TICKS    150       // 5 minutes a 2sec/tick = 150 ticks pour capturer
#define TURF_CAPTURE_COOLDOWN 172800    // 48h en secondes entre 2 captures de la meme zone
// === MODE BATAILLE DE GANGS ===
#define GANGWAR_CAPTURE_TICKS  60       // 2 minutes en mode bataille (60 ticks * 2s)
#define GANGWAR_COOLDOWN       3600     // 1h cooldown en mode bataille
#define GANGWAR_REWARD         500000   // 500 000$ pour le gang vainqueur
new gangWar_Active = 0;                  // 0=desactive, 1=actif
// =====================================================
// === AFRP PHONE - Variables globales
// =====================================================
new usingPhone[MAX_PLAYERS];
new hasPhone[MAX_PLAYERS];
new playerNumber[MAX_PLAYERS];
new playerCredit[MAX_PLAYERS];

// AFRP Phone: arrays UI geres dans pTD[MAX_PLAYERS][150]
new bool:phoneUICreated[MAX_PLAYERS];
new phoneTheme[MAX_PLAYERS];
new phoneModel[MAX_PLAYERS];    // 0=aucun, 1=Nokia 3310, 2=Samsung S22 Ultra
new smsTarget[MAX_PLAYERS];
new waGroupDelay[MAX_PLAYERS];
// === AFRP Trading - portefeuille (4 actifs: BTC, ETH, OR, Action AFRP) ===
new tradeHolding[MAX_PLAYERS][4];
new tradeSelAsset[MAX_PLAYERS];
new const TRADE_BASE[4] = {50000, 3000, 1800, 120};
new const TRADE_AMP[4]  = {4000, 350, 120, 14};
new const TRADE_NAMES[4][] = {"Bitcoin AFRP","Ethereum AFRP","Or (once)","Action AFRP Corp"};

