		        msg_Client(Clicked[playerid],COLOR_INFO,"{CF9756} Info {FFFFFF} Vous avez t soign par un admin.");
		        format(string,sizeof(string),"{FF2727} Admin {FFABAD} Vous avez restaur la vie de %s.",sendername);
		        msg_Client(playerid,COLOR_WHITE,string);
