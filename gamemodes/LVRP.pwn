			else if(strcmp(tmp,"vrang",true) == 0)
			{
				if(PlayerInfo[playerid][pRank]< 6)
					{msg_Client(playerid,COLOR_GREY,"{00673A} San News {FFFFFF} Vous devez tes rang 8 ou plus pour faire cette action.");return 1;}
				if(GetPlayerState(playerid) != 2)
					{msg_Client(playerid,COLOR_GREY,"{00673A} San News {FFFFFF} Vous devez tre dans un vhicule ou au volant de ce vhicule");return 1;}
				if(vehicle[idcar][cType] == PlayerInfo[playerid][pMember])
				{
