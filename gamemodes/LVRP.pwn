		}
		else if(strcmp(cmd, "/acceptadmin", true) == 0)
		{
			if(PlayerInfo[playerid][pAdmin] < 5)
				return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Acc�s refus�. Admin niveau 5+ requis.");

			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
				return msg_Client(playerid, COLOR_WHITE, "{A98500}[Usage]{FFFFFF} /acceptadmin [num demande] [niveau 1-4]");

			new ad_num = strval(tmp);
			tmp = strtok(cmdtext, idx);
			new ad_niveau = strval(tmp);

			if(ad_num < 0 || ad_num >= AdminDemandesCount)
				return msg_Client(playerid, COLOR_RED, "{FF6347}Numero de demande invalide. Tapez /demandes pour voir la liste.");
			if(ad_niveau < 1 || ad_niveau > 4)
				return msg_Client(playerid, COLOR_RED, "{FF6347}Niveau invalide. Choisissez entre 1 et 4.");

			new ad_sqlid = AdminDemandes[ad_num][ad_PlayerSQLID];
			new ad_name[MAX_PLAYER_NAME+1];
			strmid(ad_name, AdminDemandes[ad_num][ad_Name], 0, MAX_PLAYER_NAME, MAX_PLAYER_NAME+1);

			// Mettre a jour DB
			new ad_query[256];
			format(ad_query, sizeof(ad_query),
				"UPDATE lvrp_users SET AdminLevel=%d WHERE id=%d",
				ad_niveau, ad_sqlid);
			mysql_tquery(MYSQL, ad_query, "", "");

			format(ad_query, sizeof(ad_query),
				"UPDATE lvrp_admin_demandes SET Statut=1, TraiteePar='%s' WHERE SQLid=%d",
				PlayerInfo[playerid][pName], ad_sqlid);
			mysql_tquery(MYSQL, ad_query, "", "");

			// Notifier le joueur s'il est connect�
			for(new i = 0; i < MAX_PLAYERS; i++)
			{
				if(!IsPlayerConnected(i)) continue;
				if(PlayerInfo[i][pSQLID] == ad_sqlid)
				{
					PlayerInfo[i][pAdmin] = ad_niveau;
					PlayerHasPendingDemande[i] = false;
					new ad_wmsg[256];
					format(ad_wmsg, sizeof(ad_wmsg), "{9EC73D}[FELICITATIONS]{FFFFFF} Votre candidature admin a �t� ACCEPTEE ! Vous etes maintenant Admin niveau %d.", ad_niveau);
					SendClientMessage(i, 0x00FF00FF, ad_wmsg);
					break;
				}
			}

			// Retirer de la liste en memoire
			for(new di = ad_num; di < AdminDemandesCount - 1; di++)
			{
				AdminDemandes[di] = AdminDemandes[di + 1];
			}
			AdminDemandesCount--;

			// Log pour admins
			new ad_log[256];
			format(ad_log, sizeof(ad_log), "{9EC73D}[ADMIN ACCEPT]{FFFFFF} %s a accept� la candidature de %s -> Admin Niv.%d", PlayerInfo[playerid][pName], ad_name, ad_niveau);
			msg_Admin(COLOR_GREEN, ad_log, 3);
			msg_Client(playerid, COLOR_GREEN, "{9EC73D}[OK]{FFFFFF} Candidature acceptee avec succes !");
			return 1;
		}
