		    return 1;
		}

		// AMELIORATION TEL REALISTE : si pas un player ID connect�, traiter comme numero de tel
		new bool:isNumLookup = false;
		if(!IsPlayerConnected(target_call) || IsPlayerNPC(target_call))
		{
		    // Cherche joueur avec ce numero de telephone
		    new found_id = -1;
		    for(new p=0; p<MAX_PLAYERS_CURRENT+1; p++)
		    {
		        if(!IsPlayerConnected(p) || IsPlayerNPC(p)) continue;
		        if(PlayerInfo[p][pNumber] == target_call) {found_id = p; break;}
		    }
		    if(found_id == -1)
		    {
		        msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Tel \xab{FFFFFF} Le num\xe9ro que vous demandez n'est pas joignable.");
		        return 1;
		    }
		    target_call = found_id;
		    isNumLookup = true;
		}

		if(target_call == playerid) {return msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Info \xab{FFFFFF} Vous ne pouvez pas vous appeler vous-m\xeame.");}
		if(isUsingRadioVoip[playerid]) {return msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} Vous \xeates en radio VOIP.");}
		if(isUsingRadioVoip[target_call]) {return msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} Ce joueur est en radio VOIP.");}
		// Verifier que la cible a aussi un telephone
		if(hasPhone[target_call] == 0)
		{
		    msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Info \xab{FFFFFF} Le destinataire n'a pas de t\xe9l\xe9phone.");
		    return 1;
		}

		// Debiter les 10$ de credit
		SafeGivePlayerMoney(playerid, -10, "Appel telephone");

		// EMOTE TELEPHONE STYLE CJ : animation main a l'oreille
		// FIX BUG : ne pas appliquer l'animation si le joueur est en vehicule (sinon ejection)
		if(!IsPlayerInAnyVehicle(playerid))
		{
		    ApplyAnimation(playerid, "PED", "phone_in", 4.1, 0, 0, 0, 0, 0);
		    ApplyAnimation(playerid, "PED", "phone_talk", 4.1, 1, 0, 0, 0, 0);
		}

		new cHas = GetPVarInt(playerid, "hasVoiceOnClient");
		new tHas = GetPVarInt(target_call, "hasVoiceOnClient");

		// Sonnerie + emote pour la cible (qui doit decrocher avec /call <playerid>)
		ApplyAnimation(target_call, "PED", "phone_in", 4.1, 0, 0, 0, 0, 0);

		// AMELIORATION TEL REALISTE : Affichage du nom du contact si dans le repertoire de la cible
		new callerDisplay[64];
		new fromnum = PlayerInfo[playerid][pNumber];
		new contactIdx = Phone_FindContactByNum(target_call, fromnum);
		if(contactIdx != -1)
		    {format(callerDisplay, sizeof(callerDisplay), "%s", PhoneContact_Name[target_call][contactIdx]);}
		else
		    {format(callerDisplay, sizeof(callerDisplay), "Inconnu (%d)", fromnum);}

		format(string, sizeof(string), "{8B8B00}\xbb T\xe9l\xe9phone \xab{FFFFFF} {00FF00}*RING*{FFFFFF} %s vous appelle. Tapez {FFFF00}/call %d{FFFFFF} pour d\xe9crocher.", callerDisplay, playerid);
		msg_Client(target_call, COLOR_WHITE, string);
		PlayerPlaySound(target_call, 21000, 0.0, 0.0, 0.0); // son sonnerie

		// AMELIORATION : enregistrer l'appel manque cote cible (sera valide si elle ne d�croche pas)
		Phone_AddMissedCall(target_call, fromnum, callerDisplay);

		if(cHas == 1) { isUsingPhoneVoip[playerid] = true; CallRemoteFunction("JoinPrivateVoiceChannel", "ii", playerid, target_call); }
		else { msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} Vous n'avez pas le plugin VOIP."); }
		if(tHas == 1) { isUsingPhoneVoip[target_call] = true; CallRemoteFunction("JoinPrivateVoiceChannel", "ii", target_call, playerid); }
		else { msg_Client(target_call, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} L'appelant n'a pas le plugin VOIP."); }

		if(isNumLookup)
		    {format(string, sizeof(string), "{8B8B00}\xbb T\xe9l\xe9phone \xab{FFFFFF} Appel en cours vers num %d... ({FFFF00}-10${FFFFFF})", PlayerInfo[target_call][pNumber]);}
		else
		    {format(string, sizeof(string), "{8B8B00}\xbb T\xe9l\xe9phone \xab{FFFFFF} Appel en cours avec %s... ({FFFF00}-10${FFFFFF})", PlayerInfo[target_call][pRealName]);}
		msg_Client(playerid, COLOR_WHITE, string);
		return 1;
	}

	// ===================================================
