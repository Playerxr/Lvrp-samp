	// === [TURF COLOR] Dialog choix couleur d'un territoire ===
	if(dialogid == 7110)
	{
		if(response == 0)
		{
			player_TurfColorId[playerid] = -1;
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Changement de couleur annul�.");
		}
		new tid = player_TurfColorId[playerid];
		player_TurfColorId[playerid] = -1;
		if(tid < 0 || tid >= MAX_TURFS || Turfs[tid][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Territoire invalide.");
		new newColor;
		switch(listitem)
		{
			case 0: newColor = 0xFF0000AA;  // Rouge
			case 1: newColor = 0x0000FFAA;  // Bleu
			case 2: newColor = 0xFFFF00AA;  // Jaune
			case 3: newColor = 0x800080AA;  // Violet
			case 4: newColor = 0xFFA500AA;  // Orange
			case 5: newColor = 0x00FFFFAA;  // Cyan
			case 6: newColor = 0xFFFFFFAA;  // Blanc
			case 7: newColor = 0x8B4513AA;  // Marron
			case 8: newColor = 0x00FF00AA;  // Vert
			case 9: newColor = 0xFF69B4AA;  // Rose
			default: return 1;
		}
		Turfs[tid][tColor] = newColor;
		// Mettre a jour visuellement la zone pour tous les joueurs
		if(Turfs[tid][tGangZone] >= 0)
		{
			GangZoneHideForAll(Turfs[tid][tGangZone]);
			GangZoneShowForAll(Turfs[tid][tGangZone], newColor);
		}
		// Mettre a jour la BDD
		new colorSql[180];
		format(colorSql, sizeof(colorSql), "UPDATE lvrp_turfs SET Color=%d WHERE id=%d", newColor, Turfs[tid][tSQLID]);
		mysql_tquery(MYSQL, colorSql, "", "");
		new okmsg[140];
		format(okmsg, sizeof(okmsg), "{9EC73D}[TURF]{FFFFFF} Couleur du territoire %s mise a jour.", Turfs[tid][tName]);
		msg_Client(playerid, COLOR_GREEN, okmsg);
		return 1;
	}

