	// On garde uniquement les vraies erreurs/warnings, pas le debug verbeux.
	mysql_log(ERROR | WARNING);
	//MapAndreas_Init(MAP_ANDREAS_MODE_FULL);
	print("[MYSQL] Connexion en cours ...");
	if (!MySQLConnect(MYSQL_HOST,MYSQL_USER,MYSQL_PASS,MYSQL_DB))
	    {return 0;}
	// [MOBILE INLINE] init du module smartphone (cree les pickups marche)
