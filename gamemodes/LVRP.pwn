						    {return msg_Client(playerid, COLOR_WHITE, "{8BE2E2} Vhicule {FFFFFF} Il y a dj un cadavre dans le coffre.");}
					    vehicle[mycar][cBody]=player_CarryBody[playerid];
                        body_StopCarry(playerid,1);
