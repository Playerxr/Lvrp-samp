    // === Dialog 9994 : Vote president ===
    if(dialogid == 9994)
    {
        if(!response) return 1;
        // Trouver le candidat correspondant a listitem
        new candIdx = -1;
        new shown = 0;
        for(new c=0; c<MAX_CANDIDATS; c++)
        {
            if(Candidats[c][cActive] != 1) continue;
            if(shown == listitem)
            {
                candIdx = c;
                break;
            }
            shown++;
        }
        if(candIdx == -1) return 1;
        Candidats[candIdx][cVotes]++;
        Vote_HasVoted[playerid] = 1;
        new vmsg[150];
        format(vmsg, sizeof(vmsg), "{00FF00} Vote {FFFFFF} Vous avez vot\xe9 pour {FFFF00}%s{FFFFFF} ({FF6347}%s{FFFFFF}). Merci !",
            Candidats[candIdx][cName], Candidats[candIdx][cParti]);
        msg_Client(playerid, COLOR_WHITE, vmsg);
        return 1;
    }
    if(dialogid == 9997) // T�l�phone realiste - repertoire
    {
        if(PhoneDialog_State[playerid] == 0)
        {
            // Menu principal
            if(!response) return 1;
            if(listitem == 0)      // Repertoire
                {Phone_ShowContacts(playerid); return 1;}
            else if(listitem == 1) // Appels manques
                {Phone_ShowMissed(playerid); return 1;}
            else if(listitem == 2) // Ajouter contact
            {
                if(PhoneContact_Count[playerid] >= MAX_PHONE_CONTACTS)
                {
                    msg_Client(playerid, COLOR_INFO, "{CF9756} Tel {FFFFFF} Repertoire plein, supprimez un contact d'abord.");
                    Phone_OpenMenu(playerid);
                    return 1;
                }
                PhoneDialog_State[playerid] = 1;
                return ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_INPUT,
                    "{8B8B00} Tel {FFFFFF} Nouveau contact - Nom",
                    "Entrez le nom du contact (max 30 caract�res) :",
                    "Suivant", "Annuler");
            }
            else if(listitem == 3) // Supprimer contact
                {Phone_DeleteContactDialog(playerid); return 1;}
            else if(listitem == 4) // Mon numero - juste info
                {Phone_OpenMenu(playerid); return 1;}
            return 1;
        }
        else if(PhoneDialog_State[playerid] == 1)
        {
            // Ajout contact - etape 1 : nom
            if(!response) {Phone_OpenMenu(playerid); return 1;}
            if(strlen(inputtext) < 1 || strlen(inputtext) > 30)
            {
                return ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_INPUT,
                    "{8B8B00} Tel {FFFFFF} Nouveau contact - Nom",
                    "{FF0000}Nom invalide (1-30 caract�res).{FFFFFF}\nEntrez le nom du contact :",
                    "Suivant", "Annuler");
            }
            strmid(PhoneDialog_TempName[playerid], inputtext, 0, 31, 32);
            PhoneDialog_State[playerid] = 2;
            return ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_INPUT,
                "{8B8B00} Tel {FFFFFF} Nouveau contact - Numero",
                "Entrez le numero de telephone (4 chiffres) :",
                "Valider", "Annuler");
        }
        else if(PhoneDialog_State[playerid] == 2)
        {
            // Ajout contact - etape 2 : numero
            if(!response) {Phone_OpenMenu(playerid); return 1;}
            new num = strval(inputtext);
            if(num <= 0 || num > 9999)
            {
                return ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_INPUT,
                    "{8B8B00} Tel {FFFFFF} Nouveau contact - Numero",
                    "{FF0000}Numero invalide (1-9999).{FFFFFF}\nEntrez le numero :",
                    "Valider", "Annuler");
            }
            new slot = PhoneContact_Count[playerid];
            strmid(PhoneContact_Name[playerid][slot], PhoneDialog_TempName[playerid], 0, 31, 32);
            PhoneContact_Num[playerid][slot] = num;
            PhoneContact_Count[playerid]++;
            new okmsg[120];
            format(okmsg, sizeof(okmsg), "{00FF00} Tel {FFFFFF} Contact {FFD700}%s{FFFFFF} (%d) ajout� au repertoire.",
                PhoneDialog_TempName[playerid], num);
            msg_Client(playerid, COLOR_WHITE, okmsg);
            PhoneDialog_State[playerid] = 0;
            return 1;
        }
        else if(PhoneDialog_State[playerid] == 10)
        {
            // Selection dans repertoire pour appeler
            if(!response) {Phone_OpenMenu(playerid); return 1;}
            if(listitem < 0 || listitem >= PhoneContact_Count[playerid]) return 1;
            new contactNum = PhoneContact_Num[playerid][listitem];
            new cstr[140];
            format(cstr, sizeof(cstr), "{8B8B00} Tel {FFFFFF} Appel vers {FFD700}%s{FFFFFF} : tapez /call %d pour composer.",
                PhoneContact_Name[playerid][listitem], contactNum);
            msg_Client(playerid, COLOR_WHITE, cstr);
            return 1;
        }
        else if(PhoneDialog_State[playerid] == 11)
        {
            // Selection dans appels manques pour rappeler
            if(!response) {Phone_OpenMenu(playerid); return 1;}
            if(listitem < 0 || listitem >= PhoneMissed_Count[playerid]) return 1;
            new mnum = PhoneMissed_Num[playerid][listitem];
            new mstr[140];
            format(mstr, sizeof(mstr), "{8B8B00} Tel {FFFFFF} Tapez /call %d pour rappeler {FFD700}%s{FFFFFF}.",
                mnum, PhoneMissed_Name[playerid][listitem]);
            msg_Client(playerid, COLOR_WHITE, mstr);
            return 1;
        }
        else if(PhoneDialog_State[playerid] == 12)
        {
            // Suppression contact
            if(!response) {Phone_OpenMenu(playerid); return 1;}
            if(listitem < 0 || listitem >= PhoneContact_Count[playerid]) return 1;
            new dmsg[120];
            format(dmsg, sizeof(dmsg), "{FFAA00} Tel {FFFFFF} Contact {FFD700}%s{FFFFFF} supprim�.",
                PhoneContact_Name[playerid][listitem]);
            // Decale les contacts au-dessus
            for(new k = listitem; k < PhoneContact_Count[playerid] - 1; k++)
            {
                strmid(PhoneContact_Name[playerid][k], PhoneContact_Name[playerid][k+1], 0, 31, 32);
                PhoneContact_Num[playerid][k] = PhoneContact_Num[playerid][k+1];
            }
            PhoneContact_Count[playerid]--;
            new last = PhoneContact_Count[playerid];
            PhoneContact_Name[playerid][last][0] = EOS;
            PhoneContact_Num[playerid][last] = 0;
            msg_Client(playerid, COLOR_WHITE, dmsg);
            PhoneDialog_State[playerid] = 0;
            return 1;
        }
        return 1;
    }
