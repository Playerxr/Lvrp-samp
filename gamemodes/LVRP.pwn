    new Float:hp,Float:ar; GetPlayerHealth(pid,hp); GetPlayerArmour(pid,ar);
    new etat[24];
    if(hp<30.0) etat="{FF0000}CRITIQUE";
    else if(hp<60.0) etat="{FF8800}Blesse";
    else etat="{00FF00}En forme";
    // Barre vie
    PhUI_pTxt(pid,SCX+8.0,SCY+40.0,"VIE",0xAAAAAAFF,0.15,0.67);
    PhUI_pBox(pid,SCX+8.0,SCY+52.0,SCX+SCW-8.0,SCY+62.0,0x333333FF);
    PhUI_pBox(pid,SCX+8.0,SCY+52.0,SCX+8.0+(SCW-16.0)*hp/100.0,SCY+62.0,0x34C759FF);
    new hpStr[12]; format(hpStr,12,"~w~%.0f / 100",hp);
    PhUI_pTxt(pid,SCX+SCW/2.0,SCY+53.5,hpStr,0xFFFFFFFF,0.16,0.70,1,2,SCW);
    // Barre armure
    PhUI_pTxt(pid,SCX+8.0,SCY+68.0,"ARMURE",0xAAAAAAFF,0.15,0.67);
    PhUI_pBox(pid,SCX+8.0,SCY+80.0,SCX+SCW-8.0,SCY+90.0,0x333333FF);
    PhUI_pBox(pid,SCX+8.0,SCY+80.0,SCX+8.0+(SCW-16.0)*ar/100.0,SCY+90.0,0x5AC8FAFF);
    new arStr[12]; format(arStr,12,"~w~%.0f / 100",ar);
    PhUI_pTxt(pid,SCX+SCW/2.0,SCY+81.5,arStr,0xFFFFFFFF,0.16,0.70,1,2,SCW);
    // Etat
    PhUI_pBox(pid,SCX+4.0,SCY+98.0,SCX+SCW-4.0,SCY+116.0,0x2C2C2E99);
    PhUI_pTxt(pid,SCX+8.0,SCY+102.0,"Etat : ",0xAAAAAAFF,0.17,0.74);
    PhUI_pTxt(pid,SCX+50.0,SCY+102.0,etat,0xFFFFFFFF,0.17,0.74);
    // Urgences
    PhUI_pBox(pid,SCX+4.0,SCY+122.0,SCX+SCW-4.0,SCY+140.0,0x2C2C2E99);
    PhUI_pTxt(pid,SCX+8.0,SCY+126.0,"Urgences SAMU",0xAAAAAAFF,0.16,0.70);
    PhUI_pBtnTxt(pid,SCX+SCW-48.0,SCY+124.0,"~g~/call 913",0x34C759FF,0.16,0.70,PA_APP_CALL,44.0,14.0);
}

