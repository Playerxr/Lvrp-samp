stock Parking_Init()
{
    parking_Count = 0;
    for(new i=0; i<MAX_PARKING; i++)
    {
        parkings[i][paUsed] = 0;
        parking_PickupId[i] = -1;
        parking_Label[i] = Text3D:INVALID_3DTEXT_ID;
    }
    if(!fexist(PARKING_FILE))
    {
        printf("[PARKING] Pas de fichier %s - aucun parking charge", PARKING_FILE);
        return 1;
    }
    new File:f = fopen(PARKING_FILE, io_read);
    if(!f) return 0;
    new line[256];
    while(fread(f, line))
    {
        // Format ligne : "x,y,z,nom,creatorSqlid\n"
        if(strlen(line) < 5) continue;
        new parts[5][64];
        
        new currentPart = 0;
        new partPos = 0;
        for(new i=0; i<strlen(line) && currentPart < 5; i++)
        {
            if(line[i] == ',' || line[i] == '\n' || line[i] == '\r')
            {
                parts[currentPart][partPos] = '\0';
                currentPart++;
                partPos = 0;
            }
            else if(partPos < 63)
            {
                parts[currentPart][partPos] = line[i];
                partPos++;
            }
        }
        if(currentPart >= 4 && parking_Count < MAX_PARKING)
        {
            parkings[parking_Count][paUsed] = 1;
            parkings[parking_Count][paX] = floatstr(parts[0]);
            parkings[parking_Count][paY] = floatstr(parts[1]);
            parkings[parking_Count][paZ] = floatstr(parts[2]);
            format(parkings[parking_Count][paName], 64, "%s", parts[3]);
            parkings[parking_Count][paCreatorSqlid] = strval(parts[4]);
            Parking_CreateVisuals(parking_Count);
            parking_Count++;
        }
    }
    fclose(f);
    printf("[PARKING] %d parkings charg�s depuis %s", parking_Count, PARKING_FILE);
    return 1;
}


stock Parking_ShowAllIcons(playerid)
{
    for(new i=0; i<MAX_PARKING; i++)
    {
        if(parkings[i][paUsed] != 1) continue;
        SetPlayerMapIcon(playerid, 50+i, parkings[i][paX], parkings[i][paY], parkings[i][paZ], 56, 0x42AAFFFF, MAPICON_GLOBAL);
        parking_MapIcon[playerid][i] = 1;
    }
    return 1;
}

stock Parking_Create(Float:x, Float:y, Float:z, const name[], creatorSqlid)
{
    for(new i=0; i<MAX_PARKING; i++)
    {
        if(parkings[i][paUsed] != 1)
        {
            parkings[i][paUsed] = 1;
            parkings[i][paX] = x;
            parkings[i][paY] = y;
            parkings[i][paZ] = z;
            format(parkings[i][paName], 64, "%s", name);
            parkings[i][paCreatorSqlid] = creatorSqlid;
            Parking_CreateVisuals(i);
            if(i >= parking_Count) parking_Count = i+1;
            Parking_Save();
            return i;
        }
    }
    return -1;
}

stock Parking_DeleteId(pid)
{
    if(pid < 0 || pid >= MAX_PARKING) return 0;
    if(parkings[pid][paUsed] != 1) return 0;
    Parking_DestroyVisuals(pid);
    parkings[pid][paUsed] = 0;
    parkings[pid][paX] = 0.0;
    parkings[pid][paY] = 0.0;
    parkings[pid][paZ] = 0.0;
    format(parkings[pid][paName], 64, "");
    Parking_Save();
    return 1;
}

stock Parking_GetNearest(playerid)
{
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    new bestId = -1;
    new Float:bestDist = PARKING_RADIUS;
    for(new i=0; i<MAX_PARKING; i++)
    {
        if(parkings[i][paUsed] != 1) continue;
        new Float:dx = px - parkings[i][paX];
        new Float:dy = py - parkings[i][paY];
        new Float:dz = pz - parkings[i][paZ];
        new Float:d = floatsqroot(dx*dx + dy*dy + dz*dz);
        if(d < bestDist)
        {
            bestDist = d;
            bestId = i;
        }
    }
    return bestId;
}

stock Parking_ShowMenu(playerid)
{
    new pid = Parking_GetNearest(playerid);
    if(pid == -1)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Vous n'�tes pas dans un parking. Cherchez l'icone bleue sur la map.");
        return 1;
    }
    new vehCount = Parking_CountPlayerVehicles(playerid);
    new title[128], menuBody[1024];
    format(title, sizeof(title), " Parking  %s", parkings[pid][paName]);
    format(menuBody, sizeof(menuBody), "{42AAFF}Vous avez %d vehicule(s) personnel(s).{FFFFFF}\n\n", vehCount);
    if(vehCount == 0)
    {
        strcat(menuBody, "Vous n'avez aucun vehicule. Achetez en un au concessionnaire.");
        ShowPlayerDialog(playerid, 9980, DIALOG_STYLE_MSGBOX, title, menuBody, "OK", "");
        return 1;
    }
    // FIX: construction dynamique + mapping listitem->slot reel
    new tmpStr[128];
    new count = 0;
    for(new i = 0; i < 6; i++)
    {
        if(PlayerInfo[playerid][pCar][i] == -1) continue;
        new carSqlid = PlayerInfo[playerid][pCar][i];
        new vidx = vehicle_GetId(carSqlid);
        parking_RealSlot[playerid][count] = i;
        if(vidx == -1)
            // [FIX] Vehicule non charge mais selectionnable -> sera charge au moment du spawn
            format(tmpStr, sizeof(tmpStr), "{FFAA00}[Slot %d]{FFFFFF} (Non charge - appuyez pour spawner){FFFFFF}\n", i+1);
        else
            format(tmpStr, sizeof(tmpStr), "{42AAFF}[Slot %d]{FFFFFF} %s\n", i+1, vehicle[vidx][cDescription]);
        strcat(menuBody, tmpStr);
        count++;
    }
    parking_SlotCount[playerid] = count;
    strcat(menuBody, "{FF6666}Despawn un vehicule{FFFFFF}");
    ShowPlayerDialog(playerid, 9981, DIALOG_STYLE_LIST, title, menuBody, "Choisir", "Annuler");
    return 1;
}

stock Parking_SpawnVehicleAt(playerid, slot)
{
    if(slot < 0 || slot > 5)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Slot invalide.");}
    new carSqlid = PlayerInfo[playerid][pCar][slot];
    if(carSqlid == -1)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Aucun vehicule sur ce slot.");}

    new pid = Parking_GetNearest(playerid);
    if(pid == -1)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Vous n'�tes plus dans le parking.");}

    // [PARKING PAYANT] verif du solde avant tout (10k, +25k si fourriere)
    if(!ParkingPay_CanAfford(playerid, carSqlid)) return 1;

    new idx = vehicle_GetId(carSqlid);

    // [FIX PARKING] Vehicule non charge en memoire (ex: apres restart) -> le charger depuis DB
    if(idx == -1)
    {
        if(gettime() - parking_LastAction[playerid] < 5)
            {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Attendez 5 secondes entre chaque action.");}
        parking_LastAction[playerid] = gettime();

        // Stocker le slot et le parking pour positionner le vehicule apres chargement
        SetPVarInt(playerid, "parking_LoadSlot", slot);
        SetPVarInt(playerid, "parking_LoadPid", pid);

        new sqlLoad[128];
        format(sqlLoad, sizeof(sqlLoad), "SELECT * FROM lvrp_server_vehicles WHERE id=%d LIMIT 1", carSqlid);
        mysql_tquery(MYSQL, sqlLoad, "vehicle_LoadPlayer", "ii", playerid, slot);

        msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Vehicule en cours de chargement, patientez un instant...");
        return 1;
    }

    // Anti-spam : 5 secondes entre actions
    if(gettime() - parking_LastAction[playerid] < 5)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Attendez 5 secondes entre chaque action.");}
    parking_LastAction[playerid] = gettime();

    // Teleporte le vehicule (legere variation pour ne pas spawn dans un autre)
    new Float:offsetX = float(slot) * 2.5;
    SafeSetVehiclePos(idx, parkings[pid][paX] + offsetX, parkings[pid][paY], parkings[pid][paZ] + 0.5);
    SetVehicleZAngle(idx, 0.0);
    SetVehicleVirtualWorld(idx, 0);
    LinkVehicleToInterior(idx, 0);
    vehicle[idx][cVW] = 0;
    vehicle[idx][cInt] = 0;
    vehicle[idx][cLocationx] = parkings[pid][paX] + offsetX;
    vehicle[idx][cLocationy] = parkings[pid][paY];
    vehicle[idx][cLocationz] = parkings[pid][paZ] + 0.5;
    vehicle[idx][cAngle] = 0.0;
    vehicle_Save(idx, 0, 0);

    new msg[128];
    format(msg, sizeof(msg), "{42AAFF} Parking {FFFFFF} Votre %s a �t� amene au parking.", vehicle[idx][cDescription]);
    msg_Client(playerid, COLOR_WHITE, msg);
    // [PARKING PAYANT] debit + ticket + label
    ParkingPay_ApplyPayment(playerid, carSqlid, pid, idx);
    return 1;
}

stock Parking_DespawnVehicleAt(playerid, slot)
{
    if(slot < 0 || slot > 5)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Slot invalide.");}
    new carSqlid = PlayerInfo[playerid][pCar][slot];
    if(carSqlid == -1)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Aucun vehicule sur ce slot.");}

    new idx = vehicle_GetId(carSqlid);
    if(idx == -1)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Ce vehicule n'est pas charge.");}

    if(gettime() - parking_LastAction[playerid] < 5)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Parking {FFFFFF} Attendez 5 secondes entre chaque action.");}
    parking_LastAction[playerid] = gettime();

    // Garde le SQLID mais t�l�port� tres loin (zone reserve)
    SafeSetVehiclePos(idx, Car_Reserve_x, Car_Reserve_y, Car_Reserve_z);
    SetVehicleVirtualWorld(idx, 9999);
    vehicle[idx][cVW] = 9999;
    vehicle[idx][cLocationx] = Car_Reserve_x;
    vehicle[idx][cLocationy] = Car_Reserve_y;
    vehicle[idx][cLocationz] = Car_Reserve_z;
    vehicle_Save(idx, 0, 0);

    new msg[128];
    format(msg, sizeof(msg), "{FF6666} Parking {FFFFFF} Votre %s a �t� despawn. Retournez au parking pour le spawn de nouveau.", vehicle[idx][cDescription]);
    msg_Client(playerid, COLOR_WHITE, msg);
    // [PARKING PAYANT] efface le ticket sans amende (choix volontaire du joueur)
    ParkingPay_OnManualDespawn(carSqlid);
    return 1;
}

stock Parking_ShowList(playerid)
{
    new listBody[2048] = "{42AAFF}Liste des parkings :{FFFFFF}\n\n";
    new tmp[128];
    new count = 0;
    for(new i=0; i<MAX_PARKING; i++)
    {
        if(parkings[i][paUsed] != 1) continue;
        format(tmp, sizeof(tmp), "ID %d : %s (X:%.1f Y:%.1f)\n", i, parkings[i][paName], parkings[i][paX], parkings[i][paY]);
        strcat(listBody, tmp);
        count++;
    }
    if(count == 0)
    {
        ShowPlayerDialog(playerid, 9982, DIALOG_STYLE_MSGBOX, " Parking  Liste", "Aucun parking cree. Tapez {42AAFF}/parking creer <nom>{FFFFFF} pour en creer un.", "OK", "");
        return 1;
    }
    new title[64];
    format(title, sizeof(title), " Parking  Liste (%d)", count);
    ShowPlayerDialog(playerid, 9982, DIALOG_STYLE_MSGBOX, title, listBody, "OK", "");
    return 1;
}

stock Hopital_ToggleDuty(playerid)
{
    if(PlayerInfo[playerid][pMember] != FACTION_HOPITAL)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Vous n'�tes pas membre de l'hopital.");}
    new Float:hx, Float:hy, Float:hz;
    GetPlayerPos(playerid, hx, hy, hz);
    // Verifier qu'on est a un hopital (point reper� : LS All Saints + LV + SF)
    new bool:atHospital = false;
    if(IsPlayerInRangeOfPoint(playerid, 30.0, 1607.0, 1816.0, 10.8)) atHospital = true; // LV
    else if(IsPlayerInRangeOfPoint(playerid, 30.0, 1183.0, -1322.0, 13.5)) atHospital = true; // LS
    else if(IsPlayerInRangeOfPoint(playerid, 30.0, -2655.0, 638.0, 14.4)) atHospital = true; // SF
    if(!atHospital && PlayerInfo[playerid][pAdmin] < 2)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Vous devez �tre a l'hopital (LS, SF ou LV).");}

    if(hopital_Duty[playerid] == 1)
    {
        hopital_Duty[playerid] = 0;
        if(samu_MedicCount > 0) samu_MedicCount--;
        if(samu_PhoneId != -1 && samu_MedicCount == 0) samu_PhoneId = -1; // reset si dernier medecin quitt�
        SetPlayerSkin(playerid, PlayerInfo[playerid][pChar]);
        msg_Client(playerid, 0xFF8282FF, "{FF8282} Hopital {FFFFFF} Vous etes maintenant hors service.");
    }
    else
    {
        hopital_Duty[playerid] = 1;
        samu_MedicCount++;
        SetPlayerSkin(playerid, 274);  // Skin medecin
        msg_Client(playerid, 0xFF8282FF, "{FF8282} Hopital {FFFFFF} Vous etes en service. {00FF00}/heal{FFFFFF} pour soigner | Les patients appellent le {FFFF00}15{FFFFFF}.");
    }
    return 1;
}

stock Hopital_HealPlayer(playerid, targetid, prix = 200)
{
    if(PlayerInfo[playerid][pMember] != FACTION_HOPITAL)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Vous n'�tes pas membre de l'hopital.");}
    if(hopital_Duty[playerid] != 1)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Vous devez �tre en service (/duty hopital).");}
    if(!IsPlayerConnected(targetid) || IsPlayerNPC(targetid))
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Joueur non connect�.");}
    if(!ProxDetectorS(5.0, playerid, targetid))
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Le joueur doit �tre a moins de 5m.");}

    // [FIX HEAL] On utilise SafeSetPlayerHealth pour mettre a jour PlayerInfo[targetid][pHealth]
    // Sinon les systemes qui comparent GetPlayerHealth vs pHealth (OnPlayerTakeDamage, etc.)
    // peuvent annuler le soin.
    SafeSetPlayerHealth(targetid, 100.0);

    // [FIX HEAL] Si le patient �tait en coma (HP<13, allong� au sol), on le sort de cet �tat
    // sinon la vie passe a 100 mais le joueur reste fige au sol avec son animation de coma.
    if(medic_PlayerNeedMedic[targetid] >= 1)
    {
        medic_PlayerNeedMedic[targetid] = 0;
        medic_PlayerMedicTime[targetid] = 0;
        medic_PlayerCity[targetid] = -1;
        TogglePlayerControllable(targetid, true);
        ClearAnimations(targetid);
        // Retirer le blip rose sur la map des autres m�decins
        for(new med = 0; med <MAX_PLAYERS_CURRENT+1; med++)
        {
            if(IsPlayerConnected(med))
                {SetPlayerMarkerForPlayer(med, targetid, GetPlayerColor(targetid));}
        }
    }

    new str[128];
    format(str, sizeof(str), "{FF8282} Hopital {FFFFFF} Vous avez soign� %s.", PlayerInfo[targetid][pName]);
    msg_Client(playerid, COLOR_WHITE, str);
    format(str, sizeof(str), "{FF8282} Hopital {FFFFFF} Vous avez �t� soign� par le Dr. %s.", PlayerInfo[playerid][pName]);
    msg_Client(targetid, COLOR_WHITE, str);

    // Paiement du soin selon le prix demande
    if(prix < 100 || prix > 5000)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Prix entre $100 et $5000.");}
    if(PlayerInfo[targetid][pCash] < prix)
        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Hopital {FFFFFF} Le patient n'a pas assez d'argent.");}
    SafeGivePlayerMoney(targetid, -prix, "Soin medical");
    SafeGivePlayerMoney(playerid, prix, "Soin medical");
    return 1;
}

stock Casino_Init()
{
    casino_Count = 0;
    for(new i=0; i<MAX_CASINO; i++)
    {
        casino[i][caUsed]=0;
        casino[i][caPickup]=-1;
        casino[i][caLabel]=_:INVALID_3DTEXT_ID;
        casino[i][caExitPickup]=-1;
        casino[i][caExitLabel]=_:INVALID_3DTEXT_ID;
    }
    if(!fexist(CASINO_FILE)) return 1;
    new File:f = fopen(CASINO_FILE, io_read);
    if(!f) return 0;
    new line[420];
    while(fread(f, line) && casino_Count < MAX_CASINO)
    {
        // Nouveau format : 14 champs (9 anciens + 5 interieur)
        new parts[14][64];
        new cur=0, pidx=0, ch=0;
        for(new k=0; k<strlen(line) && cur<14; k++)
        {
            ch = line[k];
            if(ch==',' || ch=='\n' || ch=='\r') { parts[cur][pidx]='\0'; cur++; pidx=0; }
            else if(pidx<63) { parts[cur][pidx]=ch; pidx++; }
        }
        if(cur >= 8)
        {
            new i = casino_Count;
            casino[i][caUsed]=1;
            casino[i][caX]=floatstr(parts[0]); casino[i][caY]=floatstr(parts[1]); casino[i][caZ]=floatstr(parts[2]);
            format(casino[i][caName],40,"%s",parts[3]);
            format(casino[i][caOwner],MAX_PLAYER_NAME,"%s",parts[4]);
            casino[i][caOwnerSQLID]=strval(parts[5]);
            casino[i][caOpen]=strval(parts[6]);
            casino[i][caPrice]=strval(parts[7]);
            casino[i][caForSale]=strval(parts[8]);
            casino[i][caTotalGains]=0;
            // Champs interieur (compat ancien format : valeurs par defaut)
            if(cur >= 13)
            {
                casino[i][caIntX]=floatstr(parts[9]);
                casino[i][caIntY]=floatstr(parts[10]);
                casino[i][caIntZ]=floatstr(parts[11]);
                casino[i][caIntA]=floatstr(parts[12]);
                casino[i][caInteriorId]=strval(parts[13]);
            }
            else
            {
                // Ancien fichier : utiliser interieur Caligula's par defaut
                casino[i][caIntX]=2233.81;
                casino[i][caIntY]=1714.10;
                casino[i][caIntZ]=1012.50; // [FIX] Z corrige
                casino[i][caIntA]=180.0;
                casino[i][caInteriorId]=1;
            }
            casino[i][caVW] = 5000 + i;  // VW unique par casino

            // Pickup d'entr�e + label
            casino[i][caPickup] = CreatePickup(1559,1,casino[i][caX],casino[i][caY],casino[i][caZ],0);
            Casino_BuildLabel(i);
            new Text3D:caTxt = Create3DTextLabel(gCasinoLabelBuf, 0xFFD700FF, casino[i][caX], casino[i][caY], casino[i][caZ]+0.8, 20.0, 0, 0);
            casino[i][caLabel] = _:caTxt;

            // Pickup de sortie dans l'interieur (visible uniquement avec le bon VW)
            casino[i][caExitPickup] = CreatePickup(1318,1,casino[i][caIntX],casino[i][caIntY],casino[i][caIntZ], casino[i][caVW]);
            new Text3D:caExitTxt = Create3DTextLabel("{FF4444}SORTIE\n{FFFFFF}Touche {FFFF00}F", 0xFFFFFFFF, casino[i][caIntX], casino[i][caIntY], casino[i][caIntZ]+0.6, 8.0, casino[i][caVW], 0);
            casino[i][caExitLabel] = _:caExitTxt;

            casino_Count++;
        }
    }
    fclose(f);
    printf("[CASINO] %d casino(s) charge(s) avec interieur", casino_Count);
    return 1;
}

stock Casino_HandleCmd(playerid, const cmdtext[])
{
    new idx=0, tmp[64];
    strtok(cmdtext, idx);  // skip "/casino"
    tmp = strtok(cmdtext, idx);

    if(!strlen(tmp))
    {
        // Menu : soit au casino = jouer, soit aide
        new cid = Casino_GetNearest(playerid);
        if(cid != -1 && casino[cid][caOpen] == 1)
        {
            // Menu jeu
            new title[64], body_casino[256];
            format(title, sizeof(title), "{FFD700}Casino : %s", casino[cid][caName]);
            format(body_casino, sizeof(body_casino),
                "{FFFFFF}Bienvenue ! Tentez votre chance a la machine a sous.\n\n{FFAA00}Mises disponibles:\n{FFFFFF}/casino jouer <mise>\nMise min : {00FF00}%d${FFFFFF} | Mise max : {FF0000}%d$\n\n{CCCCCC}Proprio : %s",
                CASINO_MIN_MISE, CASINO_MAX_MISE, casino[cid][caOwner]);
            ShowPlayerDialog(playerid, CASINO_DIALOG_MAIN, DIALOG_STYLE_MSGBOX, title, body_casino, "OK", "");
        }
        else
        {
            msg_Client(playerid, COLOR_WHITE, "{FFD700} Casino  Commandes :");
            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/casino entrer - entrer dans le casino");
            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/casino sortir - sortir du casino");
            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/casino jouer <mise> - jouer a la machine a sous");
            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/casino info - infos du casino proche");
            if(Casino_GetNearest(playerid)!=-1 && strcmp(casino[Casino_GetNearest(playerid)][caOwner],PlayerInfo[playerid][pRealName],true)==0)
            {
                msg_Client(playerid, COLOR_WHITE, "{FFAA00}/casino open /casino close - ouvrir/fermer");
                msg_Client(playerid, COLOR_WHITE, "{FFAA00}/casino encaisser - recuperer vos gains");
                msg_Client(playerid, COLOR_WHITE, "{FFAA00}/casino vendre <prix> - mettre en vente");
            }
        }
        return 1;
    }

    if(strcmp(tmp, "jouer", true)==0 || strcmp(tmp, "play", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas dans un casino.");
        if(casino[cid][caOpen]!=1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Ce casino est ferme.");
        tmp = strtok(cmdtext, idx);
        if(!strlen(tmp)) return msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /casino jouer <mise 1000-50000$>");
        new mise = strval(tmp);
        if(mise < CASINO_MIN_MISE || mise > CASINO_MAX_MISE)
        {
            new emsg[100];
            format(emsg, sizeof(emsg), "{CF9756} Casino {FFFFFF} Mise entre %d$ et %d$.", CASINO_MIN_MISE, CASINO_MAX_MISE);
            return msg_Client(playerid, COLOR_INFO, emsg);
        }
        if(PlayerInfo[playerid][pCash] < mise)
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Pas assez d'argent.");
        SafeGivePlayerMoney(playerid, -mise, "Casino mise");
        Casino_PlaySlot(playerid, mise);
        return 1;
    }

    if(strcmp(tmp, "info", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        new imsg[256];
        format(imsg, sizeof(imsg), "{FFD700} Casino {FFFFFF} %s | Proprio : %s | Etat : %s | %s",
            casino[cid][caName], casino[cid][caOwner],
            (casino[cid][caOpen]==1?"{00FF00}Ouvert":"{FF0000}Ferme"),
            (casino[cid][caForSale]==1?"{FF6347}A VENDRE":"{FFFFFF}"));
        msg_Client(playerid, COLOR_WHITE, imsg);
        return 1;
    }

    if(strcmp(tmp, "open", true)==0 || strcmp(tmp, "ouvrir", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        if(strcmp(casino[cid][caOwner], PlayerInfo[playerid][pRealName], true)!=0 && PlayerInfo[playerid][pAdmin]<3)
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas le propri�taire.");
        casino[cid][caOpen]=1;
        Casino_RefreshLabel(cid);
        Casino_Save();
        msg_Client(playerid, COLOR_WHITE, "{00FF00} Casino {FFFFFF} Casino ouvert !");
        return 1;
    }

    if(strcmp(tmp, "close", true)==0 || strcmp(tmp, "fermer", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        if(strcmp(casino[cid][caOwner], PlayerInfo[playerid][pRealName], true)!=0 && PlayerInfo[playerid][pAdmin]<3)
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas le propri�taire.");
        casino[cid][caOpen]=0;
        Casino_RefreshLabel(cid);
        Casino_Save();
        msg_Client(playerid, COLOR_WHITE, "{FF0000} Casino {FFFFFF} Casino ferme.");
        return 1;
    }

    if(strcmp(tmp, "encaisser", true)==0 || strcmp(tmp, "collect", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        if(strcmp(casino[cid][caOwner], PlayerInfo[playerid][pRealName], true)!=0 && PlayerInfo[playerid][pAdmin]<3)
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas le propri�taire.");
        new gains = casino[cid][caTotalGains];
        if(gains <= 0) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun gain a encaisser pour l'instant.");
        SafeGivePlayerMoney(playerid, gains, "Casino profits");
        casino[cid][caTotalGains]=0;
        new gmsg[128];
        format(gmsg, sizeof(gmsg), "{FFD700} Casino {FFFFFF} Vous avez encaisse {00FF00}%d$.", gains);
        msg_Client(playerid, COLOR_WHITE, gmsg);
        return 1;
    }

    if(strcmp(tmp, "vendre", true)==0 || strcmp(tmp, "sell", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        if(strcmp(casino[cid][caOwner], PlayerInfo[playerid][pRealName], true)!=0 && PlayerInfo[playerid][pAdmin]<3)
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas le propri�taire.");
        tmp = strtok(cmdtext, idx);
        if(!strlen(tmp)) return msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /casino vendre <prix>");
        new prix = strval(tmp);
        if(prix < 10000) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Prix minimum : 10 000$.");
        casino[cid][caForSale]=1;
        casino[cid][caPrice]=prix;
        Casino_RefreshLabel(cid);
        Casino_Save();
        new smsg[100];
        format(smsg, sizeof(smsg), "{FFD700} Casino {FFFFFF} Casino mis en vente pour {FF6347}%d$.", prix);
        msg_Client(playerid, COLOR_WHITE, smsg);
        return 1;
    }

    if(strcmp(tmp, "acheter", true)==0 || strcmp(tmp, "buy", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        if(casino[cid][caForSale]!=1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Ce casino n'est pas en vente.");
        new prix = casino[cid][caPrice];
        if(PlayerInfo[playerid][pCash] < prix)
        {
            new pmsg[100];
            format(pmsg, sizeof(pmsg), "{CF9756} Casino {FFFFFF} Il vous faut {FF0000}%d${FFFFFF} pour acheter ce casino.", prix);
            return msg_Client(playerid, COLOR_INFO, pmsg);
        }
        SafeGivePlayerMoney(playerid, -prix, "Achat casino");
        format(casino[cid][caOwner], MAX_PLAYER_NAME, "%s", PlayerInfo[playerid][pRealName]);
        casino[cid][caOwnerSQLID] = PlayerInfo[playerid][pSQLID];
        casino[cid][caForSale]=0;
        casino[cid][caOpen]=0;
        casino[cid][caTotalGains]=0;
        Casino_RefreshLabel(cid);
        Casino_Save();
        new bmsg[140];
        format(bmsg, sizeof(bmsg), "{FFD700} Casino {FFFFFF} Vous etes maintenant propri�taire de {FFD700}%s {FFFFFF}pour %d$.", casino[cid][caName], prix);
        msg_Client(playerid, COLOR_WHITE, bmsg);
        return 1;
    }

    // Commandes admin
    if(strcmp(tmp, "creer", true)==0 || strcmp(tmp, "create", true)==0)
    {
        if(PlayerInfo[playerid][pAdmin]<4) return msg_Client(playerid, COLOR_INFO, "{FF0000} Admin {FFFFFF} Niveau 4+ requis.");
        if(casino_Count >= MAX_CASINO) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Maximum de casinos atteint (10).");
        tmp = strtok(cmdtext, idx);
        // Nom = reste de cmdtext
        new cname[40], cnpos=idx, cnlen=strlen(cmdtext), cnidx=0;
        while(cnpos < cnlen && cmdtext[cnpos]==' ') cnpos++;
        while(cnpos < cnlen && cnidx < 39) { cname[cnidx]=cmdtext[cnpos]; cnpos++; cnidx++; }
        cname[cnidx]='\0';
        if(strlen(cname)<2) return msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /casino creer <nom>");
        // Trouver un slot libre
        new slot=-1;
        for(new i=0; i<MAX_CASINO; i++) { if(casino[i][caUsed]!=1){slot=i;break;} }
        if(slot==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Limite atteinte.");
        new Float:px,Float:py,Float:pz;
        GetPlayerPos(playerid, px,py,pz);
        casino[slot][caUsed]=1;
        casino[slot][caX]=px; casino[slot][caY]=py; casino[slot][caZ]=pz;
        format(casino[slot][caName],40,"%s",cname);
        format(casino[slot][caOwner],MAX_PLAYER_NAME,"%s",PlayerInfo[playerid][pRealName]);
        casino[slot][caOwnerSQLID]=PlayerInfo[playerid][pSQLID];
        casino[slot][caOpen]=0; casino[slot][caForSale]=0;
        casino[slot][caPrice]=500000; casino[slot][caTotalGains]=0;

        // === SYSTEME INTERIEUR ===
        // Rotation entre 3 interieurs casino SA-MP (varie selon slot)
        new interieurChoisi = (slot % 3);
        switch(interieurChoisi)
        {
            case 0: // Caligula's Casino
            {
                casino[slot][caIntX] = 2233.81;
                casino[slot][caIntY] = 1714.10;
                casino[slot][caIntZ] = 1012.50; // [FIX] Z +0.71 au-dessus du sol
                casino[slot][caIntA] = 180.0;
                casino[slot][caInteriorId] = 1;
            }
            case 1: // 4 Dragons Casino
            {
                casino[slot][caIntX] = 1959.65;
                casino[slot][caIntY] = 1014.96;
                casino[slot][caIntZ] = 993.50; // [FIX] Z +1.04 au-dessus du sol
                casino[slot][caIntA] = 268.0;
                casino[slot][caInteriorId] = 10;
            }
            case 2: // Inside Track Betting (alternatif)
            {
                casino[slot][caIntX] = 838.61;
                casino[slot][caIntY] = 7.92;
                casino[slot][caIntZ] = 1005.00; // [FIX] Z +0.82 au-dessus du sol
                casino[slot][caIntA] = 0.0;
                casino[slot][caInteriorId] = 3;
            }
        }
        casino[slot][caVW] = 5000 + slot;  // VW unique pour isoler chaque casino

        // Pickup d'entr�e + label (exterieur, VW 0)
        casino[slot][caPickup] = CreatePickup(1559,1,px,py,pz,0);
        Casino_BuildLabel(slot);
        new Text3D:caTxt2 = Create3DTextLabel(gCasinoLabelBuf,0xFFD700FF,px,py,pz+0.8,20.0,0,0);
        casino[slot][caLabel] = _:caTxt2;

        // Pickup de sortie + label (a l'interieur, VW casino)
        casino[slot][caExitPickup] = CreatePickup(1318,1,
            casino[slot][caIntX], casino[slot][caIntY], casino[slot][caIntZ],
            casino[slot][caVW]);
        new Text3D:caExitTxt2 = Create3DTextLabel("{FF4444}SORTIE\n{FFFFFF}Touche {FFFF00}F",
            0xFFFFFFFF,
            casino[slot][caIntX], casino[slot][caIntY], casino[slot][caIntZ]+0.6,
            8.0, casino[slot][caVW], 0);
        casino[slot][caExitLabel] = _:caExitTxt2;

        if(slot>=casino_Count) casino_Count=slot+1;
        Casino_Save();
        new cmsg[200];
        format(cmsg, sizeof(cmsg), "{FFD700} Casino {FFFFFF} Casino '{FFD700}%s{FFFFFF}' cree (slot %d, interieur %d).",
            cname, slot, casino[slot][caInteriorId]);
        msg_Client(playerid, COLOR_WHITE, cmsg);
        msg_Client(playerid, COLOR_WHITE, "{FFFFFF}Utilisez {00FF00}/casino entrer{FFFFFF} a l'entr�e pour tester.");
        return 1;
    }

    // === ENTRER DANS LE CASINO ===
    if(strcmp(tmp, "entrer", true)==0 || strcmp(tmp, "enter", true)==0 || strcmp(tmp, "in", true)==0)
    {
        new cid = Casino_GetNearest(playerid);
        if(cid == -1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas pres d'une entr�e de casino.");
        if(casino[cid][caOpen] != 1 && strcmp(casino[cid][caOwner], PlayerInfo[playerid][pRealName], true) != 0 && PlayerInfo[playerid][pAdmin] < 3)
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Ce casino est ferme.");
        if(IsPlayerInAnyVehicle(playerid))
            return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Sortez de votre vehicule.");
        // Teleport propre (interior+VW AVANT pos, streamer pre-charge, freeze 1.5s)
        SafeTeleportPlayer(playerid,
            casino[cid][caIntX], casino[cid][caIntY], casino[cid][caIntZ],
            casino[cid][caInteriorId], casino[cid][caVW], casino[cid][caIntA]);
        new wmsg[140];
        format(wmsg, sizeof(wmsg), "{FFD700} Casino {FFFFFF} Bienvenue au {FFD700}%s{FFFFFF}. Appuyez sur F pour sortir ou /casino jouer <mise>.", casino[cid][caName]);
        msg_Client(playerid, COLOR_WHITE, wmsg);
        return 1;
    }

    // === SORTIR DU CASINO ===
    if(strcmp(tmp, "sortir", true)==0 || strcmp(tmp, "exit", true)==0 || strcmp(tmp, "out", true)==0)
    {
        // Cherche le casino par VW (le joueur doit �tre dans un VW casino)
        new pvw = GetPlayerVirtualWorld(playerid);
        new cid = -1;
        for(new i=0; i<MAX_CASINO; i++)
        {
            if(casino[i][caUsed]==1 && casino[i][caVW]==pvw) { cid=i; break; }
        }
        if(cid == -1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Vous n'�tes pas dans un casino.");
        // Teleport propre vers l'entr�e exterieure
        SafeTeleportPlayer(playerid,
            casino[cid][caX], casino[cid][caY], casino[cid][caZ]+1.0,
            0, 0, -1.0);
        msg_Client(playerid, COLOR_WHITE, "{FFD700} Casino {FFFFFF} Vous quittez le casino.");
        return 1;
    }

    // === DEPLACER L'INTERIEUR (admin) ===
    if(strcmp(tmp, "setint", true)==0 || strcmp(tmp, "setinterieur", true)==0)
    {
        if(PlayerInfo[playerid][pAdmin]<4) return msg_Client(playerid, COLOR_INFO, "{FF0000} Admin {FFFFFF} Niveau 4+ requis.");
        // Le joueur doit �tre dans l'interieur du casino
        new pvw = GetPlayerVirtualWorld(playerid);
        new cid = -1;
        for(new i=0; i<MAX_CASINO; i++)
        {
            if(casino[i][caUsed]==1 && casino[i][caVW]==pvw) { cid=i; break; }
        }
        if(cid == -1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Allez d'abord dans l'interieur du casino.");
        new Float:nx,Float:ny,Float:nz,Float:na;
        GetPlayerPos(playerid, nx, ny, nz);
        GetPlayerFacingAngle(playerid, na);
        casino[cid][caIntX]=nx;
        casino[cid][caIntY]=ny;
        casino[cid][caIntZ]=nz;
        casino[cid][caIntA]=na;
        casino[cid][caInteriorId]=GetPlayerInterior(playerid);
        // Recreer la sortie a la nouvelle position
        if(casino[cid][caExitPickup] != -1) DestroyPickup(casino[cid][caExitPickup]);
        if(_:casino[cid][caExitLabel] != _:INVALID_3DTEXT_ID) Delete3DTextLabel(Text3D:casino[cid][caExitLabel]);
        casino[cid][caExitPickup] = CreatePickup(1318,1,nx,ny,nz,casino[cid][caVW]);
        new Text3D:nLbl = Create3DTextLabel("{FF4444}SORTIE\n{FFFFFF}Touche {FFFF00}F", 0xFFFFFFFF, nx, ny, nz+0.6, 8.0, casino[cid][caVW], 0);
        casino[cid][caExitLabel] = _:nLbl;
        Casino_Save();
        msg_Client(playerid, COLOR_WHITE, "{FFD700} Casino {FFFFFF} Position interieure mise a jour.");
        return 1;
    }

    if(strcmp(tmp, "owner", true)==0 || strcmp(tmp, "proprio", true)==0)
    {
        if(PlayerInfo[playerid][pAdmin]<4) return msg_Client(playerid, COLOR_INFO, "{FF0000} Admin {FFFFFF} Niveau 4+ requis.");
        tmp = strtok(cmdtext, idx);
        if(!strlen(tmp)) return msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /casino owner <id joueur>");
        new target = ReturnUser(tmp);
        if(!IsPlayerConnected(target)) return msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Joueur non connect�.");
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        format(casino[cid][caOwner], MAX_PLAYER_NAME, "%s", PlayerInfo[target][pRealName]);
        casino[cid][caOwnerSQLID]=PlayerInfo[target][pSQLID];
        casino[cid][caForSale]=0;
        Casino_RefreshLabel(cid);
        Casino_Save();
        new omsg[140];
        format(omsg, sizeof(omsg), "{FFD700} Casino {FFFFFF} %s est maintenant proprio de {FFD700}%s.", PlayerInfo[target][pRealName], casino[cid][caName]);
        msg_Client(playerid, COLOR_WHITE, omsg);
        msg_Client(target, COLOR_WHITE, "{FFD700} Casino {FFFFFF} Vous etes maintenant propri�taire d'un casino !");
        return 1;
    }

    if(strcmp(tmp, "supprimer", true)==0 || strcmp(tmp, "delete", true)==0)
    {
        if(PlayerInfo[playerid][pAdmin]<5) return msg_Client(playerid, COLOR_INFO, "{FF0000} Admin {FFFFFF} Niveau 5+ requis.");
        new cid = Casino_GetNearest(playerid);
        if(cid==-1) return msg_Client(playerid, COLOR_INFO, "{CF9756} Casino {FFFFFF} Aucun casino a proximite.");
        if(casino[cid][caPickup]!=-1) DestroyPickup(casino[cid][caPickup]);
        if(casino[cid][caLabel]!=_:INVALID_3DTEXT_ID) Delete3DTextLabel(Text3D:casino[cid][caLabel]);
        casino[cid][caUsed]=0; casino[cid][caPickup]=-1; casino[cid][caLabel]=_:INVALID_3DTEXT_ID;
        Casino_Save();
        msg_Client(playerid, COLOR_WHITE, "{FF0000} Casino {FFFFFF} Casino supprim�.");
        return 1;
    }

    if(strcmp(tmp, "lister", true)==0 || strcmp(tmp, "list", true)==0)
    {
        if(PlayerInfo[playerid][pAdmin]<1) return msg_Client(playerid, COLOR_INFO, "{FF0000} Admin {FFFFFF} Staff requis.");
        new lbody[1024] = "{FFD700}=== Casinos ===\n";
        new lline[150];
        new count=0;
        for(new i=0; i<MAX_CASINO; i++)
        {
            if(casino[i][caUsed]!=1) continue;
            format(lline, sizeof(lline), "ID%d : %s | Proprio : %s | %s | Gains : %d$\n",
                i, casino[i][caName], casino[i][caOwner],
                (casino[i][caOpen]==1?"OUVERT":"FERME"), casino[i][caTotalGains]);
            strcat(lbody, lline);
            count++;
        }
        if(count==0) strcat(lbody, "Aucun casino cree.");
        ShowPlayerDialog(playerid, 9973, DIALOG_STYLE_MSGBOX, "Liste des casinos", lbody, "OK", "");
        return 1;
    }

    msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /casino [jouer|info|open|close|encaisser|vendre|acheter]");
    if(PlayerInfo[playerid][pAdmin]>=4)
        msg_Client(playerid, COLOR_WHITE, "{FFAA00}Admin: /casino [creer|owner|supprimer|lister]");
    return 1;
}

main()
{
	new Inistring[64],mapini[32];
    SetGameModeText(SCRIPT_VERSION);
    format(mapini, sizeof(mapini), "%s",MAP_NAME); strdel(mapini, 0, 3);
	format(Inistring, sizeof(Inistring), "mapname %s",mapini);
	SendRconCommand(Inistring);
	format(Inistring, sizeof(Inistring), "weburl %s",FORUM_NAME);
	SendRconCommand(Inistring);
	format(Inistring, sizeof(Inistring), "hostname %s",HOST_NAME);
	SendRconCommand(Inistring);
	print("Informations");
	print("--------------");
	printf("Gamemode pour SAMP 0.3.7 R2|| Version GM %s",SCRIPT_VERSION);
	print ("- Developped by Dark_Rider29 (Samp Forum)");
	print ("- Mapped by Lurtz59");
	print (" ");
	print("Logs");
	print("------");
