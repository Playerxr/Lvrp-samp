						    if(IsPlayerConnected(i) && PlayerInfo[i][pMember] == 5)
						        {SetPlayerCheckpoint(i,gFirePoints[rand][0], gFirePoints[rand][1], gFirePoints[rand][2], 8);}
						}
						return 1;
					}
				}
				else if(strcmp(tmp,"feumanuel",true) == 0)
