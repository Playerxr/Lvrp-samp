        else if(agomin >= 1) format(agotxt, sizeof(agotxt), "il y a %dmin", agomin);
        else format(agotxt, sizeof(agotxt), "a l'instant");

        format(line, sizeof(line), "{FFD700}%s{FFFFFF} (%d) - %s\n",
            PhoneMissed_Name[playerid][i], PhoneMissed_Num[playerid][i], agotxt);
        strcat(list, line, sizeof(list));
    }
    PhoneDialog_State[playerid] = 11; // Liste appels manques - selection pour rappeler
    return ShowPlayerDialog(playerid, 9997, DIALOG_STYLE_LIST,
        "{8B8B00} Appels manques {FFFFFF} Cliquez pour rappeler", list, "Rappeler", "Retour");
}

