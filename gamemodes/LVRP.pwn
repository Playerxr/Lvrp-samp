        return Market_OnDialogResponse(playerid, dialogid, response, listitem);
    }

    // [JOBS TUTO] Dialog liste des metiers - clic = checkpoint + details
    if(dialogid == 9311)
    {
        if(!response) return 1;
        // Coords des employeurs (correspondent a la liste affich�e)
        new const Float:jobCoords[14][3] = {
            {2117.32, -1790.55, 13.55}, // 0  Pizza
            {-382.69, -1426.28, 26.24}, // 1  Fermier
            {2276.65, -2226.90, 13.54}, // 2  Eboueur
            {1969.42, -2189.07, 13.54}, // 3  Pilote
            {1743.12, -1582.02, 13.54}, // 4  Facteur
            { 906.10, -1904.29,  1.12}, // 5  Pecheur
            { 321.88, -1519.53, 36.03}, // 6  Voiturier
            {2422.93, -2075.87, 13.55}, // 7  Camionneur
            {1906.70, -2207.90, 13.54}, // 8  Bagagiste LS
            {1174.00,  -485.00, 26.54}, // 9  Bucheron
            {1008.49, -1358.39, 13.39}, // 10 M�canicien
            {1059.80, -1350.60, 13.54}, // 11 Taxi LS
            {1516.96, -1022.16, 23.83}, // 12 Convoyeur
            {0.0, 0.0, 0.0}             // 13 >> Aide
        };
        new const jobNames[14][24] = {
            "Pizza", "Fermier", "Eboueur", "Pilote de Ligne", "Facteur",
            "Pecheur", "Voiturier", "Camionneur", "Bagagiste", "Bucheron",
            "M�canicien", "Chauffeur Taxi", "Convoyeur de fonds", "Aide"
        };
        if(listitem == 13)
        {
            // Aide generale
            ShowPlayerDialog(playerid, 9312, DIALOG_STYLE_MSGBOX, "{FF6600}Comment travailler",
                "{FFFFFF}1. Tape {00FF00}/jobs{FFFFFF} pour voir les metiers.\n\
2. Choisis-en un - un checkpoint rouge apparait sur la carte.\n\
3. Va a l'employeur (point rouge).\n\
4. Appuie sur {FFFF00}N{FFFFFF} a cote de l'employeur pour signer.\n\
5. Prends un vehicule de travail et fais les missions.\n\
6. Le salaire (PayDay) tombe toutes les 30 minutes de travail.\n\n\
{FF6600}Astuce :{FFFFFF} commence par {FFFF00}Pizza{FFFFFF} ou {FFFF00}Eboueur{FFFFFF}, ils sont les plus faciles.",
                "OK", "");
            return 1;
        }
        // Checkpoint vers le job + message
        SetPlayerCheckpoint(playerid, jobCoords[listitem][0], jobCoords[listitem][1], jobCoords[listitem][2], 3.0);
        new msg[160];
        format(msg, sizeof(msg), "{FF6600}[Job]{FFFFFF} Checkpoint trace vers {FFFF00}%s{FFFFFF}. Suis-le, puis touche {FFFF00}N{FFFFFF} a cote de l'employeur.", jobNames[listitem]);
        SendClientMessage(playerid, -1, msg);
        return 1;
    }

    // Retours depuis apps info (9300, 9310, 9320, 9330, 9340, 9350, 9360, 9370)
    if(dialogid == 9300 || dialogid == 9310 || dialogid == 9320 || dialogid == 9330 ||
       dialogid == 9340 || dialogid == 9350 || dialogid == 9360 || dialogid == 9370 ||
       dialogid == 9330 || dialogid == 9453)
    {
        pScreen[playerid] = PSCREEN_HOME;
        Phone_Show(playerid);
