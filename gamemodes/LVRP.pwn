	// ============================================================

	// -- Restrictions Coma ----------------------------------------
	if(medic_PlayerNeedMedic[playerid] == 2 && PlayerInfo[playerid][pComaTime] > 0)
	{
	    if(strcmp(cmd,"/me",true)!=0 && strcmp(cmd,"/do",true)!=0 &&
	       strcmp(cmd,"/b",true)!=0 && strcmp(cmd,"/report",true)!=0 &&
	       strcmp(cmd,"/appel",true)!=0 && strcmp(cmd,"/911",true)!=0 &&
	       strcmp(cmd,"/sos",true)!=0 && strcmp(cmd,"/feu",true)!=0 &&
	       strcmp(cmd,"/ambulance",true)!=0 && strcmp(cmd,"/samu",true)!=0)
	    {
