// ============================================================
// NEX-AC : Anti-cheat avec whitelist admin automatique
// Telecharger nex-ac.inc depuis: github.com/NexiusTailer/Nex-AC
// Decommenter "#include <nex-ac>" ci-dessus pour activer
// ============================================================
#if defined _nex_ac_included

forward OnCheatDetected(playerid, ip_address[], type, code);
public OnCheatDetected(playerid, ip_address[], type, code)
{
    // === WHITELIST : les admins ne sont JAMAIS sanctionnes ===
    if(IsPlayerConnected(playerid) && PlayerInfo[playerid][pAdmin] >= 1)
        return 1;

    new ac_name[MAX_PLAYER_NAME], ac_msg[128];
    GetPlayerName(playerid, ac_name, sizeof(ac_name));

    // Notifier les admins
    format(ac_msg, sizeof(ac_msg), "[NEX-AC] %s[%d] triche detectee code %d.", ac_name, playerid, code);
    msg_Admin(COLOR_RED, ac_msg, 1);

    if(type == 1) // Ban IP
    {
        BlockIpAddress(ip_address, 0);
        new ban_q[256];
        format(ban_q, sizeof(ban_q),
            "INSERT INTO lvrp_users_bans (SQLid,BannedBy,Ip,Reason,Date,Time) VALUES ('%d','NEX-AC','%s','Cheat code %d',UNIX_TIMESTAMP(),-1)",
            PlayerInfo[playerid][pSQLID], ip_address, code);
        mysql_tquery(MYSQL, ban_q, "", "");
    }
    AntiCheatKickWithDesync(playerid, code);
    return 1;
}

