	        GetPlayerName(Clicked[playerid],Kicked,sizeof(Kicked));
	        
	        if(!strlen(inputtext))
	        	{format(string,sizeof(string),"[Ban] %s a t banni par l'admin %s, raison : Aucune.",Kicked,sendername);}
	        else
	        	{format(string,sizeof(string),"[Ban] %s a t banni par l'admin %s, raison : %s ",Kicked,sendername,inputtext);}
	        
			SendClientMessageToAll(COLOR_LIGHTRED, string);
