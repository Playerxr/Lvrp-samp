public Drug_StopDrunkAnim(playerid)
{
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    if(DrugODShake[playerid] == 1) return 0; // overdose en cours, ne pas couper
    ClearAnimations(playerid);
    return 1;
}

public Drug_MildShake(playerid)
{
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid))
    { DrugMildShake[playerid]=0; DrugMildCount[playerid]=0; return 0; }
    // [ANTI-BUG] overdose demarre entre temps -> stopper le leger effet
    if(DrugODShake[playerid] == 1)
    { DrugMildShake[playerid]=0; DrugMildCount[playerid]=0; return 0; }
    // [ANTI-BUG] joueur mort
    new Float:hp2; GetPlayerHealth(playerid, hp2);
    if(hp2 <= 0.0)
    { DrugMildShake[playerid]=0; DrugMildCount[playerid]=0; SetPlayerDrunkLevel(playerid,0); return 0; }
    DrugMildCount[playerid]++;
    // 90 iterations a 1 seconde = 1min30s de tremblement
    if(DrugMildCount[playerid] > 90)
    {
        DrugMildShake[playerid] = 0; DrugMildCount[playerid] = 0;
        if(PlayerDrunk[playerid] > 0) SetPlayerDrunkLevel(playerid, PlayerDrunk[playerid]);
        else SetPlayerDrunkLevel(playerid, 0);
        return 0;
    }
    // Leger tremblement discret, toutes les secondes
    if(DrugMildCount[playerid] % 2 == 0)
        SetPlayerDrunkLevel(playerid, 1800);
    else
        SetPlayerDrunkLevel(playerid, 800);
    SetTimerEx("Drug_MildShake", 1000, false, "i", playerid);
    return 1;
}

public Drug_OverdoseShake(playerid)
{
    // [ANTI-BUG] Joueur d�connect� ou NPC
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid))
    {
        DrugODShake[playerid] = 0; DrugODShakeCount[playerid] = 0;
        return 0;
    }
    // [ANTI-BUG] Joueur deja mort -> stopper proprement
    new Float:hp;
    GetPlayerHealth(playerid, hp);
    if(hp <= 0.0)
    {
        DrugODShake[playerid] = 0; DrugODShakeCount[playerid] = 0;
        SetPlayerDrunkLevel(playerid, 0);
        return 0;
    }
    DrugODShakeCount[playerid]++;

    // --- Fin des 10 secondes : OVERDOSE -> mort ---
    if(DrugODShakeCount[playerid] >= 10)
    {
        DrugODShake[playerid] = 0; DrugODShakeCount[playerid] = 0;
        PlayerStoned[playerid] = 0;
        SetPlayerDrunkLevel(playerid, 0);
        // Message RP visible des joueurs proches
        new odStr[128];
        format(odStr, sizeof(odStr), "* %s s'effondre, une overdose massive.", PlayerInfo[playerid][pName]);
        ProxDetector(15.0, playerid, odStr, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,true);
        // GameText "OVERDOSE" sur l'ecran du joueur
        GameTextForPlayer(playerid, "~r~~h~OVERDOSE", 5000, 5);
        // [ANTI-BUG] Utiliser SetPlayerHealth(0) qui declenche OnPlayerDeath normalement
        SetPlayerHealth(playerid, 0.0);
        return 0;
    }

    // --- Pendant les 10 secondes : tremblement severe ---
    // Alterner fort (8000) / tres fort (12000) -> effet de secousse violente
    if(DrugODShakeCount[playerid] % 2 == 0)
        SetPlayerDrunkLevel(playerid, 12000);
    else
        SetPlayerDrunkLevel(playerid, 6000);

    SetTimerEx("Drug_OverdoseShake", 1000, false, "i", playerid);
    return 1;
}

public StopCameraEffect(playerid)
{
    // [FIX] Si effet overdose actif, ne pas couper l'ivresse alcool
    if(DrugODShake[playerid] == 1) return 1; // laisser Drug_OverdoseShake gerer
    return SetPlayerDrunkLevel(playerid, 0), 1;
}

