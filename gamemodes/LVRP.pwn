					    new Float:x,Float:y,Float:z;
					    GetPlayerPos(playerid,x,y,z);
					    SetTimerEx("fire_StartFire", 15000, false, "fff", x,y,z);
					    SendFamilyMessage(5,COLOR_RED," Alerte  Un feu s'est dclar (Point rouge minimap)");
						msg_Client(playerid,COLOR_POMPIER,"{C7006C} Pompier {FFFFFF} Vous avez dclar un feu  cette endroit dans 15 secondes.");
						for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
