stock job_GetXp(playerid,job)
{
    new xp;
    switch(job)
    {
        case 0:
            {return 0;}
        case 1,2,3,4,5,7,8,9,19:
            {xp = (PlayerInfo[playerid][pJobLvl]*20);}
		case 6,10, 11:
		    {xp = (PlayerInfo[playerid][pJobLvl]*8);}
		default:
			{return 1;}
    }
    // [VIP] Progression acceleree : r�duit l'XP requise pour level up selon le palier
    switch(PlayerInfo[playerid][pDonateRank])
    {
        case 1: xp = floatround(float(xp)*0.90);
        case 2: xp = floatround(float(xp)*0.85);
        case 3: xp = floatround(float(xp)*0.80);
        case 4: xp = floatround(float(xp)*0.70);
    }
    if(xp < 1) xp = 1;
    return xp;
}

