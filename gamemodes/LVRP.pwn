public OnGameModeInit()
{
    // === [ANTI-CHEAT] D�marrage du timer anti-cheat & god mode ===
    SetTimer("GodModeTimer", 2000, true); // Maintient vie infinie en Hacker Mode
	printf("GameMode %s",NICK_NAME);
	print("---------------");

	// [DIAGNOSTIC RESTART] Log de demarrage pour diagnostiquer les restart automatiques
	// Si vous voyez ces logs apparaitre frequemment dans les logs serveur, c'est que le
	// serveur redemarre - regardez si c'est avant 4h00 (reboot programme) ou pas
	new dHour, dMin, dSec, dDay, dMonth, dYear;
	gettime(dHour, dMin, dSec);
	getdate(dYear, dMonth, dDay);
	printf("==========================================");
