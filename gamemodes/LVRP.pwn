	cache_get_value_name_int(0,"iQ15", vehicle[vehicleid][cItemQ][14]);
	// [FIX coffre plein] Normaliser les slots items : MySQL retourne 0 pour les colonnes vides
	// mais le code utilise -1 comme sentinelle "slot vide".
	for(new _fi=0; _fi<15; _fi++)
		{if(vehicle[vehicleid][cItemM][_fi] == 0) vehicle[vehicleid][cItemM][_fi] = -1;}
	vehicle[vehicleid][cBody]=-1;
	vehicle[vehicleid][used] = 1;
	
	if(vehicle[vehicleid][cVW] == CAR_INT_DEATH)
		{vehicle[vehicleid][cVW]=0;}
	totalVehicles++;
	tuning_Load(vehicleid);
	ChangeVehicleColor(vehicleid,vehicle[vehicleid][cColorOne],vehicle[vehicleid][cColorTwo]);
	SafeSetVehicleHealth(vehicleid,vehicle[vehicleid][cHealth]);
	UpdateVehicleDamageStatus(vehicleid,vehicle[vehicleid][cPanels],vehicle[vehicleid][cDoors],vehicle[vehicleid][cLights],vehicle[vehicleid][cTires]);
	SetPlayerCheckpoint(playerid,x,y,z,5.0);
	format(vehicle[vehicleid][stream],256,"Aucun");
	format(string,sizeof(string),"{8BE2E2} Vhicule {FFFFFF} Votre vhicule a bien t spawn. [ID:SAMP %d - ID:SQL %d] (Point rouge minimap)",vehicleid,vehicle[vehicleid][SQLID]);
	msg_Client(playerid,COLOR_INFO,string);
	if(IsABike(vehicleid) || IsAMoto(vehicleid))
		{vehicle[vehicleid][cLock]=0;}
	for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
	{
		if(IsPlayerConnected(i))
		    {SetVehicleParamsForPlayer(vehicleid,i,0,vehicle[vehicleid][cLock]);}
	}

	// [FIX PARKING] Si le chargement a �t� demande depuis /parking, amener le vehicule au parking
	new parkingLoadSlot = GetPVarInt(playerid, "parking_LoadSlot");
	new parkingLoadPid  = GetPVarInt(playerid, "parking_LoadPid");
	if(parkingLoadPid >= 0 && parkingLoadPid < MAX_PARKING && parkings[parkingLoadPid][paUsed] == 1)
	{
		new Float:pOffsetX = float(parkingLoadSlot) * 2.5;
		SafeSetVehiclePos(vehicleid,
			parkings[parkingLoadPid][paX] + pOffsetX,
			parkings[parkingLoadPid][paY],
			parkings[parkingLoadPid][paZ] + 0.5);
		SetVehicleZAngle(vehicleid, 0.0);
		SetVehicleVirtualWorld(vehicleid, 0);
		LinkVehicleToInterior(vehicleid, 0);
		vehicle[vehicleid][cVW] = 0;
		vehicle[vehicleid][cInt] = 0;
		vehicle[vehicleid][cLocationx] = parkings[parkingLoadPid][paX] + pOffsetX;
		vehicle[vehicleid][cLocationy] = parkings[parkingLoadPid][paY];
		vehicle[vehicleid][cLocationz] = parkings[parkingLoadPid][paZ] + 0.5;
		vehicle[vehicleid][cAngle] = 0.0;
		vehicle_Save(vehicleid, 0, 0);
		SetPlayerCheckpoint(playerid,
			parkings[parkingLoadPid][paX] + pOffsetX,
			parkings[parkingLoadPid][paY],
			parkings[parkingLoadPid][paZ] + 0.5, 5.0);
		new pMsg[128];
		format(pMsg, sizeof(pMsg), "{42AAFF} Parking {FFFFFF} Votre %s est arrive au parking (point rouge minimap).", vehicle[vehicleid][cDescription]);
		msg_Client(playerid, COLOR_WHITE, pMsg);
		// [PARKING PAYANT] debit + ticket + label
		ParkingPay_ApplyPayment(playerid, vehicle[vehicleid][SQLID], parkingLoadPid, vehicleid);
	}
	// Reset PVars parking apres usage
	DeletePVar(playerid, "parking_LoadSlot");
	DeletePVar(playerid, "parking_LoadPid");

	return 1;
}

public OnCheckNameBan(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    if(cache_num_rows() > 0)
    {
        SendClientMessage(playerid, 0xFF0000FF, "[AFRP] Vous etes banni de ce serveur (nom).");
        SetTimerEx("TimerKick", 500, 0, "i", playerid);
    }
    return 1;
}

public OnCheckPendingAccount(playerid)
{
    #pragma unused playerid
    return 1;
}

public beta_CheckKey(playerid,betaKey)
{
	new bool:tmpUse=true;
	new count = 0, tmp = 0;
	if(cache_get_row_count(count) && count > 0)
		{
			cache_get_value_index_int(0,0, tmp);
			tmpUse = !!tmp;
		}
	if(betaKey == 19082014)
	{
	    ShowPlayerDialog(playerid,81,DIALOG_STYLE_MSGBOX," Beta Ferme ","{FFFFFF}Votre cle beta a t valide, cliquez sur 'Valider' pour commencer l'inscription.","Valider","");
		inscription_Step[playerid]=0;
	    return 1;
	}
	if(tmpUse == false)
	{
	    format(sql,sizeof(sql),"UPDATE lvrp_server_betakeys SET used=1 WHERE serial=%d",betaKey);
	    mysql_pquery(MYSQL,sql);
	    
		ShowPlayerDialog(playerid,81,DIALOG_STYLE_MSGBOX," Beta Ferme ","{FFFFFF}Votre cle beta a t valide, cliquez sur 'Valider' pour commencer l'inscription.","Valider","");
		inscription_Step[playerid]=0;
	    return 1;
	}
	return ShowPlayerDialog(playerid,45,DIALOG_STYLE_INPUT," Beta Ferme ","{FF0000}Cette cle est invalide !\n\n{FFFFFF}Entrez votre cle beta pour vous inscrire :","Valider","");
}

