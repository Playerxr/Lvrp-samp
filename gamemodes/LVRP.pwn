// === SYSTEME ACHAT VEHICULE DE FACTION (par chef de gang/mafia) ===
// ============================================================================
forward FactionBuy_PriceCallback(playerid);
public FactionBuy_PriceCallback(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new rows = 0;
    cache_get_row_count(rows); // [FIX W202]
    if(rows == 0)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Faction Achat \xab{FFFFFF} Ce model n'est pas dans le catalogue.");
        return 1;
    }
    new vehPrice;
    cache_get_value_name_int(0, "Price", vehPrice);

    new facID = player_FactionBuyFacID[playerid];
    new modelid = player_FactionBuyModel[playerid];
    player_FactionBuyFacID[playerid] = -1;
    player_FactionBuyModel[playerid] = 0;

    if(facID < 0 || facID >= MAX_FACTION || FactionInfo[facID][fCreate] != 1)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Faction Achat \xab{FFFFFF} Faction invalide.");
        return 1;
    }

    if(FactionInfo[facID][fCash] < vehPrice)
    {
        new fbmsg[200];
        format(fbmsg, sizeof(fbmsg), "{CF9756}\xbb Faction Achat \xab{FFFFFF} Coffre insuffisant. Prix : $%d, Coffre : $%d.",
            vehPrice, FactionInfo[facID][fCash]);
        msg_Client(playerid, COLOR_INFO, fbmsg);
        return 1;
    }

    // Spawn le vehicule a cote du joueur
    new Float:px, Float:py, Float:pz, Float:pa;
    GetPlayerPos(playerid, px, py, pz);
    GetPlayerFacingAngle(playerid, pa);

    new thiscar = CreateVehicle(modelid, px + 4.0, py + 4.0, pz, pa, 1, 1, -1);
    if(thiscar == INVALID_VEHICLE_ID || thiscar < 1 || thiscar >= MAX_CAR)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Faction Achat \xab{FFFFFF} Erreur : limite de v�hicules atteinte. Contactez un admin.");
        return 1;
    }

    // Deduire du coffre
    FactionInfo[facID][fCash] -= vehPrice;

    // INSERT en BDD avec Type=CAR_FACTION et Description = faction
    new vehSql[500], escFacName[128];
    mysql_escape_string(FactionInfo[facID][fName], escFacName);
    format(vehSql, sizeof(vehSql),
        "INSERT INTO lvrp_server_vehicles SET Model=%d, Pos_x=%f, Pos_y=%f, Pos_z=%f, Angle=%f, Description='Faction %s', Owner='%s', SQLID=%d, Owned=1, Color1=1, Color2=1, License='FAC', Type=%d",
        modelid, px + 4.0, py + 4.0, pz, pa, escFacName, escFacName, facID, CAR_FACTION);
    new Cache:buyCache = mysql_query(MYSQL, vehSql);
    vehicle[thiscar][SQLID] = cache_insert_id();
    cache_delete(buyCache);
    vehicle[thiscar][ownerSQLID] = facID;
    vehicle[thiscar][cType] = CAR_FACTION;
    totalVehicles++;

    new okmsg[220];
    format(okmsg, sizeof(okmsg),
        "{9EC73D}[FACTION ACHAT]{FFFFFF} Vehicule (model %d) achet� pour $%d. Coffre restant : $%d.",
        modelid, vehPrice, FactionInfo[facID][fCash]);
    msg_Client(playerid, COLOR_GREEN, okmsg);

    new annmsg[200];
    format(annmsg, sizeof(annmsg),
        "{9EC73D}[FACTION]{FFFFFF} %s a achet� un nouveau vehicule pour la faction (model %d, $%d).",
        PlayerInfo[playerid][pName], modelid, vehPrice);
    // Annoncer a tous les membres de la faction
    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p) || gPlayerLogged[p] != 1) continue;
        if(PlayerInfo[p][pMember] == PlayerInfo[playerid][pLeader] ||
           PlayerInfo[p][pLeader] == PlayerInfo[playerid][pLeader])
        {
            msg_Client(p, COLOR_GREEN, annmsg);
        }
    }
    return 1;
}

