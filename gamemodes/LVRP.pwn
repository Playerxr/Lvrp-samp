            format(nmsg, sizeof(nmsg), "Entrez le nouveau nom pour le p�age %d :\nActuel : {FFAA00}%s", pid+1, Peages[pid][peName]);
            ShowPlayerDialog(playerid, 9998, DIALOG_STYLE_INPUT,
                "Renommer le p�age", nmsg, "Confirmer", "Annuler");
