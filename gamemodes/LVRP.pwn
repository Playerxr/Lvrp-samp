stock Phone_FindContactByName(playerid, const name[])
{
    for(new i = 0; i < PhoneContact_Count[playerid]; i++)
    {
        if(strcmp(PhoneContact_Name[playerid][i], name, true) == 0)
            return i;
    }
    return -1;
}


stock Phone_GetNameFromNum(playerid, num, dest[], maxlen)
{
    // Retourne le nom du contact s'il existe, sinon "Inconnu"
    new idx = Phone_FindContactByNum(playerid, num);
    if(idx != -1)
        {format(dest, maxlen, "%s", PhoneContact_Name[playerid][idx]); return 1;}
    format(dest, maxlen, "Inconnu");
    return 0;
}







