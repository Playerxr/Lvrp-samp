							{msg_Client(playerid,COLOR_INFO,"{CF9756} Info {FFFFFF} Ce joueur n'est fait pas parti de votre faction.");return 1;}
						PlayerInfo[giveplayerid][pRank] = 0;
						PlayerInfo[giveplayerid][pLeader] = 0;
