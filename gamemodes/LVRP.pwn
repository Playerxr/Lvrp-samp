            if(vehicle[idcar][cType] != CAR_EVENT && vehicle[idcar][cType] != CAR_RESERVED)
		        {return msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Ce vhicule n'est pas un vhicule d'event.");}
		        
