	            new Float:ax, Float:ay, Float:az;
	            GetActorPos(a, ax, ay, az);
	            format(aline, sizeof(aline), "Actor %d : (%.1f, %.1f, %.1f)\n", a, ax, ay, az);
	            if(strlen(actorStr) + strlen(aline) < sizeof(actorStr) - 50)
	                strcat(actorStr, aline, sizeof(actorStr));
	            countActors++;
	        }
	    }
	    new totLine[100];
	    format(totLine, sizeof(totLine), "\nTotal : %d actors actifs", countActors);
	    strcat(actorStr, totLine, sizeof(actorStr));
	    ShowPlayerDialog(playerid, 9996, DIALOG_STYLE_MSGBOX, "{FFAA00} Actors ", actorStr, "OK", "");
	    return 1;
	}
