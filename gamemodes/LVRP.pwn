public timer_1mn()
{
	// Decrementer cooldown annonce hopital
	for(new _hp=0; _hp<MAX_PLAYERS_CURRENT+1; _hp++)
		if(IsPlayerConnected(_hp) && hopital_AnnCooldown[_hp] > 0) hopital_AnnCooldown[_hp]--;

    MySQLCheckConnexion(); // Keepalive MySQL
    for(new i=0; i < MAX_PLAYERS_CURRENT+1; i++)
	{
	    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(gPlayerLogged[i]!=0)
			{
				// Bonus PayDay
				if(afk_Check[i]!=-1)
				{
	                PlayerInfo[i][pPayCheck]+=PlayerInfo[i][pLevel]*8;
	                PlayerInfo[i][pPayDayHad]++;
	    			if(PlayerInfo[i][pPayDayHad]>= 60)
						{PayDay(i);}
				}

			    if(PlayerInfo[i][pWepTrainTime] > 0)
					{PlayerInfo[i][pWepTrainTime]--;}
					
                if(PlayerInfo[i][pJobRemain] > 0)
					{PlayerInfo[i][pJobRemain]--;}

				if(PlayerInfo[i][pLangTrainTime] >0)
				    {PlayerInfo[i][pLangTrainTime]--;}

				if(PlayerInfo[i][pVipTime] > 0)
					{PlayerInfo[i][pVipTime]--;}
					
				if(PlayerInfo[i][pVipTime]==0 && PlayerInfo[i][pDonateRank] > 0)
				{
					PlayerInfo[i][pDonateRank]=0;
					// [FIX VIP CORRIGE] Desactive juste les slots, GARDE les v�hicules
					// Quand le joueur renouvelle son VIP, il retrouve ses v�hicules slot 4-6
					PlayerInfo[i][pCarDev4]=0;
					PlayerInfo[i][pCarDev5]=0;
					PlayerInfo[i][pCarDev6]=0;
					MySQLUpdatePlayerIntSingle(PlayerInfo[i][pSQLID],"CarUnLock4",0);
					MySQLUpdatePlayerIntSingle(PlayerInfo[i][pSQLID],"CarUnLock5",0);
					MySQLUpdatePlayerIntSingle(PlayerInfo[i][pSQLID],"CarUnLock6",0);
					msg_Client(i,COLOR_VIP,"{96009C} V.I.P {FFFFFF} Votre dure de temps VIP a expir. Vous n'tes plus VIP.");
					if(PlayerInfo[i][pCar][3] != -1 || PlayerInfo[i][pCar][4] != -1 || PlayerInfo[i][pCar][5] != -1)
						msg_Client(i,COLOR_VIP,"{96009C} V.I.P {FFFFFF} Vos vhicules slots 4-6 sont conservs mais inaccessibles. Renouvelez votre VIP pour les utiliser.");
				}

				if(job_Start[i] != 0 || mecano_Duty[i] == 1)
					{PlayerInfo[i][pJobTime]++;}
				    
				// FIX : ajout hopital_Duty pour que les m�decins gagnent leur salaire
				// [FIX ARMEE] Militaires en service comptent pour le salaire
				if(police_Duty[i]==1 || gouv_Duty[i]==1 || fire_Duty[i] == 1 || hopital_Duty[i]==1 || armee_Duty[i]==1)
				    {PlayerInfo[i][pDutyTime]++;}

				new hour, minute, second;
				gettime(hour, minute, second);
				if(AdminDuty[i] == 0)
					{SetPlayerTime(i, hour, minute);}
				if(phone_Active[i]==1)
				{
				    new tmp[16];
				    format(tmp,sizeof(tmp),"%02dh%02d",hour,minute);
				    PlayerTextDrawSetString(i,phone_Hours[i],tmp);
				}
			}
		}
	}
    seed_Timer();
    RemiX_Time_Tools();
    car_CheckGas();
}

public timer_1s()
{
    for(new i=0; i < MAX_PLAYERS_CURRENT+1; i++)
	{
	    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(gPlayerLogged[i]!=0)
			{
			    //player_UpdateLabel(i);
			    // Coma countdown 20 minutes
			    if(medic_PlayerNeedMedic[i] == 2 && PlayerInfo[i][pComaTime] > 0)
			    {
			        PlayerInfo[i][pComaTime]--;
			        medic_PlayerMedicTime[i] = PlayerInfo[i][pComaTime];
			        new comaStr[32];
			        format(comaStr, sizeof(comaStr), "~r~COMA~n~~w~%d:%02d", PlayerInfo[i][pComaTime]/60, PlayerInfo[i][pComaTime]%60);
			        GameTextForPlayer(i, comaStr, 1500, 3);
			        if(PlayerInfo[i][pComaTime] % 30 == 0)
			            MySQLUpdatePlayerIntSingle(PlayerInfo[i][pSQLID], "ComaTime", PlayerInfo[i][pComaTime]);
			    }
				if(IsPlayerInAnyVehicle(i))
					{camera_Update(i);}
				else
				    {CustomPickups(i);}

				// === Suivi du joueur menott? ===
				// Quand un joueur est menott?, il suit automatiquement le militaire qui l'a menott?
				if(player_Cuffed[i] == 1 && player_CuffedBy[i] != -1)
				{
					new officer = player_CuffedBy[i];
					if(IsPlayerConnected(officer) && !IsPlayerInAnyVehicle(officer) && !IsPlayerInAnyVehicle(i))
					{
						new Float:ox, Float:oy, Float:oz, Float:oa;
						GetPlayerPos(officer, ox, oy, oz);
						GetPlayerFacingAngle(officer, oa);
						// Placer le menott? l?g?rement derri?re le militaire
						ox -= 0.9 * floatsin(-oa, degrees);
						oy -= 0.9 * floatcos(-oa, degrees);
						SetPlayerPos(i, ox, oy, oz);
						SetPlayerFacingAngle(i, oa);
					}
				}
			}
		}
	}
}


public job_ResetFreeze(playerid,other)
{
	if(PlayerInfo[playerid][pJob]==19)
	{
	    job_CheckPoints[playerid]++;
	    if(job_CheckPoints[playerid]==3)
	    	{job_TakePay(playerid,PlayerInfo[playerid][pJob]);job_CheckPoints[playerid]=0;}
	    PlayerInfo[playerid][pJobExp]++;job_UpdateTexts(playerid);
		atm[other][cash]=30000;
		atm_UpdateInfos(other);
		atm_Save(other);
		job_TempVar[playerid]=0;
		DestroyDynamicMapIcon(atm_Icon[playerid][other]);
		msg_Client(playerid,COLOR_JOB,"{78769D} Job {FFFFFF} ATM remplie.");
	}
	if(PlayerInfo[playerid][pJob]==10)
		{msg_Client(playerid,COLOR_JOB,"{78769D} Job {FFFFFF} Vous pouvez y aller.");}
	if(PlayerInfo[playerid][pJob]==11)
		{msg_Client(playerid,COLOR_JOB,"{78769D} Job {FFFFFF} Vous pouvez y aller.");}
		
	TogglePlayerControllable(playerid,true);
	return 1;
}

