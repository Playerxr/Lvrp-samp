            return 1;
        }
        new price = strval(tmp_price);
        new length = strlen(cmdtext);
        while ((idx < length) && (cmdtext[idx] <= ' ')) idx++;
        new offset = idx;
        new descBuf[100];
        while ((idx < length) && ((idx - offset) < (sizeof(descBuf) - 1)))
            {descBuf[idx - offset] = cmdtext[idx]; idx++;}
        descBuf[idx - offset] = EOS;
        return Market_CmdPost(playerid, price, descBuf);
    }

