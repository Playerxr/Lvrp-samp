stock armee_Update(id)
{
    // Cration pickup entre si coordonnes dfinies
    if(ArmeeInfo[id][ar_Entrance][0] != 0.0)
    {
        if(IsValidDynamicPickup(ArmeeInfo[id][ar_entrancePickup]))
            DestroyDynamicPickup(ArmeeInfo[id][ar_entrancePickup]);
        if(IsValidDynamic3DTextLabel(ArmeeInfo[id][ar_entranceLabel]))
            DestroyDynamic3DTextLabel(ArmeeInfo[id][ar_entranceLabel]);
        new armNames[3][] = {"Arme de Terre","Arme de l'Air","Marine"};
        new lbl[64];
        format(lbl,sizeof(lbl),"[QG %s]",armNames[id]);
        ArmeeInfo[id][ar_entrancePickup] = CreateDynamicPickup(1239,23,ArmeeInfo[id][ar_Entrance][0],ArmeeInfo[id][ar_Entrance][1],ArmeeInfo[id][ar_Entrance][2]);
        ArmeeInfo[id][ar_entranceLabel] = CreateDynamic3DTextLabel(lbl,0x5B7A3AFF,ArmeeInfo[id][ar_Entrance][0],ArmeeInfo[id][ar_Entrance][1],ArmeeInfo[id][ar_Entrance][2]+1,12.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,0,0,-1,40.0);
    }
    return 1;
}







