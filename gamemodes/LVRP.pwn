public turf_LoadCallback()
{
    new rows = 0;
    cache_get_row_count(rows); // [FIX W202] Argument requis dans cette version du plugin MySQL
    turf_LoadedCount = 0;
    // [SAFETY] Garde-fous pour eviter le crash Run time error 4
    if(rows <= 0)
    {
        printf("[TURF] Aucun territoire dans la BDD.");
        return 1;
    }
    if(rows > MAX_TURFS) rows = MAX_TURFS;
    // Reset Turfs array completement
    for(new k = 0; k < MAX_TURFS; k++)
    {
        Turfs[k][tUsed] = 0;
        Turfs[k][tGangZone] = -1;
    }
    for(new r = 0; r < rows; r++)
    {
        // Double protection
        if(r < 0 || r >= MAX_TURFS) continue;

        new turf_sqlid = 0;
        new tcolor = 0;
        new ttype = 0;
        new tlastcap = 0;
        new tname[64];
        new towner[64];
        new Float:minx = 0.0, Float:miny = 0.0, Float:maxx = 0.0, Float:maxy = 0.0;

        cache_get_value_name_int(r, "id", turf_sqlid);
        cache_get_value_name(r, "Name", tname, 64);
        cache_get_value_name_float(r, "MinX", minx);
        cache_get_value_name_float(r, "MinY", miny);
        cache_get_value_name_float(r, "MaxX", maxx);
        cache_get_value_name_float(r, "MaxY", maxy);
        cache_get_value_name_int(r, "Color", tcolor);
        cache_get_value_name(r, "Owner", towner, 64);
        cache_get_value_name_int(r, "ZoneType", ttype);
        cache_get_value_name_int(r, "LastCapture", tlastcap);

        // Affecter en passant par variables locales (evite garbage memory)
        Turfs[r][tSQLID] = turf_sqlid;
        format(Turfs[r][tName], 64, "%s", tname);
        Turfs[r][tMinX] = minx;
        Turfs[r][tMinY] = miny;
        Turfs[r][tMaxX] = maxx;
        Turfs[r][tMaxY] = maxy;
        Turfs[r][tColor] = tcolor;
        format(Turfs[r][tOwner], 64, "%s", towner);
        Turfs[r][tType] = ttype;
        Turfs[r][tLastCapture] = tlastcap;

        // [COULEUR FIX ROBUSTE] Forcer une couleur visible dans tous les cas
        new finalAlpha = Turfs[r][tColor] & 0xFF;
        new finalRGB = Turfs[r][tColor] & 0xFFFFFF00;
        // 1. Si Color = 0 (totalement invisible) OU alpha trop faible -> force couleur selon contexte
        if(Turfs[r][tColor] == 0 || finalAlpha < 0x60)
        {
            // Selon le type de zone
            if(Turfs[r][tType] == 1)
                Turfs[r][tColor] = 0x00FF00AA;  // vert police
            else if(Turfs[r][tType] == 2)
                Turfs[r][tColor] = 0xFF1493AA;  // rose hopital
            else if(!strcmp(towner, "Aucun", true) || !strlen(towner))
                Turfs[r][tColor] = 0xFFFFFFAA;  // blanc neutre
            else
                Turfs[r][tColor] = finalRGB | 0xAA;  // garde la couleur RGB mais force alpha
        }
        // 2. Si owner est "Aucun" mais couleur RGB existe, forcer blanc
        else if(!strcmp(towner, "Aucun", true) || !strlen(towner))
            Turfs[r][tColor] = 0xFFFFFFAA;

        Turfs[r][tUsed] = 1;
        Turfs[r][tGangZone] = GangZoneCreate(minx, miny, maxx, maxy);
        if(Turfs[r][tGangZone] >= 0)
        {
            GangZoneShowForAll(Turfs[r][tGangZone], Turfs[r][tColor]);
            printf("[TURF] Zone #%d '%s' charg�e (color=0x%08x, type=%d)", r, tname, Turfs[r][tColor], ttype);
        }
        else
        {
            printf("[TURF] ERREUR : GangZoneCreate echec pour zone #%d '%s'", r, tname);
        }
        turf_LoadedCount++;
    }
    printf("[TURF] === %d territoires charg�s depuis BDD ===", turf_LoadedCount);
    return 1;
}

stock turf_LoadAll()
{
    for(new i = 0; i < MAX_TURFS; i++)
    {
        Turfs[i][tUsed] = 0;
        Turfs[i][tGangZone] = -1;
    }
    // [AUTO-FIX] S'assurer que la table existe ET que les colonnes optionnelles existent
    // Les ALTER TABLE renvoient une erreur si la colonne existe deja, mais ne crashent pas
    mysql_tquery(MYSQL, "CREATE TABLE IF NOT EXISTS lvrp_turfs (id INT AUTO_INCREMENT PRIMARY KEY, Name VARCHAR(64) DEFAULT '', MinX FLOAT DEFAULT 0, MinY FLOAT DEFAULT 0, MaxX FLOAT DEFAULT 0, MaxY FLOAT DEFAULT 0, Color INT UNSIGNED DEFAULT 4294967210, Owner VARCHAR(64) DEFAULT 'Aucun', ZoneType TINYINT DEFAULT 0, LastCapture INT UNSIGNED DEFAULT 0)", "", "");
    // SELECT * pour ne plus crasher si une colonne specifique manque
    mysql_tquery(MYSQL, "SELECT * FROM lvrp_turfs LIMIT 50", "turf_LoadCallback", "");
    return 1;
}

stock turf_FindFreeSlot()
{
    for(new i = 0; i < MAX_TURFS; i++)
        if(Turfs[i][tUsed] == 0) return i;
    return -1;
}

stock turf_Create(name[], Float:minx, Float:miny, Float:maxx, Float:maxy, color, turfOwner[], type=0)
{
    new slot = turf_FindFreeSlot();
    if(slot == -1) return -1;

    // [ANTI-SUPERPOSITION] Verifier qu'aucune zone existante ne chevauche
    new overlapWith = turf_WouldOverlap(minx, miny, maxx, maxy);
    if(overlapWith != -1) return -2;  // Code special : chevauchement detecte

    // [COULEUR] Territoire neutre = blanc, sinon garder la couleur passee
    // S'assurer que l'alpha est suffisant (minimum 0x80 = 50%)
    new finalColor = color;
    if(!strcmp(turfOwner, "Aucun", true) || !strlen(turfOwner))
        finalColor = 0xFFFFFFAA;  // blanc pour territoire neutre
    else if((finalColor & 0xFF) < 0x60)
        finalColor = (finalColor & 0xFFFFFF00) | 0xAA;  // force alpha minimum

    Turfs[slot][tUsed] = 1;
    format(Turfs[slot][tName], 64, "%s", name);
    Turfs[slot][tMinX] = minx;
    Turfs[slot][tMinY] = miny;
    Turfs[slot][tMaxX] = maxx;
    Turfs[slot][tMaxY] = maxy;
    Turfs[slot][tColor] = finalColor;
    format(Turfs[slot][tOwner], 64, "%s", turfOwner);
    Turfs[slot][tType] = type;
    Turfs[slot][tLastCapture] = 0;

    Turfs[slot][tGangZone] = GangZoneCreate(minx, miny, maxx, maxy);
    if(Turfs[slot][tGangZone] >= 0)
        GangZoneShowForAll(Turfs[slot][tGangZone], finalColor);

    new turfSql[600], sqlname[128], sqlowner[128];
    mysql_escape_string(name, sqlname);
    mysql_escape_string(turfOwner, sqlowner);
    format(turfSql, sizeof(turfSql),
        "INSERT INTO lvrp_turfs (Name, MinX, MinY, MaxX, MaxY, Color, Owner, ZoneType, LastCapture) VALUES ('%s', %f, %f, %f, %f, %d, '%s', %d, 0)",
        sqlname, minx, miny, maxx, maxy, finalColor, sqlowner, type);
    mysql_tquery(MYSQL, turfSql, "", "");
    turf_LoadedCount++;
    return slot;
}

stock turf_Delete(slot)
{
    if(slot < 0 || slot >= MAX_TURFS) return 0;
    if(Turfs[slot][tUsed] != 1) return 0;

    if(Turfs[slot][tGangZone] >= 0)
    {
        GangZoneHideForAll(Turfs[slot][tGangZone]);
        GangZoneDestroy(Turfs[slot][tGangZone]);
        Turfs[slot][tGangZone] = -1;
    }

    new turfSql[128];
    format(turfSql, sizeof(turfSql), "DELETE FROM lvrp_turfs WHERE id=%d LIMIT 1", Turfs[slot][tSQLID]);
    mysql_tquery(MYSQL, turfSql, "", "");

    Turfs[slot][tUsed] = 0;
    Turfs[slot][tName][0] = '\0';
    Turfs[slot][tOwner][0] = '\0';
    turf_LoadedCount--;
    return 1;
}

stock turf_ShowAllForPlayer(playerid)
{
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    for(new i = 0; i < MAX_TURFS; i++)
    {
        if(Turfs[i][tUsed] != 1) continue;
        if(Turfs[i][tGangZone] < 0 || Turfs[i][tGangZone] > 1024) continue; // [SAFETY] gangzone ID invalide
        GangZoneShowForPlayer(playerid, Turfs[i][tGangZone], Turfs[i][tColor]);
    }
    return 1;
}

// [TURF] Cherche une zone qui contient le point (x, y). Retourne l'index ou -1.
stock turf_FindAt(Float:x, Float:y)
{
    for(new i = 0; i < MAX_TURFS; i++)
    {
        if(Turfs[i][tUsed] != 1) continue;
        if(x >= Turfs[i][tMinX] && x <= Turfs[i][tMaxX] &&
           y >= Turfs[i][tMinY] && y <= Turfs[i][tMaxY])
            return i;
    }
    return -1;
}

// [TURF] Verifie si une nouvelle zone chevaucherait une zone existante
stock turf_WouldOverlap(Float:minx, Float:miny, Float:maxx, Float:maxy)
{
    for(new i = 0; i < MAX_TURFS; i++)
    {
        if(Turfs[i][tUsed] != 1) continue;
        // Test de chevauchement de rectangles (AABB)
        if(maxx >= Turfs[i][tMinX] && minx <= Turfs[i][tMaxX] &&
           maxy >= Turfs[i][tMinY] && miny <= Turfs[i][tMaxY])
            return i;  // chevauche zone i
    }
    return -1;
}

// [TURF] Tick toutes les 2 secondes - detecte entr�e/sortie de zone par joueur
public Turf_Tick()
{
    new Float:px, Float:py, Float:pz;
    for(new p = 0; p < MAX_PLAYERS; p++)
    {
        if(!IsPlayerConnected(p) || IsPlayerNPC(p)) continue;
        if(gPlayerLogged[p] != 1) continue;

        GetPlayerPos(p, px, py, pz);
        new currentTurf = turf_FindAt(px, py);
        new previousTurf = player_CurrentTurf[p];

        if(currentTurf != previousTurf)
        {
            // Sortie de l'ancienne zone
            if(previousTurf != -1 && previousTurf < MAX_TURFS && Turfs[previousTurf][tUsed] == 1)
            {
                new exitmsg[140];
                format(exitmsg, sizeof(exitmsg), "{888888}\xbb Zone \xab Vous quittez : %s", Turfs[previousTurf][tName]);
                msg_Client(p, 0x888888FF, exitmsg);
            }
            // Entr�e dans la nouvelle zone
            if(currentTurf != -1)
            {
                new enterclr, enterlabel[64], entermsg[180];
                switch(Turfs[currentTurf][tType])
                {
                    case 1: { enterclr = 0x00FF00FF; format(enterlabel, sizeof(enterlabel), "Zone Police/Administration"); }
                    case 2: { enterclr = 0xFF1493FF; format(enterlabel, sizeof(enterlabel), "Zone Hopital"); }
                    default: { enterclr = Turfs[currentTurf][tColor] | 0xFF; format(enterlabel, sizeof(enterlabel), "Territoire %s", Turfs[currentTurf][tOwner]); }
                }
                format(entermsg, sizeof(entermsg), "\xbb %s \xab Vous entrez dans : {FFFFFF}%s", enterlabel, Turfs[currentTurf][tName]);
                msg_Client(p, enterclr, entermsg);
            }
            player_CurrentTurf[p] = currentTurf;
        }
    }
    return 1;
}

// [TURF CAPTURE] Tick de capture toutes les 2 secondes
// - 5 minutes (150 ticks) de presence d'un membre d'un autre gang dans une zone = capture
// - Si un defenseur (membre du gang propri�taire) est present, la capture stoppe
// - Cooldown 48h apres une capture reussie pour la meme zone
public Turf_CaptureTick()
{
    new Float:px, Float:py, Float:pz;
    new now = gettime();

    for(new ti = 0; ti < MAX_TURFS; ti++)
    {
        if(Turfs[ti][tUsed] != 1) continue;
        if(Turfs[ti][tType] != 0) continue;  // Seulement les territoires de gang capturables
        if(Turfs[ti][tGangZone] < 0) continue;

        // Cooldown actif ? Si oui, pas de capture possible
        // [GANGWAR] Cooldown dynamique : 1h si bataille active, sinon 48h
        new currentCooldown = (gangWar_Active == 1) ? GANGWAR_COOLDOWN : TURF_CAPTURE_COOLDOWN;
        new isOnCooldown = ((now - Turfs[ti][tLastCapture]) < currentCooldown) ? 1 : 0;
        // [GANGWAR] Vitesse de capture dynamique : 2min si bataille active, sinon 5min
        new currentTicks = (gangWar_Active == 1) ? GANGWAR_CAPTURE_TICKS : TURF_CAPTURE_TICKS;

        // Compter defenseurs et attaquants dans la zone
        new defenders = 0, attackers = 0;
        new attackerFacID = -1;
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(!IsPlayerConnected(p) || IsPlayerNPC(p)) continue;
            if(gPlayerLogged[p] != 1) continue;
            new pMem = PlayerInfo[p][pMember];
            // [FIX CAPTURE TURF] pMember des gangs/mafias vaut facID+200 (voir afrp_gangtag.inc),
            // PAS l'index brut. L'ancien code comparait pMem (>=200) a MAX_FACTION (20) : cette
            // condition etait TOUJOURS vraie pour un vrai membre de gang, donc AUCUN joueur
            // n'etait jamais compte comme attaquant/defenseur et la capture ne progressait jamais.
            if(pMem < 200) continue;  // Pas dans un gang/mafia
            new facIdx = pMem - 200;
            if(facIdx < 0 || facIdx >= MAX_FACTION) continue;
            if(FactionInfo[facIdx][fCreate] != 1) continue;
            // Doit �tre dans cette zone
            GetPlayerPos(p, px, py, pz);
            if(!(px >= Turfs[ti][tMinX] && px <= Turfs[ti][tMaxX] &&
                 py >= Turfs[ti][tMinY] && py <= Turfs[ti][tMaxY])) continue;
            // Skip morts/coma
            if(medic_PlayerNeedMedic[p] == 2) continue;

            // Comparer le nom de sa faction au tOwner du turf
            if(strcmp(FactionInfo[facIdx][fName], Turfs[ti][tOwner], true) == 0)
                defenders++;
            else
            {
                attackers++;
                attackerFacID = facIdx;
            }
        }

        // Logique de progression
        if(attackers > 0 && defenders == 0 && !isOnCooldown)
        {
            // La capture progresse
            if(turf_CaptureFacID[ti] == -1)
            {
                // D�but de capture - annonce
                turf_CaptureFacID[ti] = attackerFacID;
                turf_CapturePoints[ti] = 0;
                GangZoneFlashForAll(Turfs[ti][tGangZone], 0xFFFFFFFF);
                new annmsg[200];
                format(annmsg, sizeof(annmsg), "{FF0000}[CAPTURE]{FFFFFF} %s tente de capturer le territoire %s (propri�taire: %s) !",
                    FactionInfo[attackerFacID][fName], Turfs[ti][tName], Turfs[ti][tOwner]);
                SendClientMessageToAll(0xFF4444FF, annmsg);
            }
            else if(turf_CaptureFacID[ti] != attackerFacID)
            {
                // Une autre faction arrive - reset pour eviter conflit
                continue;
            }
            turf_CapturePoints[ti]++;

            // Notification de progression (tous les 30 ticks = 1 min)
            if(turf_CapturePoints[ti] % 30 == 0)
            {
                new progMsg[180], pctDone = (turf_CapturePoints[ti] * 100) / currentTicks;
                format(progMsg, sizeof(progMsg), "{FFA500}[CAPTURE]{FFFFFF} %s : capture a %d%% (%d/%d sec)",
                    Turfs[ti][tName], pctDone, turf_CapturePoints[ti] * 2, currentTicks * 2);
                SendClientMessageToAll(0xFFA500FF, progMsg);
            }

            // Capture complete ?
            if(turf_CapturePoints[ti] >= currentTicks)
            {
                // Transfert d'ownership
                new oldOwner[64];
                format(oldOwner, sizeof(oldOwner), "%s", Turfs[ti][tOwner]);
                format(Turfs[ti][tOwner], 64, "%s", FactionInfo[attackerFacID][fName]);
                Turfs[ti][tColor] = FactionInfo[attackerFacID][fColor];
                if(Turfs[ti][tColor] == 0) Turfs[ti][tColor] = 0x808080A0;  // gris par defaut
                Turfs[ti][tLastCapture] = now;
                turf_CapturePoints[ti] = 0;
                turf_CaptureFacID[ti] = -1;

                // Update visuel
                GangZoneStopFlashForAll(Turfs[ti][tGangZone]);
                GangZoneHideForAll(Turfs[ti][tGangZone]);
                GangZoneShowForAll(Turfs[ti][tGangZone], Turfs[ti][tColor]);

                // Update BDD
                new capSql[400], escOwner[128];
                mysql_escape_string(Turfs[ti][tOwner], escOwner);
                format(capSql, sizeof(capSql),
                    "UPDATE lvrp_turfs SET Owner='%s', Color=%d, LastCapture=%d WHERE id=%d",
                    escOwner, Turfs[ti][tColor], now, Turfs[ti][tSQLID]);
                mysql_tquery(MYSQL, capSql, "", "");

                // [GANGWAR] Si mode bataille actif : r�compense au gang vainqueur
                new winMsg[260];
                if(gangWar_Active == 1)
                {
                    FactionInfo[attackerFacID][fCash] += GANGWAR_REWARD;
                    format(winMsg, sizeof(winMsg),
                        "{00FF00}[GANGWAR]{FFFFFF} %s a CAPTURE %s (ex: %s) ! R�compense: {FFFF00}$%d{FFFFFF} au coffre. Cooldown 1h.",
                        Turfs[ti][tOwner], Turfs[ti][tName], oldOwner, GANGWAR_REWARD);
                }
                else
                {
                    format(winMsg, sizeof(winMsg),
                        "{00FF00}[CAPTURE]{FFFFFF} %s a CAPTURE le territoire %s (ancien propri�taire: %s) ! Cooldown 48h.",
                        Turfs[ti][tOwner], Turfs[ti][tName], oldOwner);
                }
                SendClientMessageToAll(0x00FF00FF, winMsg);
            }
        }
        else if(defenders > 0 && turf_CaptureFacID[ti] != -1)
        {
            // Defenseurs presents : reset rapide
            turf_CapturePoints[ti] -= 3;
            if(turf_CapturePoints[ti] <= 0)
            {
                turf_CapturePoints[ti] = 0;
                turf_CaptureFacID[ti] = -1;
                GangZoneStopFlashForAll(Turfs[ti][tGangZone]);
                new defMsg[180];
                format(defMsg, sizeof(defMsg),
                    "{0080FF}[DEFENSE]{FFFFFF} Le territoire %s a �t� defendu avec succes par %s !",
                    Turfs[ti][tName], Turfs[ti][tOwner]);
                SendClientMessageToAll(0x0080FFFF, defMsg);
            }
        }
        else if(attackers == 0 && turf_CaptureFacID[ti] != -1)
        {
            // Plus d'attaquants : reset lent
            turf_CapturePoints[ti] -= 1;
            if(turf_CapturePoints[ti] <= 0)
            {
                turf_CapturePoints[ti] = 0;
                turf_CaptureFacID[ti] = -1;
                GangZoneStopFlashForAll(Turfs[ti][tGangZone]);
            }
        }
    }
    return 1;
}

