					if (car_SafeStatut[mycar]==false)
						{return msg_Client(playerid, COLOR_WHITE, "{8BE2E2} Vhicule {FFFFFF} Impossible, le coffre est ferm de l'extrieur.");}

					server_SetPlayerVirtualWorld(playerid,0);
