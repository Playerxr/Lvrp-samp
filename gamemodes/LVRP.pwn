stock job_ShowTexts(playerid)
{
    TextDrawShowForPlayer(playerid,job_TextBox[0]);
    TextDrawShowForPlayer(playerid,job_TextBox[1]);
    TextDrawShowForPlayer(playerid,job_TextBar[0]);
    TextDrawShowForPlayer(playerid,job_TextBar[1]);
	PlayerTextDrawShow(playerid,job_TextInfos[playerid]);
	PlayerTextDrawShow(playerid,job_TextBarUpdate[playerid]);
	TextDrawShowForPlayer(playerid,job_TextTitle);
	job_UpdateTexts(playerid);
	return 1;
}
















//==================================[HEURE & DATES]==========================


stock GetClosestPlayer(p1)
{
	new x,Float:dis,Float:dis2,p;
	p = -1;
	dis = 99999.99;
	for (x=0;x<MAX_PLAYERS_CURRENT+1;x++)
	{
		if(IsPlayerConnected(x))
		{
			if(x != p1)
			{
				dis2 = GetDistanceBetweenPlayers(x,p1);
				if(dis2 < dis && dis2 != -1.00)
				{
					dis = dis2;
					p = x;
				}
			}
		}
	}
	return p;
}





public OnPlayerUpdate(playerid)
{
    // [TOP DU JOUR] horodate le dernier paquet du client : un joueur en pause
    // ou alt-tab n'appelle plus OnPlayerUpdate et cesse donc de marquer.
    TopJour_OnUpdate(playerid);
    new string[128];
    if(afk_time[playerid] > 10)
		{afk_time[playerid]=0;}
	else if(afk_time[playerid] > 0)
	    {afk_time[playerid]=0;}

    // [SAFEZONE] Force le retour aux poings si arme en zone verte/rose
    if(gPlayerLogged[playerid] == 1)
        SafeZone_OnUpdate(playerid);

    // RESTRICTIONS MENOTTES : empeche le joueur menotte de courir, sauter, conduire
    if(player_Cuffed[playerid] == 1 && gPlayerLogged[playerid] == 1)
    {
        new state_cuff = GetPlayerState(playerid);
        // Si en voiture conducteur : ejecte (un menotte ne peut PAS conduire)
        if(state_cuff == PLAYER_STATE_DRIVER)
        {
            new vid = GetPlayerVehicleID(playerid);
            if(vid != 0)
            {
                RemovePlayerFromVehicle(playerid);
                msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Vous etes menotte, vous ne pouvez pas conduire.");
            }
        }
        // A pied : FIX glissement - on utilise UNIQUEMENT SetPlayerSpecialAction(CUFFED)
        // ApplyAnimation en boucle dans OnPlayerUpdate desynchronise le mouvement pour les autres joueurs
        // -> ils voient le joueur glisser au lieu de marcher
        else if(state_cuff == PLAYER_STATE_ONFOOT)
        {
            // SetPlayerSpecialAction suffit : gere nativement la sync SA-MP
            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
        }
    }
    // Si force a rester dans le vehicule de police (player_ForcedInVehicle)
    if(player_ForcedInVehicle[playerid] != -1 && gPlayerLogged[playerid] == 1)
    {
        new state_force = GetPlayerState(playerid);
        if(state_force == PLAYER_STATE_ONFOOT)
        {
            // Le joueur a reussi a sortir : on le remet dans le vehicule
            new vid_force = player_ForcedInVehicle[playerid];
            if(vid_force >= 0 && vid_force < MAX_CAR && vehicle[vid_force][used] == 1)
            {
                PutPlayerInVehicle(playerid, vid_force, 2); // siege passager arri�re
                msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Vous ne pouvez pas descendre, vous etes en garde.");
            }
            else
            {
                // Vehicule cible n'existe plus, on lib�r�
                player_ForcedInVehicle[playerid] = -1;
            }
        }
    }
    
    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && gPlayerLogged[playerid] == 1) // Laser
	{
	    if(GetPlayerWeapon(playerid) != 0)
	    {
			new weaponid, ammo;
		    for (new c=0; c<13; c++)
			{
		 		GetPlayerWeaponData(playerid, c, weaponid, ammo);
				if (ammo > 500)
					{SafeSetPlayerAmmo(playerid,c,500);}
			}
			if(laser_Statue[playerid]==1)
			{
			    RemovePlayerAttachedObject(playerid,laser_Object[playerid]);
			    switch (GetPlayerWeapon(playerid))
				{
	            	case 23:
					{
	                	if (IsPlayerAiming(playerid))
						{
	                    	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.108249, 0.030232, 0.118051, 1.468254, 350.512573, 364.284240);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6, 0.108249, 0.030232, 0.118051, 1.468254, 349.862579, 364.784240);}
	     				}
						else
						{
	                    	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6, 0.078248, 0.027239, 0.113051, -11.131746, 350.602722, 362.384216);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.078248, 0.027239, 0.113051, -11.131746, 350.602722, 362.384216);}
						}
					}
	                case 30:
					{
	                 	if (IsPlayerAiming(playerid))
				 		{
	                    	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6, 0.628249, -0.027766, 0.078052, -6.621746, 352.552642, 355.084289);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.628249, -0.027766, 0.078052, -1.621746, 356.202667, 355.084289);}
	 					}
						else
						{
	                    	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.663249, -0.02976, 0.080051, -11.131746, 358.302734, 353.384216);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.663249, -0.02976, 0.080051, -11.131746, 358.302734, 353.384216);}
						}
					}
	                case 31:
					{
	                	if (IsPlayerAiming(playerid))
						{
	                    	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.528249, -0.020266, 0.068052, -6.621746, 352.552642, 355.084289);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.528249, -0.020266, 0.068052, -1.621746, 356.202667, 355.084289);}
	                    }
						else
						{
	                    	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.503249, -0.02376, 0.065051, -11.131746, 357.302734, 354.484222);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.503249, -0.02376, 0.065051, -11.131746, 357.302734, 354.484222);}
						}
					}
					case 34:
					{
						if (IsPlayerAiming(playerid))
						{
							/*if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK) {
								SetPlayerAttachedObject(playerid, 0, GetPVarInt(playerid, "color"), 6, // Sniper standing aiming
								0.528249, -0.020266, 0.068052, -6.621746, 352.552642, 355.084289);
							} else {
								SetPlayerAttachedObject(playerid, 0, GetPVarInt(playerid, "color"), 6, // Sniper crouched aiming
								0.528249, -0.020266, 0.068052, -1.621746, 356.202667, 355.084289);
							}*/
							return 1;
						}
						else
						{
							if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.658248, -0.03276, 0.133051, -11.631746, 355.302673, 353.584259);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.658248, -0.03276, 0.133051, -11.631746, 355.302673, 353.584259);}
						}
					}
		            case 29:
					{
		            	if (IsPlayerAiming(playerid))
						{
		                	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.298249, -0.02776, 0.158052, -11.631746, 359.302673, 357.584259);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.298249, -0.02776, 0.158052, 8.368253, 358.302673, 352.584259);}
		                }
						else
						{
		                   	if (GetPlayerSpecialAction(playerid) != SPECIAL_ACTION_DUCK)
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.293249, -0.027759, 0.195051, -12.131746, 354.302734, 352.484222);}
							else
								{SetPlayerAttachedObject(playerid, laser_Object[playerid], laser_Colour[playerid], 6,0.293249, -0.027759, 0.195051, -12.131746, 354.302734, 352.484222);}
						}
					}
				}
			}
		}
		else
		{
		    if(laser_Statue[playerid]==1)
				{RemovePlayerAttachedObject(playerid,laser_Object[playerid]);}
		}
	}
    else if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && gPlayerLogged[playerid] == 1) // Speedometre
	{
    	new VehiculeID = GetPlayerVehicleID(playerid);
		new speed[32], Float:Healt;
		GetVehicleHealth(VehiculeID,Healt);
 		if(GetVehicleSpeed(VehiculeID) > MAX_SPEED && PlayerInfo[playerid][pAdmin] < 1)
		{
			if(!IsAPlane(VehiculeID) && !IsAHelicopter(VehiculeID) && !IsATrain(VehiculeID))
			{
				anticheat_Warn[playerid][4] ++;
			// if(anticheat_Warn[playerid][4] == 6)
				{OnPlayerCheat(playerid,1);}
			}
		}
		if(GetVehicleSpeed(VehiculeID) > vehicle[VehiculeID][cBrid] && vehicle[VehiculeID][cBrid] != 0)
		{
			if(!IsABike(VehiculeID))
			{
			    new Float:speed_x[MAX_PLAYERS],Float:speed_y[MAX_PLAYERS],Float:speed_z[MAX_PLAYERS];
			    GetVehicleVelocity(VehiculeID,speed_x[playerid],speed_y[playerid],speed_z[playerid]);
				SetVehicleVelocity(VehiculeID,speed_x[playerid]/1.020,speed_y[playerid]/1.020,speed_z[playerid]/1.020);
			}
		}
		if(IsABike(VehiculeID))
		{
		    if(GetVehicleSpeed(VehiculeID) > BIKE_SPEED)
			{
		    	new Float:speed_x[MAX_PLAYERS],Float:speed_y[MAX_PLAYERS],Float:speed_z[MAX_PLAYERS];
			    GetVehicleVelocity(VehiculeID,speed_x[playerid],speed_y[playerid],speed_z[playerid]);
				SetVehicleVelocity(VehiculeID,speed_x[playerid]/1.020,speed_y[playerid]/1.020,speed_z[playerid]/1.020);
			}
		}
		if(GetVehicleSpeed(VehiculeID) <= SPEED_NORMAL)
			{format(speed,sizeof(speed),"~g~%d",GetVehicleSpeed(VehiculeID));}
        else if(GetVehicleSpeed(VehiculeID) <= SPEED_CAMPAIGN)
			{format(speed,sizeof(speed),"~y~%d",GetVehicleSpeed(VehiculeID));}
		else if(GetVehicleSpeed(VehiculeID) <= SPEED_HIGHT)
			{format(speed,sizeof(speed),"~r~%d",GetVehicleSpeed(VehiculeID));}
		else
			{format(speed,sizeof(speed),"~p~%d",GetVehicleSpeed(VehiculeID));}
        	
		format(string,sizeof(string),"Vitesse : %s" , speed);
		PlayerTextDrawSetString(playerid,speedo_Speed[playerid], string);
		format(string,sizeof(string),"Moteur : %0.0f" , Healt);
		PlayerTextDrawSetString(playerid,speedo_Health[playerid], string);
		format(string,sizeof(string),"~b~%s" , vehName[GetVehicleModel(VehiculeID)-400]);
		PlayerTextDrawSetString(playerid,speedo_BoxSpeed[playerid], string);
		
		if (Healt <= 400 && !IsABoat(VehiculeID) && !IsABike(VehiculeID) && !IsAPlane(VehiculeID))
  		{
  		    if(vehicle[VehiculeID][cEngine] == true)
        	{
        	    new enginem, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(VehiculeID,enginem, lights, alarm, doors, bonnet, boot, objective);
                SetVehicleParamsEx(VehiculeID, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
                msg_Client(playerid, COLOR_WHITE, " Vhicule  Votre vhicule est HS, appeler un mcanicien pour qu'il le rpare.");
                vehicle[VehiculeID][cEngine] = false;
                speedometer_Update(playerid,1,0);
                format(string, sizeof(string), "* Le moteur du vhicule de %s est HS.", PlayerInfo[playerid][pName]);
				ProxDetector(30.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,true);
        	}
  		}
	}
	return 1;
}


public speedometer_Blinking(playerid,type)
{
    if(speedoInterval[playerid]==0)
        {speedoInterval[playerid]=1;}
	else
	    {speedoInterval[playerid]=0;}
	    
	if(type==1)
		{speedometer_Update(playerid,5,speedoInterval[playerid]);}
    else if(type==2)
		{speedometer_Update(playerid,6,speedoInterval[playerid]);}
	return 1;
}



stock accessory_Save(playerid,index)
{
    MySQLCheckConnexion();
	format(sql,sizeof(sql),"UPDATE lvrp_users_accessories SET Model=%d, Bone=%d, Pos_x=%f, Pos_y=%f, Pos_z=%f, Rot_x=%f, Rot_y=%f, Rot_z=%f, Off_x=%f, Off_y=%f, Off_z=%f WHERE SQLid=%d AND IndexZ=%d",
	accessory[playerid][model][index],accessory[playerid][bone][index],accessory[playerid][pos_x][index],accessory[playerid][pos_y][index],accessory[playerid][pos_z][index],
	accessory[playerid][pos_rx][index],accessory[playerid][pos_ry][index],accessory[playerid][pos_rz][index],accessory[playerid][pos_ox][index],accessory[playerid][pos_oy][index],accessory[playerid][pos_oz][index],PlayerInfo[playerid][pSQLID],index);
	mysql_pquery(MYSQL,sql);
	return 1;
}


// [FIX] Callback async de inventory_Load
public inventory_LoadCB(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
	new alterne = 0, idx=0, idx2=0;
	for(new i=1; i<=110; i++)
	{
	    if(alterne == 0)
     	{
		 	cache_get_value_index_int(0,i, PlayerInfo[playerid][pInvModel][idx]);
			alterne=1;
			if(PlayerInfo[playerid][pInvModel][idx] == 0)
			    {PlayerInfo[playerid][pInvModel][idx]=-1;}
            idx++;
 		}
		else
			{cache_get_value_index_int(0,i, PlayerInfo[playerid][pInvQuant][idx2]); alterne=0; idx2++;}
	}
	return 1;
}


stock inventory_GetItemQuantityIn(playerid,modelmin,modelmax)
{
    /*if(!server_IsValidItem(modelmin))
	    {return 1;}*/
    for(new i=0; i<gPlayerInventory[playerid]; i++)
	{
	    if(PlayerInfo[playerid][pInvModel][i] >= modelmin && PlayerInfo[playerid][pInvModel][i] <= modelmax)
	        {return PlayerInfo[playerid][pInvQuant][i];}
	}
	return 0;
}


stock inventory_ResetItemQuant(playerid,modelid,quant)
{
	new bool:found=false;
	if(!server_IsValidItem(modelid))
	    {return 1;}
	for(new i=0; i<gPlayerInventory[playerid]; i++)
	{
	    if(PlayerInfo[playerid][pInvModel][i] == modelid)
		{
			PlayerInfo[playerid][pInvQuant][i]=quant; found=true;
			if(PlayerInfo[playerid][pInvQuant][i]<=0)
			    {PlayerInfo[playerid][pInvQuant][i]=0;PlayerInfo[playerid][pInvModel][i]=-1;}
			break;
		}
	}
	if(found==false)
	{
	    for(new i=0; i<gPlayerInventory[playerid]; i++)
		{
			if(PlayerInfo[playerid][pInvModel][i]==-1)
	        	{PlayerInfo[playerid][pInvModel][i]=modelid; PlayerInfo[playerid][pInvQuant][i]=quant; break;}
	    }
	}
	return 1;
}

stock accessory_ShowDialog(playerid)
{
    new string[256]="{FFFFFF}Slot\t{FFFFFF}Statut\n",
		tmpString[48];
	for(new i=0; i<5; i++)
	{
	    if(accessory[playerid][model][i] == 0)
	        {format(tmpString,sizeof(tmpString),"%d\tLibre\n",i+1);}
		else
			{format(tmpString,sizeof(tmpString),"%d\t%s\n",i+1,GetItemName(accessory[playerid][model][i]));}
        strins(string,tmpString,strlen(string),sizeof(string));
	}
	ShowPlayerDialog(playerid,42,DIALOG_STYLE_TABLIST_HEADERS,"{04B45F} Accessoire {FFFFFF} Menu principal",string,"Valider","Annuler");
	player_Dialog[playerid]=0;
	return 1;
}








stock msg_Job(jobId, color, string[])
{
	for(new i = 0; i <MAX_PLAYERS_CURRENT+1; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(PlayerInfo[i][pJob] == jobId)
		    	{msg_Client(i, color, string);}
		}
	}
}

stock msg_Answer(playerid,const string[],giveplayerid)
{
	new tmp[358];
	for(new i = 0; i <MAX_PLAYERS_CURRENT+1; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(PlayerInfo[i][pHelper] == 1 || PlayerInfo[i][pAdmin] > 0)
		    {
		        if(NoRQ[i] == 0)
		        {
			        format(tmp,sizeof(tmp),"{410000} RQ {9B0000} %s[%d]  %s[%d] : {FFFFFF}%s",PlayerInfo[playerid][pRealName],playerid,PlayerInfo[giveplayerid][pRealName],giveplayerid,string);
					msg_Client(i, COLOR_WHITE, tmp);
				}
			}
		}
	}
}

stock msg_Helper(color, string[])
{
	for(new i = 0; i <MAX_PLAYERS_CURRENT+1; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(PlayerInfo[i][pHelper] == 1 || PlayerInfo[i][pAdmin] >= 2)
		    	{msg_Client(i, color, string);}
		}
	}
}


stock msg_County(countid,color,string[])
{
	for(new i = 0; i <MAX_PLAYERS_CURRENT+1; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(countid == 3)
		        {msg_Client(i, color, string);}
		    else if(GetCountyPlayer(i) == countid)
		        {msg_Client(i, color, string);}
		}
	}
}
//---------------------------<[ OnDialogResponse ]>-----------------------------------------
// [DEPLACE] Place avant OnPlayerCommandText pour s'assurer qu'OnDialogResponse
// est dans le .amx malgre la limite de symbole du compilateur Pawn 3.2.3664.
// Sans ce deplacement, OnDialogResponse a la ligne 47177+ �tait tronque
// silencieusement par le compilateur -> aucun dialog (login) ne repondait.
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    // [EVENTS ADMIN / TOP DU JOUR] Traites en PREMIER, et non plus a la fin de
    // cette fonction : leurs ID (9610-9620) n'entrent en conflit avec aucun
    // autre, donc les servir d'abord est sans risque et garantit qu'aucun
    // handler place avant eux ne puisse les avaler.
    if(Ev_OnDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(TopJour_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(ArmBase_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(News_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(Assu_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(Gps_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(Saison_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(MapEd_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(MapPack_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(SacV_OnDialog(playerid, dialogid, response, inputtext)) return 1;
    if(Portes_OnDialog(playerid, dialogid, response, listitem)) return 1;
    if(Residence_OnDialog(playerid, dialogid, response, listitem, inputtext)) return 1;
    if(TelApp_OnDialog(playerid, dialogid, response, listitem, inputtext)) return 1;

    // [MOBILE INLINE] Dispatch vers mobile_system pour ses dialogs (MARKET, SETTINGS)
    if(dialogid == MARKET_DIALOG || dialogid == SETTINGS_DIALOG)
        return Mobile_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);

        // === AFRP PHONE DIALOGS VOIR FONCTIONS ===

    // [AFRP PHONE] Dialog 9150 - Menu principal telephone
    if(dialogid == 9150)
    {
        if(!response) return 1;
        switch(listitem)
        {
            case 0:  // WhatsApp
                ShowPlayerDialog(playerid, 9200, DIALOG_STYLE_LIST, "{00BA00}WhatsApp AFRP",
                    "{FFFFFF}1. Discussion de group�\n{FFFFFF}2. Envoyer un message priv�\n{00FF00}3. Appel vocal\n{FFFFFF}4. Mon credit",
                    "Choisir", "Retour");
            case 1:  // Trading
                ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading",
                    "{FFFFFF}1. Voir les cours\n{00FF00}2. Acheter\n{FF0000}3. Vendre\n{FFFF00}4. Mon portefeuille",
                    "Choisir", "Retour");
            case 2:  // Gouvernement
                ShowPlayerDialog(playerid, 9300, DIALOG_STYLE_LIST, "{0066CC}Gouvernement AFRP",
                    "{FFFFFF}1. Regles du serveur\n{FFFFFF}2. Devoirs du citoyen\n{FFFF00}3. Mon casier civique\n{00FF00}4. Lois en vigueur",
                    "Voir", "Retour");
            case 3:  // Travail
                ShowPlayerDialog(playerid, 9310, DIALOG_STYLE_LIST, "{FF6600}App Travail",
                    "{FFFFFF}1. Mon job actuel\n{FFFFFF}2. Jobs disponibles\n{FFFFFF}3. Salaires\n{FFFF00}4. Mon statut",
                    "Voir", "Retour");
            case 4:  // Carte
                ShowPlayerDialog(playerid, 9360, DIALOG_STYLE_LIST, "{00BFFF}Carte AFRP",
                    "{FFFFFF}1. Territoires de gangs\n{FFFFFF}2. Zones protegees\n{FFFFFF}3. Hopitaux\n{FFFFFF}4. Magasins",
                    "Voir", "Retour");
            case 5:  // Sante
            {
                new Float:hp5, Float:armor5, sanInfo5[300];
                GetPlayerHealth(playerid, hp5);
                GetPlayerArmour(playerid, armor5);
                new etat5[30];
                if(hp5 < 30) etat5 = "{FF0000}Critique";
                else if(hp5 < 60) etat5 = "{FFAA00}Blesse";
                else etat5 = "{00FF00}En forme";
                format(sanInfo5, sizeof(sanInfo5),
                    "{FFFFFF}Vie : {00FF00}%.0f / 100\n{FFFFFF}Armure : {00FFFF}%.0f / 100\n{FFFFFF}Etat : %s\n\n{FF1493}SAMU : /call 913",
                    hp5, armor5, etat5);
                ShowPlayerDialog(playerid, 9370, DIALOG_STYLE_MSGBOX, "{FF1493}App Sante", sanInfo5, "OK", "Retour");
            }
            case 6:  // Marketplace
                ShowPlayerDialog(playerid, 9350, DIALOG_STYLE_LIST, "{32CD32}Marketplace",
                    "{FFFFFF}1. Voir les annonces\n{FFFFFF}2. Poster (50 F)\n{FFFFFF}3. Mes annonces\n{FF0000}4. Supprimer",
                    "Choisir", "Retour");
            case 7:  // M�t�o
            {
                new h7, m7, s7, jour7, mois7, annee7, infoM7[400];
                gettime(h7, m7, s7);
                getdate(annee7, mois7, jour7);
                new const conds7[5][] = {"Ensoleille", "Nuageux", "Pluie legere", "Brouillard", "Tempete"};
                new const pers7[3][] = {"Matin", "Apres-midi", "Nuit"};
                new per7 = (h7 < 12) ? 0 : ((h7 < 18) ? 1 : 2);
                new temp7 = 18 + random(15);
                format(infoM7, sizeof(infoM7),
                    "{FFFFFF}Date : {FFFF00}%02d/%02d/%d\nHeure : {FFFF00}%02d:%02d:%02d\nPeriode : {FFFF00}%s\n\n{FFFFFF}M�t�o : {00FF00}%s\nTemp : {00FF00}%d C",
                    jour7, mois7, annee7, h7, m7, s7, pers7[per7], conds7[(jour7+mois7)%5], temp7);
                ShowPlayerDialog(playerid, 9330, DIALOG_STYLE_MSGBOX, "{00BFFF}M�t�o AFRP", infoM7, "OK", "Retour");
            }
            case 8:  // Annuaire
                ShowPlayerDialog(playerid, 9320, DIALOG_STYLE_MSGBOX, "{2B6AFF}Annuaire AFRP",
                    "{FFFFFF}Police : {00FF00}911\n{FF0000}Pompiers : {00FF00}912\n{FF1493}SAMU : {00FF00}913\n{FFAA00}Taxi : {00FF00}914\n{888888}Armee : {00FF00}916\n{4B0082}Justice : {00FF00}917\n\n{FFFFFF}Tapez /call <numero>",
                    "OK", "Retour");
            case 9:  // Politique
                ShowPlayerDialog(playerid, 9340, DIALOG_STYLE_LIST, "{FFD700}Politique AFRP",
                    "{FFFFFF}1. Maire et conseil\n{FFFFFF}2. Lois en vigueur\n{FFFFFF}3. Prochaines elections\n{00FF00}4. Voter",
                    "Voir", "Retour");
            case 10: // Immobilier
            {
                new immoSql9[200];
                format(immoSql9, sizeof(immoSql9), "SELECT id, Price, Pos_x, Pos_y FROM lvrp_server_houses WHERE Owned=0 LIMIT 15");
                mysql_tquery(MYSQL, immoSql9, "Immo_ListHouses", "d", playerid);
            }
            case 11: // Parametres
                ShowPlayerDialog(playerid, PHONE_SETTINGS_DIALOG, DIALOG_STYLE_LIST, "{2B6AFF}Parametres T�l�phone",
                    "{FFFFFF}Fond - Ciel etoile\n{FFFFFF}Fond - Bicolore\n{FFFFFF}Fond - Ciel bleu\n{888888}---\n{FFFFFF}Cadre - Blanc\n{4488FF}Cadre - Bleu\n{FF4444}Cadre - Rouge\n{44FF44}Cadre - Vert",
                    "Choisir", "Retour");
        }
        return 1;
    }

    // [AFRP PHONE] Dialog 9102 - Choix modele telephone
    if(dialogid == 9102)
    {
        if(!response) return 1;
        new phonePrice = (listitem == 0) ? 500 : 5000;
        new newModel = (listitem == 0) ? 1 : 2;
        new phoneName[24];
        if(newModel == 1) phoneName = "Nokia 3310";
        else phoneName = "Samsung S22 Ultra";
        if(GetPlayerMoney(playerid) < phonePrice)
        {
            new errmsg[80];
            format(errmsg, 80, "{FF0000}Pas assez d'argent. Il faut {FFFF00}%d${FF0000}.", phonePrice);
            SendClientMessage(playerid, -1, errmsg);
            return 1;
        }
        GivePlayerMoney(playerid, -phonePrice);
        hasPhone[playerid] = 1;
        phoneModel[playerid] = newModel;
        playerNumber[playerid] = 1000 + random(8999);
        playerCredit[playerid] = 100;
        new phoneSql2[350];
        mysql_format(MYSQL, phoneSql2, sizeof(phoneSql2),
            "INSERT INTO lvrp_afrp_phone (Username, HasPhone, Number, Credit, PhoneModel) VALUES ('%e', 1, %d, 100, %d) ON DUPLICATE KEY UPDATE HasPhone=1, Number=%d, Credit=100, PhoneModel=%d",
            PlayerInfo[playerid][pRealName], playerNumber[playerid], newModel, playerNumber[playerid], newModel);
        mysql_tquery(MYSQL, phoneSql2, "", "");
        new confmsg[150];
        format(confmsg, 150, "{00FF00}>> AFRP Phone <<{FFFFFF} Achat reussi ! Vous avez un {FFFF00}%s{FFFFFF}.\nNum�ro : {FFFF00}%d{FFFFFF}. Tapez /mobile.", phoneName, playerNumber[playerid]);
        SendClientMessage(playerid, -1, confmsg);
        return 1;
    }

    // [AFRP PHONE] Dialog 9103 - Menu /market pour joueur ayant deja un telephone
    if(dialogid == 9103)
    {
        if(!response) return 1;
        switch(listitem)
        {
            case 0: // Recharger credit
            {
                ShowPlayerDialog(playerid, 9104, DIALOG_STYLE_LIST, "{2B6AFF}Recharger mon credit",
                    "{FFFFFF}50 credits  - {FFFF00}50$\n{FFFFFF}100 credits - {FFFF00}90$\n{FFFFFF}250 credits - {FFFF00}200$\n{FFFFFF}500 credits - {FFFF00}350$",
                    "Acheter", "Annuler");
            }
            case 1: // Changer de modele
            {
                new curMdl[24];
                if(phoneModel[playerid] == 2) curMdl = "Samsung S22 Ultra";
                else curMdl = "Nokia 3310";
                new chgMsg[200];
                format(chgMsg, sizeof(chgMsg),
                    "{888888}Modele actuel : %s\n\n{00BA00}Nokia 3310  - {FFFF00}500${FFFFFF}\n{4488FF}Samsung S22 Ultra  - {FFFF00}5 000${FFFFFF}\n\n{AAAAAA}Votre numero et credit sont conserves.",
                    curMdl);
                ShowPlayerDialog(playerid, 9105, DIALOG_STYLE_LIST, "{2B6AFF}Changer de modele", chgMsg, "Acheter", "Annuler");
            }
            case 2: // Voir infos
            {
                new mdl3[24], info3[200];
                if(phoneModel[playerid] == 2) mdl3 = "Samsung S22 Ultra";
                else mdl3 = "Nokia 3310";
                format(info3, sizeof(info3),
                    "{FFFFFF}T�l�phone : {FFFF00}%s{FFFFFF}\nNum�ro : {00FF00}%d{FFFFFF}\nCredit : {00FF00}%d{FFFFFF} francs\n\nTapez /mobile pour l'utiliser.",
                    mdl3, playerNumber[playerid], playerCredit[playerid]);
                ShowPlayerDialog(playerid, 9100, DIALOG_STYLE_MSGBOX, "{2B6AFF}AFRP Phone", info3, "OK", "");
            }
        }
        return 1;
    }

    // [AFRP PHONE] Dialog 9104 - Recharge de credit
    if(dialogid == 9104)
    {
        if(!response) return 1;
        new packs[4] = {50, 100, 250, 500};
        new prices[4] = {50, 90, 200, 350};
        if(listitem < 0 || listitem > 3) return 1;
        if(GetPlayerMoney(playerid) < prices[listitem])
        {
            SendClientMessage(playerid, -1, "{FF0000}Vous n'avez pas assez d'argent pour cette recharge.");
            return 1;
        }
        GivePlayerMoney(playerid, -prices[listitem]);
        playerCredit[playerid] += packs[listitem];
        new rsql[150];
        mysql_format(MYSQL, rsql, sizeof(rsql), "UPDATE lvrp_afrp_phone SET Credit=%d WHERE Username='%e'", playerCredit[playerid], PlayerInfo[playerid][pRealName]);
        mysql_tquery(MYSQL, rsql, "", "");
        new rmsg[120];
        format(rmsg, 120, "{00FF00}>> AFRP Phone <<{FFFFFF} +%d credits ajoutes ! Total : {FFFF00}%dF", packs[listitem], playerCredit[playerid]);
        SendClientMessage(playerid, -1, rmsg);
        return 1;
    }

    // [AFRP PHONE] Dialog 9105 - Changement de modele (telephone deja possede)
    if(dialogid == 9105)
    {
        if(!response) return 1;
        new newModel2 = (listitem == 0) ? 1 : 2;
        new chgPrice = (listitem == 0) ? 500 : 5000;
        new newName2[24];
        if(newModel2 == 1) newName2 = "Nokia 3310";
        else newName2 = "Samsung S22 Ultra";
        if(phoneModel[playerid] == newModel2)
        {
            SendClientMessage(playerid, -1, "{FF0000}Vous avez deja ce modele.");
            return 1;
        }
        if(GetPlayerMoney(playerid) < chgPrice)
        {
            new errmsg2[80];
            format(errmsg2, 80, "{FF0000}Pas assez d'argent. Il faut {FFFF00}%d${FF0000}.", chgPrice);
            SendClientMessage(playerid, -1, errmsg2);
            return 1;
        }
        GivePlayerMoney(playerid, -chgPrice);
        phoneModel[playerid] = newModel2;
        new chsql[150];
        mysql_format(MYSQL, chsql, sizeof(chsql), "UPDATE lvrp_afrp_phone SET PhoneModel=%d WHERE Username='%e'", newModel2, PlayerInfo[playerid][pRealName]);
        mysql_tquery(MYSQL, chsql, "", "");
        new chmsg[150];
        format(chmsg, 150, "{00FF00}>> AFRP Phone <<{FFFFFF} Vous avez maintenant un {FFFF00}%s{FFFFFF} !", newName2);
        SendClientMessage(playerid, -1, chmsg);
        return 1;
    }

    // [AFRP PHONE] Dialog 9101 - Achat de telephone (ancien, garde pour compat)
    if(dialogid == 9101)
    {
        if(!response) return 1;
        if(GetPlayerMoney(playerid) < 500)
        {
            SendClientMessage(playerid, -1, "{FF0000}>> AFRP Phone <<{FFFFFF} Pas assez d'argent (500$ requis).");
            return 1;
        }
        GivePlayerMoney(playerid, -500);
        hasPhone[playerid] = 1;
        playerNumber[playerid] = 1000 + random(8999);
        playerCredit[playerid] = 100;
        new phoneSql[300];
        mysql_format(MYSQL, phoneSql, sizeof(phoneSql),
            "INSERT INTO lvrp_afrp_phone (Username, HasPhone, Number, Credit, PhoneModel) VALUES ('%e', 1, %d, 100, 1) ON DUPLICATE KEY UPDATE HasPhone=1, Number=%d, Credit=100",
            PlayerInfo[playerid][pRealName], playerNumber[playerid], playerNumber[playerid]);
        mysql_tquery(MYSQL, phoneSql, "", "");
        new info[200];
        format(info, sizeof(info),
            "{00FF00}>> AFRP Phone <<{FFFFFF} Achat reussi !\nNum�ro : {FFFF00}%d{FFFFFF}\nCredit de depart : 100 francs.\nTapez /mobile pour utiliser votre telephone.",
            playerNumber[playerid]);
        SendClientMessage(playerid, -1, info);
        return 1;
    }

    // ============================================================
    // === AFRP PHONE - Handlers apps ===========================
    // ============================================================

    // Dialog 9200 - WhatsApp menu
    if(dialogid == 9200)
    {
        if(!response) { Phone_Show(playerid); return 1; }
        switch(listitem)
        {
            case 0: ShowPlayerDialog(playerid, 9201, DIALOG_STYLE_INPUT, "{00BA00}WhatsApp - Groupe AFRP",
                        "{FFFFFF}Ecrivez votre message :\n{888888}(visible par tous les joueurs avec un telephone)", "Envoyer", "Retour");
            case 1: ShowPlayerDialog(playerid, 9202, DIALOG_STYLE_INPUT, "{00BA00}WhatsApp - Message priv�",
                        "{FFFFFF}Entrez le {FFFF00}numero{FFFFFF} du destinataire :", "Suivant", "Retour");
            case 2: ShowPlayerDialog(playerid, 9204, DIALOG_STYLE_INPUT, "{00BA00}WhatsApp - Appel vocal",
                        "{FFFFFF}Entrez le {FFFF00}numero{FFFFFF} a appeler :", "Appeler", "Retour");
            case 3:
            {
                new cInfo[120];
                format(cInfo, 120, "{FFFFFF}Numero : {FFFF00}%d{FFFFFF}\nCredit : {00FF00}%d francs{FFFFFF}\n\nTapez {00FF00}/market{FFFFFF} pour recharger.", playerNumber[playerid], playerCredit[playerid]);
                ShowPlayerDialog(playerid, 9299, DIALOG_STYLE_MSGBOX, "{00BA00}Mon Credit", cInfo, "OK", "Retour");
            }
        }
        return 1;
    }

    // Dialog 9201 - WhatsApp: envoyer message group�
    if(dialogid == 9201)
    {
        if(!response) { ShowPlayerDialog(playerid, 9200, DIALOG_STYLE_LIST, "{00BA00}WhatsApp AFRP", "{FFFFFF}Groupe AFRP\n{FFFFFF}Message priv�\n{00FF00}Appel vocal\n{FFFFFF}Mon credit", "Choisir", "Retour"); return 1; }
        if(!strlen(inputtext)) { SendClientMessage(playerid, -1, "{FF0000}Message vide."); return 1; }
        if(waGroupDelay[playerid] > 0) { SendClientMessage(playerid, -1, "{FF4444}Anti-spam : attendez avant de renvoyer un message."); return 1; }
        new wamsg[200];
        format(wamsg, 200, "{00BA00}[WA] %s : {FFFFFF}%s", PlayerInfo[playerid][pRealName], inputtext);
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(IsPlayerConnected(p) && !IsPlayerNPC(p) && hasPhone[p] == 1)
                SendClientMessage(p, -1, wamsg);
        }
        waGroupDelay[playerid] = 1;
        SetTimerEx("Phone_ResetWADelay", 5000, 0, "i", playerid);
        pScreen[playerid] = PSCREEN_WA_HOME;
        Phone_Show(playerid);
        return 1;
    }

    // Dialog 9202 - WhatsApp: entrer numero destinataire MP
    if(dialogid == 9202)
    {
        if(!response) { ShowPlayerDialog(playerid, 9200, DIALOG_STYLE_LIST, "{00BA00}WhatsApp AFRP", "{FFFFFF}Groupe AFRP\n{FFFFFF}Message priv�\n{00FF00}Appel vocal\n{FFFFFF}Mon credit", "Choisir", "Retour"); return 1; }
        smsTarget[playerid] = strval(inputtext);
        if(smsTarget[playerid] <= 0) { SendClientMessage(playerid, -1, "{FF4444}Numero invalide."); return 1; }
        ShowPlayerDialog(playerid, 9203, DIALOG_STYLE_INPUT, "{00BA00}WhatsApp - Message priv�",
            "{FFFFFF}Ecrivez votre message :", "Envoyer", "Retour");
        return 1;
    }

    // Dialog 9203 - WhatsApp: envoyer MP
    if(dialogid == 9203)
    {
        if(!response) return 1;
        if(!strlen(inputtext)) { SendClientMessage(playerid, -1, "{FF4444}Message vide."); return 1; }
        new target_p = -1;
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(IsPlayerConnected(p) && !IsPlayerNPC(p) && playerNumber[p] == smsTarget[playerid])
                { target_p = p; break; }
        }
        if(target_p == -1) { SendClientMessage(playerid, -1, "{FF4444}Numero introuvable ou joueur hors ligne."); return 1; }
        if(hasPhone[target_p] == 0) { SendClientMessage(playerid, -1, "{FF4444}Ce joueur n'a pas de telephone."); return 1; }
        new wamp[200];
        format(wamp, 200, "{00BA00}[WA-Prive] %s (%d) : {FFFFFF}%s", PlayerInfo[playerid][pRealName], playerNumber[playerid], inputtext);
        SendClientMessage(target_p, -1, wamp);
        SendClientMessage(playerid, -1, "{00BA00}[WA] {FFFFFF}Message envoy� a {FFFF00}%d{FFFFFF}.");
        format(wamp, 200, "{00BA00}[WA] Message envoy� a %d.", smsTarget[playerid]);
        SendClientMessage(playerid, -1, wamp);
        Phone_Show(playerid);
        return 1;
    }

    // Dialog 9204 - WhatsApp: appel vocal (numero)
    if(dialogid == 9204)
    {
        if(!response) return 1;
        new callNum = strval(inputtext);
        if(callNum <= 0) { SendClientMessage(playerid, -1, "{FF4444}Numero invalide."); return 1; }
        new callCmd[32];
        format(callCmd, 32, "/call %d", callNum);
        OnPlayerCommandText(playerid, callCmd);
        return 1;
    }

    // Dialog 9299 - retour depuis credit WA
    if(dialogid == 9299)
    {
        ShowPlayerDialog(playerid, 9200, DIALOG_STYLE_LIST, "{00BA00}WhatsApp AFRP",
            "{FFFFFF}Groupe AFRP\n{FFFFFF}Message priv�\n{00FF00}Appel vocal\n{FFFFFF}Mon credit", "Choisir", "Retour");
    }

    // Dialog 9380 - App Appels: entrer numero
    if(dialogid == 9380)
    {
        if(!response) { Phone_Show(playerid); return 1; }
        new callNum2 = strval(inputtext);
        if(callNum2 <= 0) { SendClientMessage(playerid, -1, "{FF4444}Numero invalide."); return 1; }
        new callCmd2[32];
        format(callCmd2, 32, "/call %d", callNum2);
        OnPlayerCommandText(playerid, callCmd2);
        return 1;
    }

    // Dialog 9390 - App SMS: entrer numero
    if(dialogid == 9390)
    {
        if(!response) { Phone_Show(playerid); return 1; }
        smsTarget[playerid] = strval(inputtext);
        if(smsTarget[playerid] <= 0) { SendClientMessage(playerid, -1, "{FF4444}Numero invalide."); return 1; }
        ShowPlayerDialog(playerid, 9391, DIALOG_STYLE_INPUT, "{00B4D8}SMS AFRP",
            "{FFFFFF}Entrez votre message :", "Envoyer", "Annuler");
        return 1;
    }

    // Dialog 9391 - App SMS: message
    if(dialogid == 9391)
    {
        if(!response) { Phone_Show(playerid); return 1; }
        if(!strlen(inputtext)) return 1;
        new sms_target = -1;
        for(new p = 0; p < MAX_PLAYERS; p++)
        {
            if(IsPlayerConnected(p) && !IsPlayerNPC(p) && playerNumber[p] == smsTarget[playerid])
                { sms_target = p; break; }
        }
        if(sms_target == -1) { SendClientMessage(playerid, -1, "{FF4444}Numero introuvable ou joueur hors ligne."); return 1; }
        new smsmsg[200];
        format(smsmsg, 200, "{00B4D8}[SMS] %s (%d) : {FFFFFF}%s", PlayerInfo[playerid][pRealName], playerNumber[playerid], inputtext);
        SendClientMessage(sms_target, -1, smsmsg);
        SendClientMessage(playerid, -1, "{00B4D8}[SMS] {FFFFFF}Message envoy�.");
        Phone_Show(playerid);
        return 1;
    }

    // Dialog PHONE_SETTINGS_DIALOG (9399) - Themes et param�tres
    if(dialogid == PHONE_SETTINGS_DIALOG)
    {
        if(!response) { Phone_Show(playerid); return 1; }
        if(listitem <= 5)
        {
            Phone_ApplyTheme(playerid, listitem);
            new themeNames[6][] = {"Noir classique","Bleu nuit","Rouge passion","Vert nature","Violet","Or"};
            new tmsg[100];
            format(tmsg, 100, "{2B6AFF}[Phone] {FFFFFF}Theme applique : {FFFF00}%s{FFFFFF}.", themeNames[listitem]);
            SendClientMessage(playerid, -1, tmsg);
        }
        Phone_Show(playerid);
        return 1;
    }

    // Dialog 9210 - Trading : menu principal
    if(dialogid == 9210)
    {
        if(!response) { pScreen[playerid] = PSCREEN_HOME; Phone_Show(playerid); return 1; }
        switch(listitem)
        {
            case 0: // Voir les cours
            {
                new coursMsg[300];
                format(coursMsg, sizeof(coursMsg),
                    "{FFFF00}%s{FFFFFF} : %.0f F\n{FFFF00}%s{FFFFFF} : %.0f F\n{FFFF00}%s{FFFFFF} : %.0f F\n{FFFF00}%s{FFFFFF} : %.0f F\n\n{888888}Les cours fluctuent en temps reel.",
                    TRADE_NAMES[0], Trade_GetPrice(0), TRADE_NAMES[1], Trade_GetPrice(1),
                    TRADE_NAMES[2], Trade_GetPrice(2), TRADE_NAMES[3], Trade_GetPrice(3));
                ShowPlayerDialog(playerid, 9211, DIALOG_STYLE_MSGBOX, "{FFAA00}Cours en direct", coursMsg, "OK", "Retour");
            }
            case 1: // Acheter
            {
                new buyMsg[300];
                format(buyMsg, sizeof(buyMsg),
                    "{FFFFFF}%s{FFFFFF} - {00FF00}%.0f F{FFFFFF}\n{FFFFFF}%s{FFFFFF} - {00FF00}%.0f F{FFFFFF}\n{FFFFFF}%s{FFFFFF} - {00FF00}%.0f F{FFFFFF}\n{FFFFFF}%s{FFFFFF} - {00FF00}%.0f F",
                    TRADE_NAMES[0], Trade_GetPrice(0), TRADE_NAMES[1], Trade_GetPrice(1),
                    TRADE_NAMES[2], Trade_GetPrice(2), TRADE_NAMES[3], Trade_GetPrice(3));
                ShowPlayerDialog(playerid, 9212, DIALOG_STYLE_LIST, "{00FF00}Acheter un actif", buyMsg, "Choisir", "Retour");
            }
            case 2: // Vendre
            {
                if(tradeHolding[playerid][0]==0 && tradeHolding[playerid][1]==0 && tradeHolding[playerid][2]==0 && tradeHolding[playerid][3]==0)
                {
                    SendClientMessage(playerid, -1, "{FF0000}Vous ne poss�dez aucun actif a vendre.");
                    ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading",
                        "{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille",
                        "Choisir", "Fermer");
                    return 1;
                }
                new sellMsg[300];
                format(sellMsg, sizeof(sellMsg),
                    "{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} unit�s\n{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} unit�s\n{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} unit�s\n{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} unit�s",
                    TRADE_NAMES[0], tradeHolding[playerid][0], TRADE_NAMES[1], tradeHolding[playerid][1],
                    TRADE_NAMES[2], tradeHolding[playerid][2], TRADE_NAMES[3], tradeHolding[playerid][3]);
                ShowPlayerDialog(playerid, 9213, DIALOG_STYLE_LIST, "{FF0000}Vendre un actif", sellMsg, "Choisir", "Retour");
            }
            case 3: // Portefeuille
            {
                new Float:totalVal = 0.0;
                for(new ai=0; ai<4; ai++) totalVal += float(tradeHolding[playerid][ai]) * Trade_GetPrice(ai);
                new pfMsg[350];
                format(pfMsg, sizeof(pfMsg),
                    "{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} u. (~%.0f F)\n{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} u. (~%.0f F)\n{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} u. (~%.0f F)\n{FFFFFF}%s{FFFFFF} : {FFFF00}%d{FFFFFF} u. (~%.0f F)\n\n{00FF00}Valeur totale : ~%.0f F",
                    TRADE_NAMES[0], tradeHolding[playerid][0], float(tradeHolding[playerid][0])*Trade_GetPrice(0),
                    TRADE_NAMES[1], tradeHolding[playerid][1], float(tradeHolding[playerid][1])*Trade_GetPrice(1),
                    TRADE_NAMES[2], tradeHolding[playerid][2], float(tradeHolding[playerid][2])*Trade_GetPrice(2),
                    TRADE_NAMES[3], tradeHolding[playerid][3], float(tradeHolding[playerid][3])*Trade_GetPrice(3),
                    totalVal);
                ShowPlayerDialog(playerid, 9214, DIALOG_STYLE_MSGBOX, "{FFFF00}Mon portefeuille", pfMsg, "OK", "Retour");
            }
        }
        return 1;
    }

    // Dialog 9211 - retour vers le menu trading principal
    if(dialogid == 9211)
    {
        ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading",
            "{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille",
            "Choisir", "Fermer");
        return 1;
    }

    // Dialog 9212 - Choix de l'actif a acheter
    if(dialogid == 9212)
    {
        if(!response) { ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading","{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille","Choisir","Fermer"); return 1; }
        tradeSelAsset[playerid] = listitem;
        new buyInputMsg[150];
        format(buyInputMsg, sizeof(buyInputMsg), "{FFFFFF}%s\nPrix actuel : {00FF00}%.0f F{FFFFFF}\n\nCombien d'unites voulez-vous acheter ?",
            TRADE_NAMES[listitem], Trade_GetPrice(listitem));
        ShowPlayerDialog(playerid, 9215, DIALOG_STYLE_INPUT, "{00FF00}Acheter", buyInputMsg, "Acheter", "Annuler");
        return 1;
    }

    // Dialog 9213 - Choix de l'actif a vendre
    if(dialogid == 9213)
    {
        if(!response) { ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading","{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille","Choisir","Fermer"); return 1; }
        tradeSelAsset[playerid] = listitem;
        if(tradeHolding[playerid][listitem] <= 0)
        {
            SendClientMessage(playerid, -1, "{FF0000}Vous ne poss�dez pas cet actif.");
            return 1;
        }
        new sellInputMsg[150];
        format(sellInputMsg, sizeof(sellInputMsg), "{FFFFFF}%s\nVous poss�dez : {FFFF00}%d{FFFFFF} unit�s\nPrix actuel : {00FF00}%.0f F{FFFFFF}\n\nCombien voulez-vous vendre ?",
            TRADE_NAMES[listitem], tradeHolding[playerid][listitem], Trade_GetPrice(listitem));
        ShowPlayerDialog(playerid, 9216, DIALOG_STYLE_INPUT, "{FF0000}Vendre", sellInputMsg, "Vendre", "Annuler");
        return 1;
    }

    // Dialog 9214 - retour portefeuille -> menu trading
    if(dialogid == 9214)
    {
        ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading",
            "{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille",
            "Choisir", "Fermer");
        return 1;
    }

    // Dialog 9215 - Confirmation achat (input quantit�)
    if(dialogid == 9215)
    {
        if(!response) { ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading","{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille","Choisir","Fermer"); return 1; }
        new qty = strval(inputtext);
        if(qty <= 0) { SendClientMessage(playerid, -1, "{FF0000}Quantit� invalide."); return 1; }
        new ast = tradeSelAsset[playerid];
        new Float:price = Trade_GetPrice(ast);
        new cost = floatround(price * float(qty), floatround_ceil);
        if(GetPlayerMoney(playerid) < cost)
        {
            new buyErr[100];
            format(buyErr, 100, "{FF0000}Pas assez d'argent. Co�t total : {FFFF00}%d F{FF0000}.", cost);
            SendClientMessage(playerid, -1, buyErr);
            return 1;
        }
        GivePlayerMoney(playerid, -cost);
        tradeHolding[playerid][ast] += qty;
        Trade_SaveHoldings(playerid);
        new buyOk[150];
        format(buyOk, 150, "{00FF00}>> Trading <<{FFFFFF} Achet� %d %s pour {FFFF00}%d F{FFFFFF}.", qty, TRADE_NAMES[ast], cost);
        SendClientMessage(playerid, -1, buyOk);
        return 1;
    }

    // Dialog 9216 - Confirmation vente (input quantit�)
    if(dialogid == 9216)
    {
        if(!response) { ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading","{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille","Choisir","Fermer"); return 1; }
        new qty2 = strval(inputtext);
        new ast2 = tradeSelAsset[playerid];
        if(qty2 <= 0) { SendClientMessage(playerid, -1, "{FF0000}Quantit� invalide."); return 1; }
        if(qty2 > tradeHolding[playerid][ast2])
        {
            SendClientMessage(playerid, -1, "{FF0000}Vous n'avez pas autant d'unites.");
            return 1;
        }
        new Float:price2 = Trade_GetPrice(ast2);
        new revenue = floatround(price2 * float(qty2), floatround_floor);
        tradeHolding[playerid][ast2] -= qty2;
        GivePlayerMoney(playerid, revenue);
        Trade_SaveHoldings(playerid);
        new sellOk[150];
        format(sellOk, 150, "{00FF00}>> Trading <<{FFFFFF} Vendu %d %s pour {FFFF00}%d F{FFFFFF}.", qty2, TRADE_NAMES[ast2], revenue);
        SendClientMessage(playerid, -1, sellOk);
        return 1;
    }

    // [TUTO] Dispatch des dialogs 9400-9407 du tutoriel
    if(dialogid >= 9400 && dialogid <= 9407)
    {
        return Tuto_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    }

    // [EMOTES] Dispatch des dialogs 9500-9501
    if(dialogid == 9500 || dialogid == 9501)
    {
        return Emotes_OnDialogResponse(playerid, dialogid, response, listitem);
    }

    // [VENUE PRIVE] Dispatch des dialogs 9960-9963
    if(dialogid >= 9960 && dialogid <= 9963)
    {
        return Venue_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    }

    // [ENTREPRISE] Dispatch des dialogs local (9984), secteur (9986) et gestion
    // (9987-9989, 9975-9976). Les dialogs a saisie texte passent par Ent_OnDialogInput.
    if(dialogid == 9984 || dialogid == 9986 || (dialogid >= 9987 && dialogid <= 9989)
        || dialogid == 9975 || dialogid == 9976)
    {
        return Ent_OnDialogResponse(playerid, dialogid, response, listitem);
    }
    if(dialogid == 9977 || dialogid == 9978 || dialogid == 9979)
    {
        if(dialogid == 9977) return Ent_OnDialogResponse(playerid, dialogid, response, listitem);
        return Ent_OnDialogInput(playerid, dialogid, response, inputtext);
    }

    // [CARGO] Dispatch du dialog d'achat de camionnette (9985)
    if(dialogid == 9985)
    {
        return Cargo_OnDialogResponse(playerid, dialogid, response, listitem);
    }

    // [COMMERCE ENTREPRISE] Dispatch des dialogs 9965-9968
    if(dialogid >= 9965 && dialogid <= 9968)
    {
        return EC_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    }

    // [ANNUAIRE / CONTRATS] Dispatch : 9969, 9964 et 9955-9958
    if(dialogid == 9969 || dialogid == 9964 || (dialogid >= 9955 && dialogid <= 9958))
    {
        return EM_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    }

    // [JUSTICE] Dispatch des dialogs de proces 9940-9943
    if(dialogid >= 9940 && dialogid <= 9943)
    {
        return Justice_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);
    }

    // [MEUBLES DEHORS] Dispatch des dialogs 9970-9973
    if(dialogid >= 9970 && dialogid <= 9973)
    {
        return MD_OnDialogResponse(playerid, dialogid, response, listitem);
    }

    // [GANG CREATION] Dispatch du choix de QG (9944)
    if(dialogid == 9944)
    {
        return GangCreate_OnDialogResponse(playerid, dialogid, response, listitem);
    }

    // [MOBILIER CHOIX] Dialog 9974 : dehors ou maison
    if(dialogid == 9974)
    {
        if(!response) return 1;
        if(listitem == 0)
        {
            // Dans la maison : le flag calcule au moment de /ma mobilier fait foi
            // (id maison valide + interieur != 0). Voir [FIX MEUBLES DEHORS].
            if(GetPVarInt(playerid, "mobi_inHouse") != 1)
                return msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Tu dois etre dans ta maison pour le mobilier interieur.");
            ShowPlayerDialog(playerid,26,DIALOG_STYLE_LIST,"{00C600} Maison {FFFFFF} Mobilier","{FFFFFF}- Acheter un mobilier\n- Editer un mobilier (Liste)\n- Editer un mobilier (Clique)\n- Vendre un mobilier (Liste)\n- Vendre un mobilier (Clique)\n- Vendre tout le mobilier","Valider","Annuler");
            player_Dialog[playerid]=0;
            return 1;
        }
        else if(listitem == 1)
        {
            // Dehors : refuse seulement si on est PHYSIQUEMENT dans une maison
            // (interieur != 0), plus le faux positif gPlayerInHouse==0.
            if(GetPVarInt(playerid, "mobi_inHouse") == 1)
                return msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Tu es dans une maison. Choisis 'Dans la maison'.");
            return MD_ShowMenu(playerid);
        }
        return 1;
    }

    // [JOBS] Dispatch du menu metiers (9770) + promo auto 10 min (9773)
    if(dialogid == 9770 || dialogid == 9773)
    {
        return Jobs_OnDialogResponse(playerid, dialogid, response, listitem);
    }

    // [FAQ] Dispatch du guide rapide (9771 liste / 9772 reponse)
    if(dialogid == 9771 || dialogid == 9772)
    {
        return FAQ_OnDialogResponse(playerid, dialogid, response, listitem);
    }

