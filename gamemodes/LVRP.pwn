                ShowModelSelectionMenuEx(playerid, Skin, 21, "Choisissez un skin FBI", 1, 0.0, 0.0, -55.0);
                player_Dialog[playerid]=listitem+1; // Stocker quel rang on edite
            }
            if(listitem==14) // Gestion Amendes
            {
                police_FineGestion(playerid);
                return 1;
            }
            if(listitem==15) // Entre faction
            {
                new Float:x,Float:y,Float:z,Float:a;
                GetPlayerPos(playerid,x,y,z);
                GetPlayerFacingAngle(playerid,a);
                if(GetPlayerInterior(playerid)!=0)
                {
                    msg_Box(playerid, "~b~", "FBI", "Vous devez tre  l'extrieur.", 5000);
                    fbi_Gestion(playerid);
                    return 1;
                }
                FBIInfo[Entrance][0]=x;
                FBIInfo[Entrance][1]=y;
                FBIInfo[Entrance][2]=z;
                FBIInfo[Entrance][3]=a;
                fbi_Update();
                fbi_Save();
                msg_Box(playerid, "~b~", "FBI", "Entre sauvegarde.", 5000);
                fbi_Gestion(playerid);
                return 1;
            }
            if(listitem==16) // Sortie faction
            {
                new Float:x,Float:y,Float:z,Float:a;
                GetPlayerPos(playerid,x,y,z);
                GetPlayerFacingAngle(playerid,a);
                FBIInfo[Exit][0]=x;
                FBIInfo[Exit][1]=y;
                FBIInfo[Exit][2]=z;
                FBIInfo[Exit][3]=a;
                fbi_Update();
                fbi_Save();
                msg_Box(playerid, "~b~", "FBI", "Sortie sauvegarde.", 5000);
                fbi_Gestion(playerid);
                return 1;
            }
            if(listitem==17) // Spawn faction
            {
                new Float:x,Float:y,Float:z,Float:a;
                GetPlayerPos(playerid,x,y,z);
                GetPlayerFacingAngle(playerid,a);
                FBIInfo[Spawn][0]=x;
                FBIInfo[Spawn][1]=y;
                FBIInfo[Spawn][2]=z;
                FBIInfo[Spawn][3]=a;
                fbi_Save();
                msg_Box(playerid, "~b~", "FBI", "Spawn sauvegard.", 5000);
                fbi_Gestion(playerid);
                return 1;
            }
            if(listitem==18) // [Service] = duty
            {
                msg_Client(playerid,COLOR_FBI,"{8B008B} FBI {FFFFFF} Utilisez /fbi duty pour prendre votre service.");
                fbi_Gestion(playerid);
                return 1;
            }
            if(listitem==19) // [Equipement]
            {
                msg_Client(playerid,COLOR_FBI,"{8B008B} FBI {FFFFFF} Equipement donn automatiquement  la prise de service (/fbi duty).");
                fbi_Gestion(playerid);
                return 1;
            }
        }
        // Sauvegarde des noms de rang via input
        else
        {
            if(strlen(inputtext) < 1 || strlen(inputtext) > 31)
            {
                msg_Client(playerid,COLOR_FBI,"{8B008B} FBI {FFFFFF} Nom invalide (1  31 caractres).");
                fbi_Gestion(playerid);
                return 1;
            }
            switch(player_Dialog[playerid])
            {
                case 1: format(FBIInfo[rank1],32,"%s",inputtext);
                case 2: format(FBIInfo[rank2],32,"%s",inputtext);
                case 3: format(FBIInfo[rank3],32,"%s",inputtext);
                case 4: format(FBIInfo[rank4],32,"%s",inputtext);
                case 5: format(FBIInfo[rank5],32,"%s",inputtext);
                case 6: format(FBIInfo[rank6],32,"%s",inputtext);
                case 7: format(FBIInfo[rank7],32,"%s",inputtext);
            }
            fbi_Save();
            format(string,sizeof(string),"{8B008B} FBI {FFFFFF} Nom du rang %d modifi en : %s",player_Dialog[playerid],inputtext);
            msg_Client(playerid,COLOR_FBI,string);
            fbi_Gestion(playerid);
        }
        return 1;
    }
