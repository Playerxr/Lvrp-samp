    // ============================================================
		else if(strcmp(cmd, "/attente", true) == 0)
		{
			if(PlayerInfo[playerid][pAdmin] < 1)
				return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Acc�s refus�.");

			new found = 0;
			new ap_list[1024] = "{FFAA00}=== NOUVEAUX JOUEURS EN ATTENTE ===\n\n";
			for(new i = 0; i < MAX_PLAYERS; i++)
			{
				if(!IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
				if(!PlayerEnAttente[i]) continue;
				new ap_line[128];
				format(ap_line, sizeof(ap_line), "{FFFFFF}[%d] %s\n", i, PlayerInfo[i][pName]);
				strcat(ap_list, ap_line, sizeof(ap_list));
				found++;
			}
			if(found == 0)
				return msg_Client(playerid, COLOR_INFO, "{3F4373}[ATTENTE]{FFFFFF} Aucun nouveau joueur en attente d'approbation.");

			strcat(ap_list, "\n{AAAAAA}/approuver [id] pour accepter | /refuser [id] [raison] pour refuser", sizeof(ap_list));
			ShowPlayerDialog(playerid, 9902, DIALOG_STYLE_MSGBOX, "Nouveaux joueurs en attente", ap_list, "Fermer", "");
			return 1;
		}
		else if(strcmp(cmd, "/approuver", true) == 0)
		{
			if(PlayerInfo[playerid][pAdmin] < 1)
				return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Acc�s refus�.");

			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
				return msg_Client(playerid, COLOR_WHITE, "{A98500}[Usage]{FFFFFF} /approuver [id du joueur]");

			new ap_target = strval(tmp);
			if(!IsPlayerConnected(ap_target))
				return msg_Client(playerid, COLOR_RED, "{FF6347}Joueur introuvable.");
			if(!PlayerEnAttente[ap_target])
				return msg_Client(playerid, COLOR_RED, "{FF6347}Ce joueur n'est pas en attente d'approbation.");

			// === [APPROBATION] Approuver : valider et spawn direct ===
			// [FIX] L'ancien code lancait inscription_StartIntro qui finit par appeler
			// OnPlayerRegister -> MySQLCreateAccount -> sha1(pass) sur un pKey qui contient
			// deja le HASH SHA1 (charge depuis la BDD lors du login en attente).
			// Resultat: double-hash = mot de passe corrompu en BDD = login impossible.
			// On fait un spawn direct du joueur deja authentifie.
			PlayerEnAttente[ap_target] = false;
			PlayerInfo[ap_target][pActive] = 1;
			inscription_Step[ap_target] = 0;

			// Mettre a jour en DB
			new ap_query[128];
			format(ap_query, sizeof(ap_query), "UPDATE lvrp_users SET active=1 WHERE id=%d LIMIT 1", PlayerInfo[ap_target][pSQLID]);
			mysql_tquery(MYSQL, ap_query, "", "");

			// Notifier le joueur
			SendClientMessage(ap_target, 0x00FF00FF, "{9EC73D}[APPROBATION]{FFFFFF} Votre compte a �t� approuve ! Bienvenue sur AFRP !");

			// [FIX BLOQUE] Le joueur a encore le dialog "En attente de validation"
			// (9903) ouvert sur son ecran depuis la connexion. Le spawn server-side
			// ne suffit pas a debloquer le client tant que CE dialog reste affiche -
			// d'ou "reste bloque jusqu'a ce qu'il sorte et revienne" (une reconnexion
			// force un nouvel etat qui n'a pas ce dialog ouvert). On le ferme
			// explicitement (dialogid -1 = fermer le dialog actif) avant de spawner.
			ShowPlayerDialog(ap_target, -1, DIALOG_STYLE_MSGBOX, "", "", "", "");

			// Sortir du spectating si besoin et spawn le joueur (deja loge)
			server_TogglePlayerSpectating(ap_target, 0);
			server_SetPlayerVirtualWorld(ap_target, 0);
			SpawnPlayer(ap_target);
			// Garde-fou : s'assurer que les controles sont bien actifs post-spawn
			TogglePlayerControllable(ap_target, 1);

			// Log admin
			new ap_log[128];
			format(ap_log, sizeof(ap_log), "{9EC73D}[APPROUVE]{FFFFFF} %s a approuve le joueur %s.",
				PlayerInfo[playerid][pName], PlayerInfo[ap_target][pName]);
			msg_Admin(COLOR_GREEN, ap_log, 1);
			msg_Client(playerid, COLOR_GREEN, "{9EC73D}[OK]{FFFFFF} Joueur approuve et mis en jeu avec succes !");
			return 1;
		}
		else if(strcmp(cmd, "/refuser", true) == 0)
		{
			if(PlayerInfo[playerid][pAdmin] < 1)
				return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Acc�s refus�.");

			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
				return msg_Client(playerid, COLOR_WHITE, "{A98500}[Usage]{FFFFFF} /refuser [id] [raison]");

			new ap_target = strval(tmp);
			if(!IsPlayerConnected(ap_target))
				return msg_Client(playerid, COLOR_RED, "{FF6347}Joueur introuvable.");
			if(!PlayerEnAttente[ap_target])
				return msg_Client(playerid, COLOR_RED, "{FF6347}Ce joueur n'est pas en attente.");

			new ap_raison[64];
			strmid(ap_raison, cmdtext, idx, strlen(cmdtext), 64);
			if(!strlen(ap_raison)) format(ap_raison, 64, "Compte refus� par l'administration.");

			// Supprimer le compte de la DB
			new ap_query[128];
			format(ap_query, sizeof(ap_query),
				"DELETE FROM lvrp_users WHERE id=%d LIMIT 1",
				PlayerInfo[ap_target][pSQLID]);
			mysql_tquery(MYSQL, ap_query, "", "");

			// Notifier et kick
			new ap_msg[256];
			format(ap_msg, sizeof(ap_msg),
				"{FF6347}[REFUS]{FFFFFF} Votre compte a �t� refus�. Raison : %s", ap_raison);
			SendClientMessage(ap_target, 0xFF0000FF, ap_msg);
			SetTimerEx("TimerKick", 2000, 0, "i", ap_target);

			new ap_log[128];
			format(ap_log, sizeof(ap_log), "{FF6347}[REFUSE]{FFFFFF} %s a refus� le joueur %s. Raison : %s",
				PlayerInfo[playerid][pName], PlayerInfo[ap_target][pName], ap_raison);
			msg_Admin(COLOR_RED, ap_log, 1);
			msg_Client(playerid, COLOR_RED, "{FF6347}[OK]{FFFFFF} Joueur refus� et compte supprim�.");
			return 1;
		}
		else if(strcmp(cmd, "/candidatureradmin", true) == 0 || strcmp(cmd, "/candiadmin", true) == 0)
	{
		// Verif niveau joueur minimum (niveau 5+)
		if(PlayerInfo[playerid][pLevel] < 5)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Vous devez �tre niveau 5+ pour postuler comme admin.");
		if(PlayerInfo[playerid][pAdmin] > 0)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Vous etes deja admin.");
		if(PlayerHasPendingDemande[playerid])
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Vous avez deja une candidature en attente. Patientez.");

		// R�cup�rer le motif
		new ad_motif[128];
		strmid(ad_motif, cmdtext, strlen("/candidatureradmin "), strlen(cmdtext), 128);
		if(strlen(ad_motif) < 20)
			return msg_Client(playerid, COLOR_WHITE, "{A98500}[Usage]{FFFFFF} /candidatureradmin [Pourquoi voulez-vous �tre admin ? min 20 carac]");

		// Inserer en DB
		new ad_query[512];
		mysql_format(MYSQL, ad_query, sizeof(ad_query),
			"INSERT INTO lvrp_admin_demandes (SQLid, Nom, Motif, Date, Statut) VALUES ('%d', '%e', '%e', UNIX_TIMESTAMP(), 0)",
			PlayerInfo[playerid][pSQLID], PlayerInfo[playerid][pName], ad_motif);
		mysql_tquery(MYSQL, ad_query, "", "");

		// Ajouter en memoire
		if(AdminDemandesCount < MAX_ADMIN_DEMANDES)
		{
			new di = AdminDemandesCount;
			AdminDemandes[di][ad_PlayerSQLID] = PlayerInfo[playerid][pSQLID];
			strmid(AdminDemandes[di][ad_Name], PlayerInfo[playerid][pName], 0, MAX_PLAYER_NAME, MAX_PLAYER_NAME+1);
			strmid(AdminDemandes[di][ad_Motif], ad_motif, 0, 128, 128);
			AdminDemandes[di][ad_Statut] = 0;
			AdminDemandesCount++;
		}

		PlayerHasPendingDemande[playerid] = true;
		msg_Client(playerid, COLOR_GREEN, "{9EC73D}[CANDIDATURE]{FFFFFF} Votre candidature admin a �t� soumise avec succes !");
		msg_Client(playerid, COLOR_INFO, "{3F4373}[INFO]{FFFFFF} Un admin senior va examiner votre candidature. Soyez patient.");
		NotifyAdminsNewDemande(PlayerInfo[playerid][pName], ad_motif);
		return 1;
	}
		else if(strcmp(cmd, "/demandes", true) == 0)
		{
			if(PlayerInfo[playerid][pAdmin] < 5)
				return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Acc�s refus�. Admin niveau 5+ requis.");

			if(AdminDemandesCount == 0)
				return msg_Client(playerid, COLOR_INFO, "{3F4373}[DEMANDES]{FFFFFF} Aucune candidature admin en attente.");

			new ad_list[1024];
			format(ad_list, sizeof(ad_list), "{FFAA00}=== CANDIDATURES ADMIN EN ATTENTE (%d) ===\n", AdminDemandesCount);
			for(new di = 0; di < AdminDemandesCount && di < MAX_ADMIN_DEMANDES; di++)
			{
				new ad_line[256];
				format(ad_line, sizeof(ad_line), "{FFFFFF}[%d] %s - [%s]\n", di, AdminDemandes[di][ad_Name], AdminDemandes[di][ad_Motif]);

				strcat(ad_list, ad_line, sizeof(ad_list));
			}
			strcat(ad_list, "\n{AAAAAA}Utilisez /acceptadmin [num] [niveau 1-4] ou /refuseradmin [num] [raison]", sizeof(ad_list));

			ShowPlayerDialog(playerid, 9901, DIALOG_STYLE_MSGBOX, "Candidatures Admin en attente", ad_list, "Fermer", "");
