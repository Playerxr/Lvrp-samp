stock Floor_OpenDoors(floorid)
{
    MoveDynamicObject(Obj_FloorDoors[floorid][0], X_DOOR_L_OPENED, -1303.171142, GetDoorsZCoordForFloor(floorid), DOORS_SPEED);
	MoveDynamicObject(Obj_FloorDoors[floorid][1], X_DOOR_R_OPENED, -1303.171142, GetDoorsZCoordForFloor(floorid), DOORS_SPEED);
	return 1;
}

stock Elevator_OpenDoors()
{
	new Float:x, Float:y, Float:z;
	GetDynamicObjectPos(Obj_ElevatorDoors[0], x, y, z);
	MoveDynamicObject(Obj_ElevatorDoors[0], X_DOOR_L_OPENED, y, z, DOORS_SPEED);
	MoveDynamicObject(Obj_ElevatorDoors[1], X_DOOR_R_OPENED, y, z, DOORS_SPEED);
	return 1;
}




stock Inv_GetTotalWeight(playerid)
{
    new totalWeight = 0;
    new modelId, quant, cat, w, st;
    new tmpItemName[40];
    // Parcours la table SQL inventaire (cache via inventory_GetItemQuantity sur les mod�les connus)
    for(new i=0; i<sizeof(InvItemDefs); i++)
    {
        modelId = InvItemDefs[i][invModelId];
        quant = inventory_GetItemQuantity(playerid, modelId);
        if(quant <= 0) continue;
        Inv_GetItemDef(modelId, cat, w, st, tmpItemName, sizeof(tmpItemName));
        totalWeight += (w * quant);
    }
    return totalWeight;
}


stock Inv_GetCategoryName(category, buffer[], maxlen)
{
    switch(category)
    {
        case INV_CAT_FOOD:     format(buffer, maxlen, "Nourriture");
        case INV_CAT_DRINK:    format(buffer, maxlen, "Boissons");
        case INV_CAT_DRUG:     format(buffer, maxlen, "Drogues");
        case INV_CAT_TOOL:     format(buffer, maxlen, "Outils");
        case INV_CAT_MATERIAL: format(buffer, maxlen, "Mat�riaux");
        case INV_CAT_WEAPON:   format(buffer, maxlen, "Armes");
        case INV_CAT_DOCUMENT: format(buffer, maxlen, "Documents");
        default:               format(buffer, maxlen, "Autres");
    }
    return 1;
}

stock Peage_CreateBarrier(pid)
{
    if(pid < 0 || pid >= MAX_PEAGES) return 0;
    if(Peages[pid][peActive] != 1) return 0;
    // Detruire l'ancien si existant
    Peage_DestroyBarrier(pid);

    new Float:bx = Peages[pid][peX];
    new Float:by = Peages[pid][peY];
    new Float:bz = Peages[pid][peZ];
    new Float:ang = Peages[pid][peAngle];

    // Barriere boom gate (objet 968) - tourne autour de Y pour ouvrir/fermer
    Peages[pid][peBarrier] = CreateDynamicObject(968, bx, by, bz - 0.2, 0.0, 0.0, ang);

    // Cabane p�age (objet 1273 = guerite avec lumieres ou 8674 = p�age tower)
    // On la decale de 4m sur le cote
    new Float:offX = floatcos(ang + 90.0, degrees) * 4.0;
    new Float:offY = floatsin(ang + 90.0, degrees) * 4.0;
    Peages[pid][peBooth] = CreateDynamicObject(1273, bx + offX, by + offY, bz, 0.0, 0.0, ang);

    // Label 3D
    new lblTxt[160]; // [FIX] �tait [80] : trop petit pour texte fixe (76 chars) + peName (32) + prix
    format(lblTxt, sizeof(lblTxt), "{FFAA00}{=== PEAGE ===}\n{FFFFFF}%s\n{FF6347}Prix: %d$\n{00FF00}Service public gratuit", Peages[pid][peName], Peages[pid][pePrix]);
    Peages[pid][peLabel] = _:CreateDynamic3DTextLabel(lblTxt, 0xFFFFFFFF, bx, by, bz + 2.5, 20.0);

    return 1;
}


stock Parking_CreateVisuals(pid)
{
    if(parkings[pid][paUsed] != 1) return 0;
    new Float:x = parkings[pid][paX];
    new Float:y = parkings[pid][paY];
    new Float:z = parkings[pid][paZ];

    // Pickup au sol (icone P bleue)
    parking_PickupId[pid] = CreatePickup(1318, 1, x, y, z, 0);

    // Label 3D
    new labelStr[128];
    format(labelStr, sizeof(labelStr), "{42AAFF}PARKING\n{FFFFFF}%s\n{CCCCCC}/parking pour gerer", parkings[pid][paName]);
    parking_Label[pid] = Create3DTextLabel(labelStr, 0xFFFFFFFF, x, y, z+1.0, 30.0, 0, 0);

    // Icone bleue sur la map pour tous les joueurs connect�s
    for(new p=0; p<MAX_PLAYERS_CURRENT+1; p++)
    {
        if(!IsPlayerConnected(p) || IsPlayerNPC(p)) continue;
        SetPlayerMapIcon(p, 50+pid, x, y, z, 56, 0x42AAFFFF, MAPICON_GLOBAL);
        parking_MapIcon[p][pid] = 1;
    }
    return 1;
}

stock Parking_Save()
{
    if(fexist(PARKING_FILE)) fremove(PARKING_FILE);
    new File:f = fopen(PARKING_FILE, io_write);
    if(!f) return 0;
    new line[256];
    for(new i=0; i<MAX_PARKING; i++)
    {
        if(parkings[i][paUsed] != 1) continue;
        format(line, sizeof(line), "%.4f,%.4f,%.4f,%s,%d\n",
            parkings[i][paX], parkings[i][paY], parkings[i][paZ],
            parkings[i][paName], parkings[i][paCreatorSqlid]);
        fwrite(f, line);
    }
    fclose(f);
    return 1;
}

stock Parking_DestroyVisuals(pid)
{
    if(parking_PickupId[pid] != -1)
    {
        DestroyPickup(parking_PickupId[pid]);
        parking_PickupId[pid] = -1;
    }
    if(_:parking_Label[pid] != _:INVALID_3DTEXT_ID)
    {
        Delete3DTextLabel(parking_Label[pid]);
        parking_Label[pid] = Text3D:INVALID_3DTEXT_ID;
    }
    for(new p=0; p<MAX_PLAYERS_CURRENT+1; p++)
    {
        if(!IsPlayerConnected(p) || IsPlayerNPC(p)) continue;
        if(parking_MapIcon[p][pid] == 1)
        {
            RemovePlayerMapIcon(p, 50+pid);
            parking_MapIcon[p][pid] = 0;
        }
    }
    return 1;
}

stock Parking_CountPlayerVehicles(playerid)
{
    new count = 0;
    for(new i=0; i<6; i++)
    {
        if(PlayerInfo[playerid][pCar][i] != -1) count++;
    }
    return count;
}

stock Casino_BuildLabel(id)
{
    if(casino[id][caForSale] == 1)
        format(gCasinoLabelBuf, sizeof(gCasinoLabelBuf), "{FFD700}CASINO : %s\n{FF6347}A VENDRE : %d$\n{FFFFFF}Tapez /casino acheter", casino[id][caName], casino[id][caPrice]);
    else if(casino[id][caOpen] == 1)
        format(gCasinoLabelBuf, sizeof(gCasinoLabelBuf), "{FFD700}CASINO : %s\n{00FF00}OUVERT - Tentez votre chance !\n{CCCCCC}Proprio : %s\n{FFFFFF}Touche {FFFF00}F{FFFFFF} pour entrer", casino[id][caName], casino[id][caOwner]);
    else
        format(gCasinoLabelBuf, sizeof(gCasinoLabelBuf), "{FFD700}CASINO : %s\n{FF0000}FERME\n{CCCCCC}Proprio : %s", casino[id][caName], casino[id][caOwner]);
    return 1;
}

stock strtok(const string[], &index)
{
	new length = strlen(string);
	while ((index < length) && (string[index] <= ' '))
	{
		index++;
	}

	new offset = index;
	new resultt[20];
	while ((index < length) && (string[index] > ' ') && ((index - offset) < (sizeof(resultt) - 1)))
	{
		resultt[index - offset] = string[index];
		index++;
	}
	resultt[index - offset] = EOS;
	return resultt;
}

stock Casino_GetNearest(playerid)
{
    new Float:px,Float:py,Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    new best=-1; new Float:bestD=15.0;
    for(new i=0; i<MAX_CASINO; i++)
    {
        if(casino[i][caUsed]!=1) continue;
        new Float:d = floatsqroot((px-casino[i][caX])*(px-casino[i][caX])+(py-casino[i][caY])*(py-casino[i][caY]));
        if(d<bestD){bestD=d;best=i;}
    }
    return best;
}

stock Casino_PlaySlot(playerid, mise)
{
    new r1 = random(10), r2 = random(10), r3 = random(10);
    new Float:mult = 0.0;
    new resultStr[64];

    if(r1==7 && r2==7 && r3==7)
    {
        mult = 20.0;
        format(resultStr, sizeof(resultStr), "{FFD700}[ 7 | 7 | 7 ] JACKPOT x20 !");
    }
    else if(r1==r2 && r2==r3)
    {
        mult = 8.0;
        format(resultStr, sizeof(resultStr), "{00FF00}[ %d | %d | %d ] Triple ! x8", r1, r2, r3);
    }
    else if(r1==r2 || r2==r3 || r1==r3)
    {
        mult = 1.5;
        format(resultStr, sizeof(resultStr), "{FFFF00}[ %d | %d | %d ] Paire ! x1.5", r1, r2, r3);
    }
    else
    {
        mult = 0.0;
        format(resultStr, sizeof(resultStr), "{FF4444}[ %d | %d | %d ] Perdu !", r1, r2, r3);
    }

    new gain = floatround(mise * mult);  // gain brut (la mise a deja �t� prelevee dans /casino jouer)
    new netGain = gain - mise;             // gain net (pour affichage et calcul revenus casino)
    SafeGivePlayerMoney(playerid, gain, "Casino slot gain");

    new cid = Casino_GetNearest(playerid);
    if(cid != -1 && netGain < 0)
        casino[cid][caTotalGains] += (-netGain);  // le casino gagn� quand joueur perd

    new msg[220];
    format(msg, sizeof(msg), "{FFD700} Casino {FFFFFF} Mise : {FFAA00}%d${FFFFFF} | %s | Resultat : %s{FFAA00}%d$",
        mise, resultStr, (netGain >= 0 ? "{00FF00}+":"{FF4444}"), netGain);
    msg_Client(playerid, COLOR_WHITE, msg);

    // Effets GameText
    if(mult >= 20.0)
        GameTextForPlayer(playerid, "~y~~h~JACKPOT !", 4000, 5);
    else if(mult >= 8.0)
        GameTextForPlayer(playerid, "~g~~h~TRIPLE !", 3000, 5);
    else if(mult >= 1.0)
        GameTextForPlayer(playerid, "~w~Paire !", 2000, 5);
    else
        GameTextForPlayer(playerid, "~r~Perdu !", 2000, 5);
    return 1;
}

stock Casino_RefreshLabel(id)
{
    if(casino[id][caLabel] != _:INVALID_3DTEXT_ID && casino[id][caLabel] != 0)
    {
        Casino_BuildLabel(id);
        Update3DTextLabelText(Text3D:casino[id][caLabel], 0xFFD700FF, gCasinoLabelBuf);
    }
    return 1;
}

stock Casino_Save()
{
    if(fexist(CASINO_FILE)) fremove(CASINO_FILE);
    new File:f = fopen(CASINO_FILE, io_write);
    if(!f) return 0;
    new line[420];
    for(new i=0; i<MAX_CASINO; i++)
    {
        if(casino[i][caUsed] != 1) continue;
        // Nouveau format : 14 champs (compat ancien chargement)
        format(line, sizeof(line), "%.4f,%.4f,%.4f,%s,%s,%d,%d,%d,%d,%.4f,%.4f,%.4f,%.4f,%d\n",
            casino[i][caX], casino[i][caY], casino[i][caZ],
            casino[i][caName], casino[i][caOwner],
            casino[i][caOwnerSQLID], casino[i][caOpen],
            casino[i][caPrice], casino[i][caForSale],
            casino[i][caIntX], casino[i][caIntY], casino[i][caIntZ], casino[i][caIntA],
            casino[i][caInteriorId]);
        fwrite(f, line);
    }
    fclose(f);
    return 1;
}


