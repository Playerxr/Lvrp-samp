forward vehicle_DeletePlayer(player_sqlid,vehicle_sqlid);
public vehicle_DeletePlayer(player_sqlid,vehicle_sqlid)
{
    new vehicleid = vehicle_GetId(vehicle_sqlid);
	if(vehicleid == -1) // Le joueur s'est reconnect ou le vh n'est pas cre IG
	    {return 1;}
	new bool:reconnect=false;
	for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
	{
	    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && PlayerInfo[i][pSQLID] == player_sqlid)
	        {reconnect=true; break;}
	}
	// [FIX] Si le joueur s'est reconnect� pendant le timer DELETE_VEHICLE,
	// il faut recharger le vehicule pour la nouvelle session (sinon ghost en memoire)
	if(reconnect == true)
	{
		// Le vehicule existe deja IG, juste s'assurer que le slot pCar est correct
		for(new pi=0; pi<MAX_PLAYERS_CURRENT+1; pi++)
		{
			if(IsPlayerConnected(pi) && !IsPlayerNPC(pi) && PlayerInfo[pi][pSQLID] == player_sqlid)
			{
				// Verifier que pCar contient bien ce SQLID, sinon le retrouver
				new bFound = false;
				for(new cs=0; cs<6; cs++)
				{
					if(PlayerInfo[pi][pCar][cs] == vehicle_sqlid) {bFound = true; break;}
				}
				if(!bFound)
				{
					printf("[VehicleDelete/Reconnect] SQLID %d non trouve dans pCar du joueur %d - slot perdu", vehicle_sqlid, pi);
				}
				break;
			}
		}
		return 1;
	}
	if(reconnect == false)
	{
	    if(vehicleid == totalVehicles)
	        {totalVehicles--;}
	    if(IsValidDynamicObject(car_Neon1[vehicleid]))
			{DestroyDynamicObject(car_Neon1[vehicleid]);}
		if(IsValidDynamicObject(car_Neon2[vehicleid]))
			{DestroyDynamicObject(car_Neon2[vehicleid]);}
		car_Neon1[vehicleid] = 0;
		car_Neon2[vehicleid] = 0;
	    // FIX CRITIQUE : vehicle_Save prend l'INDEX du tableau, pas le SQLID
	    // Ancien code : vehicle_Save(vehicle_sqlid,1,1) corrompait random la DB d'autres v�hicules !
	    vehicle_Save(vehicleid,1,1);
	    // FIX : reset complet du slot (sinon vehicle_GetId trouve des ghosts)
	    vehicle[vehicleid][cVW]=0;
	    vehicle[vehicleid][cInt]=0;
	    vehicle[vehicleid][cLock]=0;
	    vehicle[vehicleid][used]=0;
	    vehicle[vehicleid][SQLID]=-1;
	    vehicle[vehicleid][cType]=0;
	    vehicle[vehicleid][cModel]=0;
	    vehicle[vehicleid][cOwned]=0;
	    vehicle[vehicleid][ownerSQLID]=0;
	    format(vehicle[vehicleid][cOwner], MAX_PLAYER_NAME, "");
	    vehicle[vehicleid][sabot] = false;
	    strmid(vehicle[vehicleid][sabotDesc],"Aucun",0,64,64);
	    vehicle[vehicleid][cEngine] = false;
		for(new i=0; i<9; i++)
			{tuning_RemoveComponent(vehicleid,i);}
	    DestroyVehicle(vehicleid);
		printf("[Vehicule Dyn] Suppression IG | ID:SAMP %d - ID:MYSQL %d",vehicleid,vehicle_sqlid);
	}
	return 1;
}

