		cache_get_value_name_int(i, "iQ3", bin[i][itemQ][2]);
		cache_get_value_name_int(i, "iM4", bin[i][itemM][3]);
		cache_get_value_name_int(i, "iQ4", bin[i][itemQ][3]);
