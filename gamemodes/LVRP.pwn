		new target_call = strval(tmp);

		// Raccrocher : pas de check telephone necessaire
		if(target_call == 0) {
			CallRemoteFunction("LeavePrivateVoiceChannel", "i", playerid);
			isUsingPhoneVoip[playerid] = false;
			ClearAnimations(playerid); // Stop l'emote telephone
			msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} Appel termin\xe9.");
			return 1;
		}

		// FIX : Verifier que le joueur a un telephone (item 1668)
		if(hasPhone[playerid] == 0)
		{
		    msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Info \xab{FFFFFF} Vous n'avez pas de t\xe9l\xe9phone. Achetez-en un en magasin.");
