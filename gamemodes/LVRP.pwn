	// === PARKING - Dialog 9981 : selection spawn/despawn vehicule ===
	if(dialogid == 9981)
	{
	    if(!response) return 1;  // Annuler
	    // FIX: on utilise parking_SlotCount et parking_RealSlot pour le mapping correct
	    new cnt = parking_SlotCount[playerid];
	    if(listitem >= 0 && listitem < cnt)
	    {
	        // Spawn du vehicule dans le slot reel correspondant
	        Parking_SpawnVehicleAt(playerid, parking_RealSlot[playerid][listitem]);
	        return 1;
	    }
	    if(listitem == cnt)
	    {
	        // Sous-menu despawn : liste les v�hicules charg�s
	        new bodyD[1024] = "Choisissez le vehicule a despawn :\n";
	        new lineD[128];
	        new anyD = 0;
	        for(new i=0; i<6; i++)
	        {
	            if(PlayerInfo[playerid][pCar][i] == -1)
	            {
	                format(lineD, sizeof(lineD), "{555555}Slot %d : vide{FFFFFF}\n", i+1);
	            }
	            else
	            {
	                new carSqlid = PlayerInfo[playerid][pCar][i];
	                new idx = vehicle_GetId(carSqlid);
	                if(idx == -1)
	                    {format(lineD, sizeof(lineD), "{555555}Slot %d : non charge{FFFFFF}\n", i+1);}
	                else
	                    {format(lineD, sizeof(lineD), "{FF6666}Slot %d : %s{FFFFFF}\n", i+1, vehicle[idx][cDescription]); anyD = 1;}
	            }
	            strcat(bodyD, lineD);
	        }
	        if(anyD == 0)
	        {
	            ShowPlayerDialog(playerid, 9980, DIALOG_STYLE_MSGBOX, " Parking  Despawn", "Aucun vehicule a despawn.", "OK", "");
	            return 1;
	        }
	        // FIX: liste dynamique despawn
	        new bodyD2[512];
	        new lineD2[128];
	        new countD2 = 0;
	        for(new jj=0; jj<6; jj++)
	        {
	            if(PlayerInfo[playerid][pCar][jj] == -1) continue;
	            new csql2 = PlayerInfo[playerid][pCar][jj];
	            new vidxD = vehicle_GetId(csql2);
	            parking_RealSlot[playerid][countD2] = jj;
	            if(vidxD == -1)
	                format(lineD2, sizeof(lineD2), "{CCCCCC}[Slot %d] Non charge{FFFFFF}\n", jj+1);
	            else
	                format(lineD2, sizeof(lineD2), "{FF6666}[Slot %d] %s{FFFFFF}\n", jj+1, vehicle[vidxD][cDescription]);
	            strcat(bodyD2, lineD2);
	            countD2++;
	        }
	        parking_SlotCount[playerid] = countD2;
	        ShowPlayerDialog(playerid, 9983, DIALOG_STYLE_LIST, "\xbb Parking \xab Despawn", bodyD2, "Despawn", "Retour");
	        return 1;
	    }
	    return 1;
	}

