			msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /factionbuy <model_id>");
			msg_Client(playerid, COLOR_INFO, "{C8C8C8}Model ID = ID GTA SA (400-611). Ex: 411=Infernus, 415=Cheetah, 487=Maverick.");
			new cashmsg[140];
			format(cashmsg, sizeof(cashmsg), "{C8C8C8}Coffre de votre faction : {00FF00}$%d", FactionInfo[facID][fCash]);
			return msg_Client(playerid, COLOR_INFO, cashmsg);
