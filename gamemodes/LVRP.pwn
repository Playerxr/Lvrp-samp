			    event[step]=2;
			    for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
			    {
			        if(IsPlayerConnected(i) && !IsPlayerNPC(i) && gPlayerEvent[i] == 1)
			        	{msg_Client(i,COLOR_WHITE," Event  C'est parti !!");}
			    }
			}
			else if(strcmp(tmp,"arreter",true) == 0)
			{
			    if(event[step] == 0)
			        {return msg_Client(playerid,COLOR_INFO,"{CF9756} Info {FFFFFF} Aucun event creer.");}
			    event[step]=0;
			    for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
			    {
			        if(IsPlayerConnected(i) && !IsPlayerNPC(i) && gPlayerEvent[i] == 1)
			        {
			            gPlayerEvent[i] = 0;
						SafeSetPlayerPos(i,1529.6,-1691.2,13.3);
						msg_Client(i,COLOR_INFO,"{CF9756} Info {FFFFFF} L'event s'est termin, vous avez t tlport  Los Santos.");
			        }
			    }
			}
			else if(strcmp(tmp,"config",true) == 0)
			{
			    format(string,sizeof(string),"{FFFFFF}- Nom [%s]\n- Description [%s]\n- Rcompense [%s]\n- Nombre de place [%d]\n- Mettre la teleportation  votre position",
				event[tmpName],event[description],event[jacpot],event[maxParticipent]);
				ShowPlayerDialog(playerid,153,DIALOG_STYLE_LIST," Animateur  Configuration event",string,"Valider","Quitter");
				player_Dialog[playerid] = 0;
			}
			else if(strcmp(tmp,"aide",true) == 0)
			{
			    msg_Client(playerid,COLOR_WHITE,"1. Pour creer un event commencez par le configurez (/anim event config)");
			    msg_Client(playerid,COLOR_WHITE,"1.1 Remplissez les champs personaliss (Nom, description, rcompense, places, etc ..)");
			    msg_Client(playerid,COLOR_WHITE,"2. Crez l'event (/anim event creer) pour prevenir les joueurs");
			    msg_Client(playerid,COLOR_WHITE,"3. Une fois que les joueurs ont rejoint et sont prs, lancez l'event (/anim event lancer)");
			    msg_Client(playerid,COLOR_WHITE,"4. Un fois l'event termin, utilisez (/anim anim arreter) pour l'arrter.");
			    msg_Client(playerid,COLOR_WHITE,"4.1 Les jours seront renvoys  Los Santos,  vous de donner la rcompense !");
			}
		}
		return 1;
	}
