		new freq_id = strval(tmp);
		if(freq_id == 0) {
			CallRemoteFunction("LeaveGroupVoiceChannel", "i", playerid);
			isUsingRadioVoip[playerid] = false;
			msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} Fr\xe9quence coup\xe9e.");
		} else {
			// [FIX VOIP] Verifier le plugin VOIP avant de rejoindre le canal
			new hasVoice_freq = GetPVarInt(playerid, "hasVoiceOnClient");
			if(hasVoice_freq == 0)
				{return msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FF0000} Plugin VOIP non install\xe9. Contactez un admin.");}
			// [FIX VOIP] Verifier la possession du talkie-walkie (item 2966)
			if(inventory_GetItemQuantity(playerid, 2966) <= 0)
				{return msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Info \xab{FFFFFF} Vous n'avez pas de Talkie Walkie pour rejoindre une fr\xe9quence.");}
			if(isUsingRadioVoip[playerid]) {return msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFFFF} D\xe9j\xe0 en canal radio.");}
			CallRemoteFunction("JoinGroupVoiceChannel", "ii", playerid, freq_id);
			isUsingRadioVoip[playerid] = true;
			format(string, sizeof(string), "{8B8B00}\xbb VOIP \xab{FFFFFF} Connect\xe9 fr\xe9quence %d. (VOIP actif - parlez pour transmettre)", freq_id);
			msg_Client(playerid, COLOR_WHITE, string);
			if(hasVoice_freq == 2)
				{msg_Client(playerid, COLOR_WHITE, "{8B8B00}\xbb VOIP \xab{FFFF00} Attention : votre micro n'est pas d\xe9tect\xe9 (mode \xe9coute seulement).");}
