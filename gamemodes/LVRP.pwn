					if (IsPlayerInAnyVehicle(playerid))
						{return msg_Client(playerid, COLOR_WHITE, "{8BE2E2} Vhicule {FFFFFF} Vous devez tre en dehors du vhicule.");}
					if(car_InSafe[mycar] == true)
						{return msg_Client(playerid, COLOR_GREY, "{8BE2E2} Vhicule {FFFFFF} Quelqun est dj cach dans le coffre.");}

					car_InSafe[mycar] = true;
