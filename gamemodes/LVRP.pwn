			msg_Client(giveplayerid, COLOR_INFO, string);
			format(string, sizeof(string), "{FF6E00} Gouvernement {FFFFFF} Vous avez mis rang %d, %s.",strval(tmp),PlayerInfo[giveplayerid][pName]);
			msg_Client(playerid, COLOR_MAIRIE, string);
