// [DEPLACE] PoliceVehicles_Init et PoliceVehicles_Init_Slot deplaces ici
// car ils sont appeles depuis vehicle_Load. Sinon limite de symbole = undefined.

stock PoliceVehicles_Init_Slot(vid, ctype, vmodel, Float:x, Float:y, Float:z, Float:a, col1, col2, plate[])
{
    if(vid == INVALID_VEHICLE_ID || vid < 1 || vid >= MAX_CAR) return 0;
    SetVehicleNumberPlate(vid, plate);
    vehicle[vid][used] = 1;
    vehicle[vid][SQLID] = -1; // pas en DB
    vehicle[vid][ownerSQLID] = -1;
    vehicle[vid][cModel] = vmodel;
    vehicle[vid][cLocationx] = x;
    vehicle[vid][cLocationy] = y;
    vehicle[vid][cLocationz] = z;
    vehicle[vid][cAngle] = a;
    vehicle[vid][cColorOne] = col1;
    vehicle[vid][cColorTwo] = col2;
    vehicle[vid][cType] = ctype;
    vehicle[vid][cGas] = 100;
    vehicle[vid][cHealth] = 1000.0;
    vehicle[vid][cLock] = 0;
    vehicle[vid][cOwned] = 0;
    vehicle[vid][cStatut] = 0;
    vehicle[vid][cInt] = 0;
    vehicle[vid][cVW] = 0;
    vehicle[vid][cBody] = -1;
    vehicle[vid][cRank] = 0;
    vehicle[vid][cBrid] = 0;
    vehicle[vid][paintjob] = -1;
    format(vehicle[vid][stream], 256, "Aucun");
    strmid(vehicle[vid][cOwner], "Etat", 0, MAX_PLAYER_NAME, MAX_PLAYER_NAME);
    strmid(vehicle[vid][cDescription], "Vehicule de service", 0, 32, 32);
    strmid(vehicle[vid][cLicense], plate, 0, 14, 14);
    return 1;
}

stock PoliceVehicles_Init()
{
    // LSPD (Pershing Square LS) - 6 v�hicules supplementaires
    new lspd_cars[6][3] = {
        {596, 0, 1}, // Police LSPD blanc/noir + sirene
        {596, 0, 0},
        {596, 0, 0},
        {596, 0, 0},
        {597, 0, 0}, // Police Cruiser
        {597, 0, 0}
    };
    new Float:lspd_coords[6][4] = {
        {1535.0, -1670.0, 13.4, 180.0},
        {1538.0, -1670.0, 13.4, 180.0},
        {1541.0, -1670.0, 13.4, 180.0},
        {1544.0, -1670.0, 13.4, 180.0},
        {1547.0, -1670.0, 13.4, 180.0},
        {1550.0, -1670.0, 13.4, 180.0}
    };
    for(new c=0; c<6; c++)
    {
        new vid_lspd = AddStaticVehicleEx(lspd_cars[c][0], lspd_coords[c][0], lspd_coords[c][1], lspd_coords[c][2], lspd_coords[c][3], lspd_cars[c][1], lspd_cars[c][1], 60, lspd_cars[c][2]);
        PoliceVehicles_Init_Slot(vid_lspd, CAR_LSPD, lspd_cars[c][0], lspd_coords[c][0], lspd_coords[c][1], lspd_coords[c][2], lspd_coords[c][3], lspd_cars[c][1], lspd_cars[c][1], "LSPD-EXT");
    }

    // SFPD (San Fierro) - 6 v�hicules
    new Float:sfpd_coords[6][4] = {
        {-1605.0, 686.0, 6.0, 90.0},
        {-1605.0, 690.0, 6.0, 90.0},
        {-1605.0, 694.0, 6.0, 90.0},
        {-1605.0, 698.0, 6.0, 90.0},
        {-1605.0, 702.0, 6.0, 90.0},
        {-1605.0, 706.0, 6.0, 90.0}
    };
    for(new c=0; c<6; c++)
    {
        new vid_sfpd = AddStaticVehicleEx(597, sfpd_coords[c][0], sfpd_coords[c][1], sfpd_coords[c][2], sfpd_coords[c][3], 0, 0, 60, 1);
        PoliceVehicles_Init_Slot(vid_sfpd, CAR_SFPD, 597, sfpd_coords[c][0], sfpd_coords[c][1], sfpd_coords[c][2], sfpd_coords[c][3], 0, 0, "SFPD-EXT");
    }

    // LVPD (Las Venturas) - 6 v�hicules
    new Float:lvpd_coords[6][4] = {
        {2289.0, 2436.0, 10.8, 90.0},
        {2289.0, 2440.0, 10.8, 90.0},
        {2289.0, 2444.0, 10.8, 90.0},
        {2289.0, 2448.0, 10.8, 90.0},
        {2289.0, 2452.0, 10.8, 90.0},
        {2289.0, 2456.0, 10.8, 90.0}
    };
    for(new c=0; c<6; c++)
    {
        new vid_lvpd = AddStaticVehicleEx(597, lvpd_coords[c][0], lvpd_coords[c][1], lvpd_coords[c][2], lvpd_coords[c][3], 0, 0, 60, 1);
        PoliceVehicles_Init_Slot(vid_lvpd, CAR_LVPD, 597, lvpd_coords[c][0], lvpd_coords[c][1], lvpd_coords[c][2], lvpd_coords[c][3], 0, 0, "LVPD-EXT");
    }
    // [FIX] Mettre a jour totalVehicles pour inclure les v�hicules police (boucles de save / cleanup / etc.)
    new highestPolice = 0;
    for(new v=1; v<MAX_CAR; v++)
    {
        if(vehicle[v][used] == 1 && v > highestPolice) highestPolice = v;
    }
    if(highestPolice > totalVehicles) totalVehicles = highestPolice;
    printf("[POLICE] 18 v�hicules de service initialises (6 LSPD + 6 SFPD + 6 LVPD). totalVehicles=%d", totalVehicles);
    return 1;
}


// ============================================================================
// [DEPLACE] 4 callbacks MySQL critiques deplaces ici depuis la fin du fichier.
// Sinon ils sont APRES la limite de symbole du compilateur Pawn 3.2.3664,
// le plugin MySQL ne les trouve pas et crash en SIGSEGV dans ProcessTick.
// Concerne: OnCheckNameBan, OnCheckPendingAccount, beta_CheckKey, vehicle_LoadPlayer.
// ============================================================================

forward vehicle_LoadPlayer(playerid, slot);
public vehicle_LoadPlayer(playerid, slot)
{
	// FIX CRITIQUE : sans ce check, si le vehicule est supprim� de DB mais
	// pCar[slot] contient encore son SQLID, CreateVehicle(model=0,...) cree un
	// vehicule fantome avec data garbage => vehicule "revient" apres restart
	new rowCount = 0;
	cache_get_row_count(rowCount);
	if(rowCount == 0)
	{
	    // Vehicule introuvable en DB (supprim� par admin) => nettoyer le slot
	    if(slot >= 0 && slot <= 5)
	    {
	        PlayerInfo[playerid][pCar][slot] = -1;
	        new colBuf[8];
	        format(colBuf, sizeof(colBuf), "Car%d", slot+1);
	        MySQLUpdatePlayerIntSingle(PlayerInfo[playerid][pSQLID], colBuf, -1);
	    }
	    msg_Client(playerid, COLOR_INFO, "{CF9756} Vehicule {FFFFFF} Ce vehicule n'existe plus en base de donn�es. Slot nettoye automatiquement.");
	    printf("[VehicleLoad] Vehicule introuvable (0 lignes) pour playerid=%d slot=%d - pCar nettoye.", playerid, slot);
	    return 1;
	}
	new mod, Float:x,Float:y,Float:z,Float:a,string[145];
	cache_get_value_name_int(0,"Model", mod);
	cache_get_value_name_float(0,"Pos_x", x);
	cache_get_value_name_float(0,"Pos_y", y);
	cache_get_value_name_float(0,"Pos_z", z);
	cache_get_value_name_float(0,"Angle", a);
	
	new vehicleid = CreateVehicle(mod,x,y,z,a,255,255,-1);
	// [FIX SIGSEGV CRITIQUE] Verifier que CreateVehicle a reussi
	if(vehicleid == INVALID_VEHICLE_ID || vehicleid < 1 || vehicleid >= MAX_CAR)
	{
	    printf("[ERREUR vehicle_LoadPlayer] CreateVehicle a �chou� (vehicleid=%d, model=%d)", vehicleid, mod);
	    msg_Client(playerid, COLOR_INFO, "{CF9756} Vehicule {FFFFFF} Erreur: impossible de spawn votre vehicule. Contactez un admin.");
	    return 1;
	}
	cache_get_value_name_int(0,"id", vehicle[vehicleid][SQLID]);
	vehicle[vehicleid][cModel] = mod;
	vehicle[vehicleid][cLocationx] = x;
	vehicle[vehicleid][cLocationy] = y;
	vehicle[vehicleid][cLocationz] = z;
	vehicle[vehicleid][cAngle] = a;
	cache_get_value_name_int(0,"Color1", vehicle[vehicleid][cColorOne]);
	cache_get_value_name_int(0,"Color2", vehicle[vehicleid][cColorTwo]);
	cache_get_value_name(0,"Owner",vehicle[vehicleid][cOwner], MAX_PLAYER_NAME);
	cache_get_value_name_int(0,"SQLID", vehicle[vehicleid][ownerSQLID]);
	cache_get_value_name(0,"Description",vehicle[vehicleid][cDescription], 32);
	cache_get_value_name_int(0,"Price", vehicle[vehicleid][cValue]);
	cache_get_value_name(0,"License",vehicle[vehicleid][cLicense], 14);
	cache_get_value_name_int(0,"Owned", vehicle[vehicleid][cOwned]);
	cache_get_value_name_int(0,"Locked", vehicle[vehicleid][cLock]);
	cache_get_value_name_int(0,"Statut", vehicle[vehicleid][cStatut]);
	cache_get_value_name_int(0,"Type", vehicle[vehicleid][cType]);
	cache_get_value_name_float(0,"Armour", vehicle[vehicleid][cArmour]);
	cache_get_value_name_int(0,"Rob", vehicle[vehicleid][cRob]);
	cache_get_value_name_int(0,"Neon", vehicle[vehicleid][cNeon]);
	cache_get_value_name_int(0,"Gas", vehicle[vehicleid][cGas]);
	// [FIX ESSENCE] Ce chemin de chargement ne bornait pas la valeur : un Gas
	// negatif ou > 100 en base donnait une jauge folle et un moteur increvable.
	if(vehicle[vehicleid][cGas] < 0 || vehicle[vehicleid][cGas] > 100)
		{vehicle[vehicleid][cGas] = 100;}
	cache_get_value_name_int(0,"Mod1", vehicle[vehicleid][tExhausts]);
	cache_get_value_name_int(0,"Mod2", vehicle[vehicleid][tFrontBumper]);
	cache_get_value_name_int(0,"Mod3", vehicle[vehicleid][tRearBumper]);
	cache_get_value_name_int(0,"Mod4", vehicle[vehicleid][tRoof]);
	cache_get_value_name_int(0,"Mod5", vehicle[vehicleid][tSpoilers]);
	cache_get_value_name_int(0,"Mod6", vehicle[vehicleid][tSideBumper]);
	cache_get_value_name_int(0,"Mod7", vehicle[vehicleid][tWheels]);
	cache_get_value_name_int(0,"Mod8", vehicle[vehicleid][tHydraulics]);
	cache_get_value_name_int(0,"Mod9", vehicle[vehicleid][tNitro]);
	cache_get_value_name_int(0,"Mod10", vehicle[vehicleid][tSideBumper2]);
