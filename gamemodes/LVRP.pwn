stock Float:Trade_GetPrice(idx)
{
    new h,m,s;
    gettime(h,m,s);
    new Float:angle = float((m*60+s)) * 1.2 + float(idx)*73.0;
    new Float:variation = floatsin(angle, degrees);
    return float(TRADE_BASE[idx]) + variation * float(TRADE_AMP[idx]);
}

stock Trade_SaveHoldings(playerid)
{
    new tsql[200];
    mysql_format(MYSQL, tsql, sizeof(tsql),
        "UPDATE lvrp_afrp_phone SET Trade0=%d, Trade1=%d, Trade2=%d, Trade3=%d WHERE Username='%e'",
        tradeHolding[playerid][0], tradeHolding[playerid][1], tradeHolding[playerid][2], tradeHolding[playerid][3],
        PlayerInfo[playerid][pRealName]);
    mysql_tquery(MYSQL, tsql, "", "");
}
