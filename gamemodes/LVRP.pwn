    for(new i=0; i<MAX_SBIZZ; i++)
    {
        uniquebizz_Save(i);
        count++;
    }
    if(count > 0) printf("[AUTOSAVE] %d uniquebizz sauvegardes (auto-ecoles, stations, etc.)", count);
    return 1;
}

// [FIX CRASH MYSQL] AutoSave throttle : sauver 636 maisons d'un coup saturait
// la file du plugin mysql -> SIGSEGV dans ProcessTick ~30s plus tard.
// On etale les UPDATE : 1 maison toutes les 30ms (~19s pour 636).
forward AutoSave_HousesStep(idx);
public AutoSave_HousesStep(idx)
{
    new endIdx = idx + 5;
    if(endIdx > totalHouses) endIdx = totalHouses;
    for(new i=idx; i<endIdx; i++)
    {
        if(house[i][used] != 1) continue;
        house_Save(i, false);
    }
    if(endIdx < totalHouses)
        SetTimerEx("AutoSave_HousesStep", 30, false, "i", endIdx);
    else
        printf("[AUTOSAVE] maisons sauvegard�es (jusqu'� %d, throttle 5/30ms)", endIdx);
    return 1;
}

public AutoSave_Houses()
{
    // Lance la sauvegarde throttlee a partir de 0
    AutoSave_HousesStep(0);
    return 1;
}

public Weather_Tick()
{
    // Change la meteo aleatoirement, mais pas trop violemment
    new newWeather = Server_WeatherList[random(8)];
    if(newWeather == Server_Weather)
        newWeather = Server_WeatherList[random(8)]; // Re-roll si meme
    Server_Weather = newWeather;
    SetWeather(Server_Weather);

    // Annonce discrete
    new mstring[100];
    format(mstring, sizeof(mstring), "{87CEEB} M�t�o {FFFFFF} Le temps change...");
    for(new p=0; p<MAX_PLAYERS_CURRENT+1; p++)
    {
        if(IsPlayerConnected(p) && !IsPlayerNPC(p) && gPlayerLogged[p] == 1)
        {
            SetPlayerWeather(p, Server_Weather);
            msg_Client(p, COLOR_WHITE, mstring);
        }
    }
    return 1;
}

public AntiTP_Tick()
{ return 1; } // [DESACTIVE]

public VehicleCleanup_Tick()
{
    for(new v=1; v<MAX_CAR; v++)
    {
        if(vehicle[v][used] != 1) continue;

        // Skip v�hicules persos (cOwned = 1) - on respawn que les v�hicules de service/job
        if(vehicle[v][cOwned] == 1) continue;

        // Skip si occupe par un joueur
        new occupied = 0;
        for(new p=0; p<MAX_PLAYERS_CURRENT+1; p++)
        {
            if(IsPlayerConnected(p) && IsPlayerInVehicle(p, v))
            {
                occupied = 1;
                break;
            }
        }

        if(occupied)
        {
            VehicleEmpty_Time[v] = 0;
            continue;
        }

        VehicleEmpty_Time[v]++;
        // 15 minutes vide = respawn
        if(VehicleEmpty_Time[v] >= 15)
        {
            SetVehicleToRespawn(v);
            VehicleEmpty_Time[v] = 0;
        }
    }
    return 1;
}

forward Vote_Tick();
public Vote_Tick()
{
    if(Vote_Active != 1) return 1;
    if(gettime() - Vote_StartTime >= VOTE_DUREE_SEC)
        Vote_End();
    return 1;
}

