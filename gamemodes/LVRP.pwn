stock Drug_StartMild(playerid)
{
    if(DrugMildShake[playerid] == 1) return 0; // deja actif
    if(DrugODShake[playerid] == 1) return 0;   // overdose prioritaire
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    DrugMildShake[playerid] = 1;
    DrugMildCount[playerid] = 0;
    // 1 impulsion/seconde x 90 = 1min30s de tremblement
    SetTimerEx("Drug_MildShake", 1000, false, "i", playerid);
    // Animation soule pendant 1 minute (60 000ms)
    if(!IsPlayerInAnyVehicle(playerid))
        LoopingAnim(playerid, "PED", "WALK_DRUNK", 4.0, 1, 1, 0, 0, 0);
    SetTimerEx("Drug_StopDrunkAnim", 60000, false, "i", playerid);
    return 1;
}

stock Drug_StartOverdose(playerid)
{
    if(DrugODShake[playerid] == 1) return 0; // [ANTI-BUG] deja actif
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    DrugODShake[playerid] = 1;
    DrugODShakeCount[playerid] = 0;
    SetTimerEx("Drug_OverdoseShake", 1000, false, "i", playerid); // 1 impulsion/seconde x 10
    return 1;
}

