public atm_Repair(id,phase)
{
	if(phase == 1)
	{
	    atm[id][rob]=2;
	    atm_UpdateInfos(id);
	    SetTimerEx("atm_Repair",240*(60000),0,"i",id,2);
    }
    else
    {
        atm[id][rob]=0;
    }
	return 1;
}

public UnsetFirstSpawn(playerid)
{
	gPlayerSpawn[playerid] = 0;
}

public CommeBackOff(playerid)
{
	PlayerComeBack[playerid] = 0;
}

public ClearKnock(playerid)
{
	TogglePlayerControllable(playerid, 1);
	ClearAnimations(playerid);
	KnockedDown[playerid] = 0;
}

public server_AntiHack(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		new string[128];
	    format(string, sizeof(string), "{6E6E6E} AntiCheat {AAAAAA} %s a t kick, raison : Temps de Connexion coul.",PlayerInfo[playerid][pRealName]);
		SendClientMessageToAll(COLOR_YELLOW, string);
		MySQLKick(playerid,-2,"Temps de connexion coul");
	}
	return 1;
}

