	        if(PlayerInfo[playerid][pMember] == FACTION_HOPITAL && PlayerInfo[playerid][pRank] >= 6)
	        {
	            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/hopital inviter <id> : recruter (rang 6+)");
	            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/hopital virer <id> : exclure (rang 6+)");
	            msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/hopital grade <id> <rang 1-8> : changer rang (rang 7+)");
	        }
	        msg_Client(playerid, COLOR_WHITE, "{FFFFFF}/duty hopital : prendre/quitter service");
