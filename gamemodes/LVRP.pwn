						msg_Client(playerid, COLOR_YELLOW, "{8B8B00}\xbb Tel \xab{FFFFFF} Voix AFRP active - parlez normalement.");
						phone_Time[i][0]=0; phone_Time[i][1]=0;
						phone_Time[playerid][0]=0; phone_Time[playerid][1]=0;
					}
				}
			}
	    }
