//--------------------------------[MYSQL]---------------------------------------
public MySQLConnect(sqlhost[], sqluser[], sqlpass[], sqldb[])
{
    // [FIX] "duplicate connection detected: handle id 1 already exists" -
    // arrive quand OnGameModeInit tourne 2x (gmx / rotation gamemode) sans
    // qu'OnGameModeExit ait ferme la connexion precedente. On ferme tout
    // handle existant avant de reconnecter, par securite (idempotent).
    if(_:MYSQL != 0)
    {
        mysql_close(MYSQL);
        MYSQL = MySQL:0;
    }
    MYSQL = mysql_connect(sqlhost, sqluser, sqlpass, sqldb);
	if(mysql_errno(MYSQL) == 0)
		{print("[MYSQL] Connexion reussie");return 1;}
	else
	{
		// [FIX MYSQL] Fermer proprement et retenter une vraie reconnexion
		mysql_close(MYSQL);
		MYSQL = mysql_connect(sqlhost, sqluser, sqlpass, sqldb);
		if(mysql_errno(MYSQL) == 0)
			{print("[MYSQL] Reconnexion reussie");return 1;}
		else
			{print("[MYSQL] Impossible de se reconnecter, arret du serveur"); SendRconCommand("exit"); return 0;}
	}
}

public MySQLDisconnect()
{
	mysql_close(MYSQL);
	MYSQL = MySQL:0;
	print("[MYSQL] Deconnexion de la DB ...");
	return 1;
}

// [FIX DUPLICATE CONNECTION] OnGameModeExit n'existait pas du tout dans le script.
// Sans lui, un /gmx ou une rotation gamemode relance OnGameModeInit sans jamais
// fermer la connexion MySQL precedente -> handle "fantome" + warning duplicate.
public OnGameModeExit()
{
	MySQLDisconnect();
	return 1;
}















