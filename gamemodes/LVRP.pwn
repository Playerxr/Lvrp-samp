		        format(string,sizeof(string),"{FF2727} Admin {FFABAD} Vous avez restaur l'armure de %s.",sendername);
		        msg_Client(playerid,COLOR_WHITE,string);
		        format(string, sizeof(string), "%s  restaur l'armure de %s.",giveplayer, sendername);
				log_Admin(string);
		        return 1;
