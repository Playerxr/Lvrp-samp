public Inventory_OpenDialog(playerid, page)
{
    if(!IsPlayerConnected(playerid)) return 0;

    new dialogStr[2400];
    new line[200];
    new modelId, quant, cat, w, st;
    new itemName[40];
    new totalW = Inv_GetTotalWeight(playerid);
    new maxW = (gPlayerInventory[playerid] > 0) ? gPlayerInventory[playerid] * 1000 : INV_DEFAULT_WEIGHT_MAX * 1000;

    // En-t�te avec poids
    format(dialogStr, sizeof(dialogStr),
        "{FFAA00} Inventaire {FFFFFF} Poids: {FFFF00}%.2f{FFFFFF}/{00FF00}%.2f{FFFFFF} kg\n\n",
        floatdiv(float(totalW), 1000.0), floatdiv(float(maxW), 1000.0));

    // Liste des items presents
    new shown = 0;
    for(new i=0; i<sizeof(InvItemDefs); i++)
    {
        modelId = InvItemDefs[i][invModelId];
        quant = inventory_GetItemQuantity(playerid, modelId);
        if(quant <= 0) continue;
        Inv_GetItemDef(modelId, cat, w, st, itemName, sizeof(itemName));

        // Filtrage par categorie
        if(Inv_FilterCategory[playerid] != 0 && Inv_FilterCategory[playerid] != cat)
            continue;

        new totalItemW = w * quant;
        new catName[20];
        Inv_GetCategoryName(cat, catName, sizeof(catName));
        format(line, sizeof(line),
            "%s {AAAAAA}[x%d - %.2fkg] {FFFFFF}- %s\n",
            itemName, quant, floatdiv(float(totalItemW), 1000.0), catName);
        if(strlen(dialogStr) + strlen(line) < sizeof(dialogStr) - 50)
        {
            strcat(dialogStr, line, sizeof(dialogStr));
            shown++;
        }
    }

    if(shown == 0)
        strcat(dialogStr, "{AAAAAA}(Aucun objet dans cette categorie)\n", sizeof(dialogStr));

    // Pied de page (filtres)
    strcat(dialogStr, "\n{FFAA00}Filtres :{FFFFFF}\n", sizeof(dialogStr));
    strcat(dialogStr, "[Tous] [Nourriture] [Boissons] [Drogues] [Outils] [Mat�riaux] [Documents] [Autres]\n", sizeof(dialogStr));

    Inv_PageActuelle[playerid] = page;
    ShowPlayerDialog(playerid, 9991, DIALOG_STYLE_MSGBOX, "{FFAA00} Inventaire dynamique ", dialogStr, "Filtrer", "Fermer");
    return 1;
}

