		if(PlayerInfo[playerid][pLeader] < 200)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Seuls les chefs de gang/mafia peuvent acheter des v�hicules de faction.");
		new facID = PlayerInfo[playerid][pLeader] - 200;
		if(facID < 0 || facID >= MAX_FACTION || FactionInfo[facID][fCreate] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Votre faction est invalide ou supprim�e.");

		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
