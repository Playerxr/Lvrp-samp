// === CREATION ECRAN ===
stock Phone_CreateUI(playerid)
{
    Phone_DestroyUI(playerid);
    pTDn[playerid]=0; pSeln[playerid]=0;

    PhUI_drawBody(playerid);
    switch(pScreen[playerid])
    {
        case PSCREEN_HOME:     PhUI_drawHome(playerid);
        case PSCREEN_CALLS:    PhUI_drawCalls(playerid);
        case PSCREEN_WA_HOME:  PhUI_drawWAHome(playerid);
        case PSCREEN_HEALTH:   PhUI_drawHealth(playerid);
        case PSCREEN_WEATHER:  PhUI_drawWeather(playerid);
        case PSCREEN_ANNUAIRE: PhUI_drawAnnuaire(playerid);
        case PSCREEN_SETTINGS: PhUI_drawSettings(playerid);
    }
    phoneUICreated[playerid]=true;
}

stock Phone_DestroyUI(playerid)
{
    if(!phoneUICreated[playerid]) return;
    for(new i=0;i<pTDn[playerid];i++)
        PlayerTextDrawDestroy(playerid,pTD[playerid][i]);
    pTDn[playerid]=0; pSeln[playerid]=0;
    phoneUICreated[playerid]=false;
}

forward Phone_DelaySelect(playerid);
public Phone_DelaySelect(playerid)
{
    if(IsPlayerConnected(playerid)&&usingPhone[playerid]==1)
        SelectTextDraw(playerid,0xFFFFFF80);
    return 1;
}

stock Phone_Show(playerid)
{
    if(!IsPlayerConnected(playerid)) return;
    usingPhone[playerid]=1;
    Phone_CreateUI(playerid);
    for(new i=0;i<pTDn[playerid];i++)
        PlayerTextDrawShow(playerid,pTD[playerid][i]);
    SetTimerEx("Phone_DelaySelect",150,false,"i",playerid);
}

stock Phone_Hide(playerid)
{
    if(!IsPlayerConnected(playerid)) return;
    if(phoneUICreated[playerid])
        for(new i=0;i<pTDn[playerid];i++)
            PlayerTextDrawHide(playerid,pTD[playerid][i]);
    CancelSelectTextDraw(playerid);
    usingPhone[playerid]=0;
}

stock Phone_GoScreen(playerid, screen)
{
    pPrevScreen[playerid]=pScreen[playerid];
    pScreen[playerid]=screen;
    Phone_Hide(playerid);
    Phone_Show(playerid);
}

stock Phone_ApplyTheme(playerid,theme)
{
    if(theme<0||theme>5) theme=0;
    phoneTheme[playerid]=theme;
    if(usingPhone[playerid]==1) Phone_Show(playerid);
}

stock Phone_HandleClick(playerid,PlayerText:td)
{
    if(!phoneUICreated[playerid]) return 0;
    for(new i=0;i<pSeln[playerid];i++)
    {
        if(pSel[playerid][i]!=td) continue;
        new act=pAct[playerid][i];
        // Themes
        if(act>=PA_THEME_0&&act<=PA_THEME_5){Phone_ApplyTheme(playerid,act-PA_THEME_0);Phone_GoScreen(playerid,PSCREEN_SETTINGS);return 1;}
        switch(act)
        {
            case PA_CLOSE:{Phone_Hide(playerid);pScreen[playerid]=PSCREEN_HOME;pDialBuf[playerid][0]=0;}
            case PA_HOME:{pScreen[playerid]=PSCREEN_HOME;pDialBuf[playerid][0]=0;Phone_Hide(playerid);Phone_Show(playerid);}
            case PA_BACK:{pScreen[playerid]=PSCREEN_HOME;Phone_Hide(playerid);Phone_Show(playerid);}
            case PA_APP_CALL: Phone_GoScreen(playerid,PSCREEN_CALLS);
            case PA_APP_WA:   Phone_GoScreen(playerid,PSCREEN_WA_HOME);
            case PA_APP_HEALTH: Phone_GoScreen(playerid,PSCREEN_HEALTH);
            case PA_APP_WEATHER: Phone_GoScreen(playerid,PSCREEN_WEATHER);
            case PA_APP_ANNUAIRE: Phone_GoScreen(playerid,PSCREEN_ANNUAIRE);
            case PA_APP_SETTINGS: Phone_GoScreen(playerid,PSCREEN_SETTINGS);
            case PA_APP_SMS:
            {
                Phone_Hide(playerid);
                ShowPlayerDialog(playerid,9390,DIALOG_STYLE_INPUT,"{00B4D8}SMS AFRP","{FFFFFF}Numero du destinataire :","Suivant","Annuler");
            }
            case PA_APP_TRADE:
            {
                Phone_Hide(playerid);
                ShowPlayerDialog(playerid, 9210, DIALOG_STYLE_LIST, "{FFAA00}AFRP Trading",
                    "{FFFFFF}1. Voir les cours en direct\n{00FF00}2. Acheter une crypto/action\n{FF0000}3. Vendre une position\n{FFFF00}4. Mon portefeuille",
                    "Choisir", "Fermer");
            }
            case PA_APP_MAP,PA_APP_MARKET,PA_APP_POL,PA_APP_IMMO,PA_APP_GOV,PA_APP_WORK:
            {
                Phone_Hide(playerid);
                ShowPlayerDialog(playerid,9453,DIALOG_STYLE_MSGBOX,"{2B6AFF}AFRP Phone","{FFFFFF}Application en cours\nde developpement.\n\n{AAAAAA}Bientot disponible !","OK","");
            }
            // Clavier
            case PA_KEY_1,PA_KEY_2,PA_KEY_3,PA_KEY_4,PA_KEY_5,
                 PA_KEY_6,PA_KEY_7,PA_KEY_8,PA_KEY_9,PA_KEY_0:
            {
                new digit=act-PA_KEY_1+1; if(act==PA_KEY_0) digit=0;
                new len=strlen(pDialBuf[playerid]);
                if(len<15){pDialBuf[playerid][len]='0'+digit;pDialBuf[playerid][len+1]=0;}
                Phone_GoScreen(playerid,PSCREEN_CALLS);
            }
                   case PA_KEY_STAR: // 36
            {
                new len=strlen(pDialBuf[playerid]);
                if(len<15){pDialBuf[playerid][len]='*';pDialBuf[playerid][len+1]=0;}
                Phone_GoScreen(playerid,PSCREEN_CALLS);
            }
                   case PA_KEY_HASH: // 37
            {
                new len=strlen(pDialBuf[playerid]);
                if(len<15){pDialBuf[playerid][len]='#';pDialBuf[playerid][len+1]=0;}
                Phone_GoScreen(playerid,PSCREEN_CALLS);
            }
            case PA_CALL_DEL:
            {
                new len=strlen(pDialBuf[playerid]);
                if(len>0) pDialBuf[playerid][len-1]=0;
                Phone_GoScreen(playerid,PSCREEN_CALLS);
            }
            case PA_CALL_DIAL:
            {
                if(strlen(pDialBuf[playerid])>0)
                {
                    new cmd[32]; format(cmd,32,"/call %s",pDialBuf[playerid]);
                    pDialBuf[playerid][0]=0;
                    Phone_Hide(playerid); pScreen[playerid]=PSCREEN_HOME;
                    OnPlayerCommandText(playerid,cmd);
                }
            }
            case PA_WA_GROUP:
            {
                Phone_Hide(playerid);
                ShowPlayerDialog(playerid,9201,DIALOG_STYLE_INPUT,"{00BA00}WhatsApp - Groupe","{FFFFFF}Ecrivez votre message :","Envoyer","Annuler");
            }
            case PA_WA_MP:
            {
                Phone_Hide(playerid);
                ShowPlayerDialog(playerid,9202,DIALOG_STYLE_INPUT,"{00BA00}WhatsApp - MP","{FFFFFF}Numero du destinataire :","Suivant","Annuler");
            }
            case PA_WA_CALL: Phone_GoScreen(playerid,PSCREEN_CALLS);
        }
        return 1;
    }
    return 0;
}


// [MOBILE INLINE] Stubs supprimes : les vraies implementations viennent de
// mobile.inc (UseMobile, UpdateTimeDate, HidePhone, ShowNoApps,
// OnPlayerEnterShop, SendPlayerNotification, CreateShop, CreateNotificationTD,
// CreateTextDraws, ChangeBackground, ChangeFrame, IsPlayerNearMarket).


//---------------------------<[ OnPlayerCommandText ]>-----------g---------------------------------------------
public OnPlayerCommandText(playerid, cmdtext[])
{
	new string[1024],cmd[64],tmp[256];
	new giveplayerid, moneys, idx, var;
	new giveplayer[MAX_PLAYER_NAME], sendername[MAX_PLAYER_NAME];
	new idcar = GetPlayerVehicleID(playerid);
	cmd = strtok(cmdtext, idx);
	
	log_Commands(playerid,cmdtext);

	// ============================================================
	// COMMANDES TERRITOIRES / GANG ZONES (admin)
	// ============================================================
	// [TELAPPS] /tel /phone /telephone reactivees : les huit applications du
	// smartphone ont maintenant un contenu (voir afrp_telapps.inc). Elles
	// etaient desactivees parce que chaque icone repondait "en developpement".
	// /mobile continue de fonctionner en parallele.
	if(strcmp(cmd, "/tel", true) == 0 || strcmp(cmd, "/phone", true) == 0 || strcmp(cmd, "/telephone", true) == 0)
	{
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			if(phone_State[playerid] != PHONE_STATE_CLOSED) return phone_Close(playerid);
			return phone_Open(playerid);
		}
		return 0; // sous-commandes traitees plus loin
	}
	if(strcmp(cmd, "/turfs", true) == 0)
	{
		new tlist[1500] = "{FFAA00}=== TERRITOIRES ===\n\n{FFFFFF}ID  Nom                    Propri�taire\n";
		new tcount = 0;
		for(new i = 0; i < MAX_TURFS; i++)
		{
			if(Turfs[i][tUsed] != 1) continue;
			new line[180];
			format(line, sizeof(line), "%-3d %-22s %s\n", i, Turfs[i][tName], Turfs[i][tOwner]);
			strcat(tlist, line, sizeof(tlist));
			tcount++;
		}
		if(tcount == 0)
			strcat(tlist, "{CF9756}Aucun territoire defini.\n", sizeof(tlist));
		ShowPlayerDialog(playerid, 7100, DIALOG_STYLE_MSGBOX, "{FFAA00}Territoires", tlist, "OK", "");
		return 1;
	}
	// [TURF CAPTURE] /territoire : statut de la zone actuelle, ouvert a tous les
	// joueurs (contrairement a /turfdebug qui est reserve aux admins). Se capture
	// en restant dans la zone (5 min sans defenseur adverse) - cette commande
	// sert juste a voir ou en est la capture en cours.
	if(strcmp(cmd, "/territoire", true) == 0 || strcmp(cmd, "/capturer", true) == 0)
	{
		new curTurf = player_CurrentTurf[playerid];
		if(curTurf == -1 || curTurf >= MAX_TURFS || Turfs[curTurf][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756} Territoire {FFFFFF} Tu n'es dans aucun territoire actuellement.");

		if(Turfs[curTurf][tType] != 0)
		{
			new infoMsg[160];
			format(infoMsg, sizeof(infoMsg), "{FFAA00} Territoire {FFFFFF} %s n'est pas un territoire de gang capturable.", Turfs[curTurf][tName]);
			return msg_Client(playerid, COLOR_WHITE, infoMsg);
		}

		new pMem = PlayerInfo[playerid][pMember];
		new bool:inGang = (pMem >= 200 && (pMem - 200) >= 0 && (pMem - 200) < MAX_FACTION && FactionInfo[pMem - 200][fCreate] == 1);
		new now3 = gettime();
		new currentCooldown3 = (gangWar_Active == 1) ? GANGWAR_COOLDOWN : TURF_CAPTURE_COOLDOWN;
		new cdLeft2 = currentCooldown3 - (now3 - Turfs[curTurf][tLastCapture]);
		new currentTicks3 = (gangWar_Active == 1) ? GANGWAR_CAPTURE_TICKS : TURF_CAPTURE_TICKS;

		new body2[400];
		new headStr[160];
		format(headStr, sizeof(headStr), "{FFFFFF}Territoire : {FFFFB2}%s{FFFFFF}\nProprietaire : {FFFFB2}%s{FFFFFF}\n", Turfs[curTurf][tName], Turfs[curTurf][tOwner]);
		strcat(body2, headStr);

		if(!inGang)
		{
			strcat(body2, "\n{CCCCCC}Tu dois etre membre d'un gang pour participer a une capture ici.");
		}
		else if(cdLeft2 > 0)
		{
			new cdStr[96];
			format(cdStr, sizeof(cdStr), "\n{FF6347}Cooldown actif : encore %d min avant de pouvoir recapturer cette zone.", (cdLeft2 / 60) + 1);
			strcat(body2, cdStr);
		}
		else if(strcmp(FactionInfo[pMem - 200][fName], Turfs[curTurf][tOwner], true) == 0)
		{
			strcat(body2, "\n{00FF00}C'est deja ton territoire. Defends-le si un rival s'y installe !");
		}
		else if(turf_CaptureFacID[curTurf] == -1)
		{
			strcat(body2, "\n{FFAA00}Reste ici sans defenseur adverse pour lancer une capture (5 min).");
		}
		else
		{
			new pct = (currentTicks3 > 0) ? (turf_CapturePoints[curTurf] * 100 / currentTicks3) : 0;
			new progStr[160];
			if(turf_CaptureFacID[curTurf] == pMem - 200)
				format(progStr, sizeof(progStr), "\n{FFAA00}Capture en cours par ton gang : %d%% (%d/%d sec). Reste dans la zone !", pct, turf_CapturePoints[curTurf] * 2, currentTicks3 * 2);
			else
				format(progStr, sizeof(progStr), "\n{FF6347}Une autre faction est en train de capturer cette zone (%d%%).", pct);
			strcat(body2, progStr);
		}

		ShowPlayerDialog(playerid, 7102, DIALOG_STYLE_MSGBOX, "{FFAA00}Mon territoire", body2, "OK", "");
		return 1;
	}
	// [TURF DEBUG] /turfdebug <id> : diagnostic en direct pour comprendre
	// pourquoi une capture ne progresse pas (defenseurs presents, cooldown...)
	if(strcmp(cmd, "/turfdebug", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 1)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Reserve aux admins.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /turfdebug <id> (voir /turfs pour les id)");
		new dbgId = strval(tmp);
		if(dbgId < 0 || dbgId >= MAX_TURFS || Turfs[dbgId][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756} Info {FFFFFF} Territoire invalide.");

		new Float:dpx, Float:dpy, Float:dpz;
		new dbgDefenders = 0, dbgAttackers = 0, dbgAttackerFacID = -1;
		for(new p = 0; p < MAX_PLAYERS; p++)
		{
			if(!IsPlayerConnected(p) || IsPlayerNPC(p)) continue;
			if(gPlayerLogged[p] != 1) continue;
			new pMem = PlayerInfo[p][pMember];
			// [FIX CAPTURE TURF] meme correction que Turf_CaptureTick : pMember = facID+200
			if(pMem < 200) continue;
			new facIdx = pMem - 200;
			if(facIdx < 0 || facIdx >= MAX_FACTION) continue;
			if(FactionInfo[facIdx][fCreate] != 1) continue;
			GetPlayerPos(p, dpx, dpy, dpz);
			if(!(dpx >= Turfs[dbgId][tMinX] && dpx <= Turfs[dbgId][tMaxX] &&
				 dpy >= Turfs[dbgId][tMinY] && dpy <= Turfs[dbgId][tMaxY])) continue;
			if(medic_PlayerNeedMedic[p] == 2) continue;
			if(strcmp(FactionInfo[facIdx][fName], Turfs[dbgId][tOwner], true) == 0)
				dbgDefenders++;
			else
			{
				dbgAttackers++;
				dbgAttackerFacID = facIdx;
			}
		}

		new now2 = gettime();
		new currentCooldown2 = (gangWar_Active == 1) ? GANGWAR_COOLDOWN : TURF_CAPTURE_COOLDOWN;
		new cdLeft = currentCooldown2 - (now2 - Turfs[dbgId][tLastCapture]);
		new currentTicks2 = (gangWar_Active == 1) ? GANGWAR_CAPTURE_TICKS : TURF_CAPTURE_TICKS;

		// [FIX] Pawn ne supporte pas bien le ternaire melangeant array/string
		// litteral -> resolution via if/else dans des buffers dedies
		new dbgAttackerFacName[64], dbgCapturingFacName[64], dbgCdStatus[32], dbgConclusion[128];
		if(dbgAttackerFacID != -1) format(dbgAttackerFacName, 64, "%s", FactionInfo[dbgAttackerFacID][fName]);
		else format(dbgAttackerFacName, 64, "aucune");
		if(turf_CaptureFacID[dbgId] != -1) format(dbgCapturingFacName, 64, "%s", FactionInfo[turf_CaptureFacID[dbgId]][fName]);
		else format(dbgCapturingFacName, 64, "aucune");
		if(cdLeft > 0) format(dbgCdStatus, 32, "ACTIF - bloque la capture");
		else format(dbgCdStatus, 32, "libre");
		if(dbgDefenders > 0) format(dbgConclusion, 128, "-> Bloque : un defenseur est present dans la zone.");
		else if(cdLeft > 0) format(dbgConclusion, 128, "-> Bloque : cooldown actif, attendre.");
		else if(Turfs[dbgId][tType] != 0) format(dbgConclusion, 128, "-> Bloque : ce n'est pas une zone de gang capturable (Type != 0).");
		else if(dbgAttackers == 0) format(dbgConclusion, 128, "-> Rien ne se passe : aucun attaquant dans la zone actuellement.");
		else format(dbgConclusion, 128, "-> OK : la capture devrait progresser normalement.");

		new dbgMsg[500];
		format(dbgMsg, sizeof(dbgMsg),
			"{FFAA00}=== DEBUG TERRITOIRE %d : %s ==={FFFFFF}\nProprietaire : %s\nCooldown restant : %d sec (%s)\nType zone : %d (0=capturable)\nGangWar actif : %d\n\nJoueurs presents la MAINTENANT :\nDefenseurs (meme faction) : %d\nAttaquants (autre faction) : %d\nFaction attaquante : %s\n\nProgression capture : %d/%d ticks (%d%%)\nFaction en cours de capture : %s\n\n%s",
			dbgId, Turfs[dbgId][tName], Turfs[dbgId][tOwner],
			(cdLeft > 0 ? cdLeft : 0), dbgCdStatus,
			Turfs[dbgId][tType], gangWar_Active,
			dbgDefenders, dbgAttackers,
			dbgAttackerFacName,
			turf_CapturePoints[dbgId], currentTicks2,
			(currentTicks2 > 0) ? (turf_CapturePoints[dbgId] * 100 / currentTicks2) : 0,
			dbgCapturingFacName,
			dbgConclusion);
		ShowPlayerDialog(playerid, 7101, DIALOG_STYLE_MSGBOX, "{FFAA00}Turf Debug", dbgMsg, "OK", "");
		return 1;
	}
	if(strcmp(cmd, "/turfcreate", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Niveau admin 4+ requis.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /turfcreate <largeur> <nom du territoire>");
		new Float:zoneSize = floatstr(tmp);
		if(zoneSize < 10.0 || zoneSize > 1500.0)
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Largeur entre 10 et 1500.");
		// Lire le nom (tout ce qui reste apres la largeur)
		new length2 = strlen(cmdtext);
		while((idx < length2) && (cmdtext[idx] <= ' ')) idx++;
		new offset2 = idx;
		new tname[64];
		while((idx < length2) && ((idx - offset2) < (sizeof(tname)-1)))
		{
			tname[idx-offset2] = cmdtext[idx];
			idx++;
		}
		tname[idx-offset2] = EOS;
		if(!strlen(tname))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Donnez un nom au territoire. Ex: /turfcreate 200 Grove Street");
		// Centrer sur la position du joueur
		new Float:px, Float:py, Float:pz;
		GetPlayerPos(playerid, px, py, pz);
		new Float:half = zoneSize / 2.0;
		// Verifier chevauchement
		new overlapId = turf_WouldOverlap(px - half, py - half, px + half, py + half);
		if(overlapId != -1)
		{
			new ovmsg[180];
			format(ovmsg, sizeof(ovmsg), "{CF9756}Impossible : cette zone chevauche le territoire #%d (%s). Deplacez-vous.", overlapId, Turfs[overlapId][tName]);
			return msg_Client(playerid, COLOR_INFO, ovmsg);
		}
		// Couleur blanche par defaut (territoire neutre)
		new slot = turf_Create(tname, px - half, py - half, px + half, py + half, 0xFFFFFFAA, "Aucun");
		if(slot == -1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Plus de slot libre (max 50).");
		if(slot == -2)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Cette position chevauche une zone existante.");
		new okmsg[180];
		format(okmsg, sizeof(okmsg), "{9EC73D}[TURF]{FFFFFF} Territoire #%d cree : '%s' (%.0fx%.0f). Blanc par defaut, utilisez /turfcolor apres capture.",
			slot, tname, zoneSize, zoneSize);
		msg_Client(playerid, COLOR_GREEN, okmsg);
		return 1;
	}
	if(strcmp(cmd, "/turfdelete", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Niveau admin 4+ requis.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /turfdelete <id>");
		new tid = strval(tmp);
		if(tid < 0 || tid >= MAX_TURFS || Turfs[tid][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Territoire inexistant.");
		new tname_copy[64];
		format(tname_copy, sizeof(tname_copy), "%s", Turfs[tid][tName]);
		turf_Delete(tid);
		new okmsg[140];
		format(okmsg, sizeof(okmsg), "{9EC73D}[TURF]{FFFFFF} Territoire #%d (%s) supprim�.", tid, tname_copy);
		msg_Client(playerid, COLOR_GREEN, okmsg);
		return 1;
	}
	if(strcmp(cmd, "/turfowner", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Niveau admin 4+ requis.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /turfowner <id> <nouveau_proprio>");
		new tid = strval(tmp);
		if(tid < 0 || tid >= MAX_TURFS || Turfs[tid][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Territoire inexistant.");
		new length2 = strlen(cmdtext);
		while((idx < length2) && (cmdtext[idx] <= ' ')) idx++;
		new offset2 = idx;
		new newowner[64];
		while((idx < length2) && ((idx - offset2) < (sizeof(newowner)-1)))
		{
			newowner[idx-offset2] = cmdtext[idx];
			idx++;
		}
		newowner[idx-offset2] = EOS;
		if(!strlen(newowner))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Donnez un nom de propri�taire.");
		format(Turfs[tid][tOwner], 64, "%s", newowner);
		// [COULEUR] Si on remet a Aucun (neutre), forcer le blanc
		if(!strcmp(newowner, "Aucun", true))
		{
			Turfs[tid][tColor] = 0xFFFFFFAA;
			if(Turfs[tid][tGangZone] >= 0)
			{
				GangZoneHideForAll(Turfs[tid][tGangZone]);
				GangZoneShowForAll(Turfs[tid][tGangZone], 0xFFFFFFAA);
			}
		}
		new ownerSql[256], sqlowner[128];
		mysql_escape_string(newowner, sqlowner);
		format(ownerSql, sizeof(ownerSql), "UPDATE lvrp_turfs SET Owner='%s', Color=%d WHERE id=%d",
			sqlowner, Turfs[tid][tColor], Turfs[tid][tSQLID]);
		mysql_tquery(MYSQL, ownerSql, "", "");
		new okmsg[180];
		format(okmsg, sizeof(okmsg), "{9EC73D}[TURF]{FFFFFF} Territoire #%d (%s) -> propri�taire: %s",
			tid, Turfs[tid][tName], newowner);
		msg_Client(playerid, COLOR_GREEN, okmsg);
		return 1;
	}
	if(strcmp(cmd, "/zonepolice", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Niveau admin 4+ requis.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /zonepolice <largeur> <nom du lieu>");
		new Float:zsize = floatstr(tmp);
		if(zsize < 10.0 || zsize > 2000.0)
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Largeur entre 10 et 2000.");
		new length2 = strlen(cmdtext);
		while((idx < length2) && (cmdtext[idx] <= ' ')) idx++;
		new offset2 = idx;
		new zname[64];
		while((idx < length2) && ((idx - offset2) < (sizeof(zname)-1)))
		{
			zname[idx-offset2] = cmdtext[idx];
			idx++;
		}
		zname[idx-offset2] = EOS;
		if(!strlen(zname))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Donnez un nom.");
		new Float:px, Float:py, Float:pz;
		GetPlayerPos(playerid, px, py, pz);
		new Float:half = zsize / 2.0;
		// [TURF] Verifier si la zone chevauche
		new overlapId = turf_WouldOverlap(px - half, py - half, px + half, py + half);
		if(overlapId != -1)
		{
			new ovmsg[180];
			format(ovmsg, sizeof(ovmsg), "{CF9756}Impossible : cette zone chevauche #%d (%s).", overlapId, Turfs[overlapId][tName]);
			return msg_Client(playerid, COLOR_INFO, ovmsg);
		}
		// Vert police = 0x00FF00A0 (alpha 160 pour transparence)
		new slot = turf_Create(zname, px - half, py - half, px + half, py + half, 0x00FF00A0, "Police/Administration", 1);
		if(slot == -1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Plus de slot libre (max 50).");
		if(slot == -2)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Cette position chevauche une zone existante.");
		new okmsg[180];
		format(okmsg, sizeof(okmsg), "{00FF00}[ZONE POLICE]{FFFFFF} Zone verte #%d cree : %s (%.0fx%.0f).", slot, zname, zsize, zsize);
		msg_Client(playerid, COLOR_GREEN, okmsg);
		return 1;
	}
	if(strcmp(cmd, "/zonehopital", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Niveau admin 4+ requis.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /zonehopital <largeur> <nom>");
		new Float:zsize = floatstr(tmp);
		if(zsize < 10.0 || zsize > 2000.0)
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Largeur entre 10 et 2000.");
		new length2 = strlen(cmdtext);
		while((idx < length2) && (cmdtext[idx] <= ' ')) idx++;
		new offset2 = idx;
		new zname[64];
		while((idx < length2) && ((idx - offset2) < (sizeof(zname)-1)))
		{
			zname[idx-offset2] = cmdtext[idx];
			idx++;
		}
		zname[idx-offset2] = EOS;
		if(!strlen(zname))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Donnez un nom.");
		new Float:px, Float:py, Float:pz;
		GetPlayerPos(playerid, px, py, pz);
		new Float:half = zsize / 2.0;
		// [TURF] Verifier si la zone chevauche
		new overlapId = turf_WouldOverlap(px - half, py - half, px + half, py + half);
		if(overlapId != -1)
		{
			new ovmsg[180];
			format(ovmsg, sizeof(ovmsg), "{CF9756}Impossible : cette zone chevauche #%d (%s).", overlapId, Turfs[overlapId][tName]);
			return msg_Client(playerid, COLOR_INFO, ovmsg);
		}
		// Rose hopital = 0xFF1493A0 (deep pink)
		new slot = turf_Create(zname, px - half, py - half, px + half, py + half, 0xFF1493A0, "Hopital", 2);
		if(slot == -1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Plus de slot libre (max 50).");
		if(slot == -2)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Cette position chevauche une zone existante.");
		new okmsg[180];
		format(okmsg, sizeof(okmsg), "{FF1493}[ZONE HOPITAL]{FFFFFF} Zone rose #%d cree : %s (%.0fx%.0f).", slot, zname, zsize, zsize);
		msg_Client(playerid, COLOR_GREEN, okmsg);
		return 1;
	}
	if(strcmp(cmd, "/turfcolor", true) == 0)
	{
		// Si pas d'argument : detecter automatiquement la zone sous le joueur
		tmp = strtok(cmdtext, idx);
		new tid = -1;
		if(!strlen(tmp))
		{
			// Auto-detect : chercher la zone ou se trouve le joueur
			new Float:px, Float:py, Float:pz;
			GetPlayerPos(playerid, px, py, pz);
			tid = turf_FindAt(px, py);
			if(tid == -1)
				return msg_Client(playerid, COLOR_INFO, "{CF9756}Vous n'�tes dans aucun territoire. Utilisez /turfcolor <id> si vous etes loin.");
		}
		else
		{
			tid = strval(tmp);
		}
		if(tid < 0 || tid >= MAX_TURFS || Turfs[tid][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Territoire inexistant.");
		// Acc�s : admin OU propri�taire (gang du joueur == tOwner)
		new isOwner = (strfind(Turfs[tid][tOwner], PlayerInfo[playerid][pName], true) != -1) ? 1 : 0;
		// Aussi v�rifier si la faction du joueur est propri�taire
		new pMem = PlayerInfo[playerid][pMember];
		if(pMem > 0 && pMem < MAX_FACTION && FactionInfo[pMem][fCreate] == 1)
		{
			if(!strcmp(FactionInfo[pMem][fName], Turfs[tid][tOwner], true))
				isOwner = 1;
		}
		if(PlayerInfo[playerid][pAdmin] < 4 && !isOwner)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Votre gang ne possede pas ce territoire.");
		// Bloquer zones police/hopital
		if(Turfs[tid][tType] == 1 || Turfs[tid][tType] == 2)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Les zones police/hopital ont une couleur fixe.");
		// Bloquer si territoire neutre sauf admin
		if(!strcmp(Turfs[tid][tOwner], "Aucun", true) && PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Ce territoire est neutre. Capturez-le d'abord.");
		player_TurfColorId[playerid] = tid;
		// Dialog avec apercu des couleurs
		new dialogTitle[100];
		format(dialogTitle, sizeof(dialogTitle), "{FFAA00}Couleur du territoire : %s", Turfs[tid][tName]);
		ShowPlayerDialog(playerid, 7110, DIALOG_STYLE_LIST,
			dialogTitle,
			"{FF0000}>>> Rouge <<<\n{0000FF}>>> Bleu <<<\n{FFFF00}>>> Jaune <<<\n{800080}>>> Violet <<<\n{FFA500}>>> Orange <<<\n{00FFFF}>>> Cyan <<<\n{FFFFFF}>>> Blanc <<<\n{8B4513}>>> Marron <<<\n{00FF00}>>> Vert <<<\n{FF69B4}>>> Rose <<<",
			"Choisir", "Annuler");
		return 1;
	}
	if(strcmp(cmd, "/gangwar", true) == 0)
	{
		if(PlayerInfo[playerid][pAdmin] < 4)
			return msg_Client(playerid, COLOR_NOACCES, "{FF0069}Niveau admin 4+ requis.");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			new statusMsg[200];
			format(statusMsg, sizeof(statusMsg),
				"{FFAA00}[GANGWAR] Etat actuel : %s\n{FFFFFF}Usage : /gangwar on (active) ou /gangwar off (desactive)\n{888888}Mode actif : captures plus rapides (2min), cooldown 1h, r�compense $500k au gang vainqueur.",
				(gangWar_Active == 1) ? ("{00FF00}ACTIF") : ("{FF0000}DESACTIVE"));
			return msg_Client(playerid, COLOR_INFO, statusMsg);
		}
		if(!strcmp(tmp, "on", true) || !strcmp(tmp, "start", true) || !strcmp(tmp, "1", true))
		{
			if(gangWar_Active == 1)
				return msg_Client(playerid, COLOR_INFO, "{CF9756}Le mode bataille de gangs est deja actif.");
			gangWar_Active = 1;
			// Reset les cooldowns pour permettre des captures immediates
			for(new k = 0; k < MAX_TURFS; k++)
			{
				if(Turfs[k][tUsed] == 1 && Turfs[k][tType] == 0)
					Turfs[k][tLastCapture] = 0;
			}
			SendClientMessageToAll(0xFF4444FF, "{FF0000}\xbb GANGWAR \xab{FFFFFF} Mode bataille de gangs ACTIVE !");
			SendClientMessageToAll(0xFFFF00FF, "{FFFF00}Captures accelerees (2min), cooldown 1h, r�compense $500k pour le gang vainqueur.");
			SendClientMessageToAll(0xFFFF00FF, "{FFFF00}Tous les territoires sont capturables maintenant ! Bonne chance.");
			return 1;
		}
		if(!strcmp(tmp, "off", true) || !strcmp(tmp, "stop", true) || !strcmp(tmp, "0", true))
		{
			if(gangWar_Active == 0)
				return msg_Client(playerid, COLOR_INFO, "{CF9756}Le mode bataille de gangs est deja desactive.");
			gangWar_Active = 0;
			// Reset les captures en cours
			for(new k = 0; k < MAX_TURFS; k++)
			{
				if(turf_CaptureFacID[k] != -1)
				{
					turf_CaptureFacID[k] = -1;
					turf_CapturePoints[k] = 0;
					if(Turfs[k][tGangZone] >= 0)
						GangZoneStopFlashForAll(Turfs[k][tGangZone]);
				}
			}
			SendClientMessageToAll(0x4444FFFF, "{4444FF}\xbb GANGWAR \xab{FFFFFF} Mode bataille de gangs DESACTIVE.");
			SendClientMessageToAll(0xAAAAAAFF, "Les captures en cours ont �t� annulees. Retour au mode normal (cooldown 48h).");
			return 1;
		}
		return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /gangwar on ou /gangwar off");
	}
	if(strcmp(cmd, "/turfinfo", true) == 0)
	{
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
			return msg_Client(playerid, COLOR_USAGE, "{A98500}Usage: /turfinfo <id>");
		new tid = strval(tmp);
		if(tid < 0 || tid >= MAX_TURFS || Turfs[tid][tUsed] != 1)
			return msg_Client(playerid, COLOR_INFO, "{CF9756}Territoire inexistant.");
		new typeName[32];
		switch(Turfs[tid][tType])
		{
			case 1: format(typeName, sizeof(typeName), "Police/Admin (vert)");
			case 2: format(typeName, sizeof(typeName), "Hopital (rose)");
			default: format(typeName, sizeof(typeName), "Gang (capturable)");
		}
		new now = gettime();
		new cdRemaining = TURF_CAPTURE_COOLDOWN - (now - Turfs[tid][tLastCapture]);
		new infoTxt[700], buf[200];
		format(infoTxt, sizeof(infoTxt), "{FFAA00}=== Territoire #%d ===\n\n{FFFFFF}Nom: %s\nType: %s\nProprietaire: %s\n",
			tid, Turfs[tid][tName], typeName, Turfs[tid][tOwner]);
		if(Turfs[tid][tType] == 0)
		{
			if(cdRemaining > 0)
			{
				new hours = cdRemaining / 3600;
				new mins = (cdRemaining % 3600) / 60;
				format(buf, sizeof(buf), "Cooldown capture: {FF0000}%dh %dmin restantes\n", hours, mins);
			}
			else
				format(buf, sizeof(buf), "Cooldown capture: {00FF00}Capturable maintenant\n");
			strcat(infoTxt, buf, sizeof(infoTxt));
			if(turf_CaptureFacID[tid] != -1)
			{
				new pct = (turf_CapturePoints[tid] * 100) / TURF_CAPTURE_TICKS;
				format(buf, sizeof(buf), "{FFA500}CAPTURE EN COURS: %s a %d%% ({FFFF00}%d/%d sec{FFA500})\n",
					FactionInfo[turf_CaptureFacID[tid]][fName], pct,
					turf_CapturePoints[tid] * 2, TURF_CAPTURE_TICKS * 2);
				strcat(infoTxt, buf, sizeof(infoTxt));
			}
		}
		format(buf, sizeof(buf), "\n{FFFFFF}Coords: (%.0f, %.0f) -> (%.0f, %.0f)",
			Turfs[tid][tMinX], Turfs[tid][tMinY], Turfs[tid][tMaxX], Turfs[tid][tMaxY]);
		strcat(infoTxt, buf, sizeof(infoTxt));
		ShowPlayerDialog(playerid, 7105, DIALOG_STYLE_MSGBOX, "{FFAA00}Info Territoire", infoTxt, "OK", "");
		return 1;
	}
	if(strcmp(cmd, "/factionbuy", true) == 0 || strcmp(cmd, "/gangbuy", true) == 0)
