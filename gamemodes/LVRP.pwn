	        	{format(string,sizeof(string),"[Kick] %s a t kick par l'admin %s, raison : %s ",PlayerInfo[Clicked[playerid]][pRealName],PlayerInfo[playerid][pRealName],inputtext);}
	        
			SendClientMessageToAll(COLOR_LIGHTRED, string);
	        format(string, sizeof(string), "%s  kick %s, raison : %s.",PlayerInfo[playerid][pRealName], PlayerInfo[Clicked[playerid]][pRealName], inputtext);
