{
	return 1;
}

public OnPlayerVoiceStart(playerid)
{
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    // FIX BUG : pas d'animation si le joueur est dans un vehicule (sinon il sort tout seul)
    if(IsPlayerInAnyVehicle(playerid)) return 1;
    // pvarTalkStats : utilise dans les conditions ci-dessous
    new pvarTalkStats = GetPVarInt(playerid, "talkStats");
    #pragma unused pvarTalkStats

    // FIX : pour que le joueur puisse PARLER ET MARCHER, on n'applique plus d'animation
    // pour le mode local ni radio (l'icone sampvoice au-dessus de la t�te suffit comme indicateur).
    // Seul le mode telephone garde une anim (realiste d'etre stationnaire au tel).
    if(isUsingPhoneVoip[playerid])
    {
        // Mode telephone : main a l'oreille style CJ
        // freeze=0, lockx=0, locky=0 pour permettre tout de meme une marche lente
        ApplyAnimation(playerid, "PED", "phone_talk", 4.1, 1, 0, 0, 0, 0);
    }
    // Pour mode local (pvarTalkStats != 3) et radio (pvarTalkStats == 3) : aucune anim,
    // le joueur peut continuer a marcher/courir librement.
    return 1;
}

public OnPlayerVoiceStop(playerid)
{
    if(!IsPlayerConnected(playerid) || IsPlayerNPC(playerid)) return 0;
    // FIX : si en vehicule, on ne touche pas aux animations (sinon ejection)
    if(IsPlayerInAnyVehicle(playerid)) return 1;
    // En appel telephonique : on garde l'anim phone_in (main a l'oreille statique)
    if(isUsingPhoneVoip[playerid])
    {
        ApplyAnimation(playerid, "PED", "phone_in", 4.1, 0, 0, 0, 0, 0);
    }
    else
    {
        // Mode local/radio : pas d'anim a stopper (on n'en applique plus)
        // Mais on clear au cas ou une emote /parler �tait active
        if(GetPVarInt(playerid, "parlerEmoteActive") == 1)
        {
            ClearAnimations(playerid);
            SetPVarInt(playerid, "parlerEmoteActive", 0);
        }
    }
    return 1;
}

