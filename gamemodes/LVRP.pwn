        sbizz[id][ubEnterPrice] = 0;
        sbizz[id][ubInt] = 0;
    }
    else if(MAX_STATION+MAX_SPRAY+MAX_TUNING >= id && id < MAX_STATION+MAX_SPRAY+MAX_TUNING+MAX_OPERATOR)
	{
	    if(id == MAX_STATION+MAX_SPRAY+MAX_TUNING)
