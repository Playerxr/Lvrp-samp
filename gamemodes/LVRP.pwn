						msg_Client(giveplayerid, COLOR_INFO, string);
						format(string, sizeof(string), "{00673A} San News {FFFFFF} Vous avez virer %s.",PlayerInfo[giveplayerid][pName]);
						msg_Client(playerid, COLOR_GREY, string);
