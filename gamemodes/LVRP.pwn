				return 1;
			}
			else if(strcmp(tmp,"skin",true) == 0)
			{
			    tmp = strtok(cmdtext, idx);
			    if(!strlen(tmp))
					{msg_Client(playerid, COLOR_WHITE, "{A98500} Usage {FFFFB2} /vip skin <id>");return 1;}
				var = strval(tmp);
