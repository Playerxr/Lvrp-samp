	if(dialogid == 81)
    {
        new infostring[512], title[128];
        if(inscription_Step[playerid] == 0)
        {
            // Quiz supprim�
            new infoQZ[256], titleQZ[128];
            format(titleQZ,sizeof(titleQZ),"{33CCFF}\xbb Inscription \xab{FFFFFF} Mot de passe");
            format(infoQZ,sizeof(infoQZ),"{FFFFFF}Bienvenue ! Entrez un mot de passe :");
        }
        if(inscription_Step[playerid] == 10)
        {
            if(response==1)
            {
                // === [APPROBATION] Enregistrer compte + dialog attente ===
                OnPlayerRegister(playerid, PlayerInfo[playerid][pKey]);
                PlayerInfo[playerid][pActive] = 0;
                PlayerEnAttente[playerid] = true;
                TimerConnectOff(playerid);
                ShowPlayerDialog(playerid, 9903, DIALOG_STYLE_MSGBOX, "{FFAA00}>>> AFRP - En attente <<<", "{FFFFFF}Votre compte a �t� cree !\n\n{FFAA00}Un administrateur doit valider votre inscription\n{FFFFFF}avant que vous puissiez jouer.\n\n{AAAAAA}Merci de patienter.", "Patienter", "");
                NotifyAdminsNouveauJoueur(PlayerInfo[playerid][pName]);
                return 1;
            }
            if(response==0)
            {
                format(title,sizeof(title),"{33CCFF}\xbb Inscription \xab{FFFFFF} Mot de passe - Etape {FF0000}2{FFFFFF}/10");
				format(infostring,sizeof(infostring),"{FFFFFF}Entrez un mot de passe pour votre connexion :");
				ShowPlayerDialog(playerid,81,DIALOG_STYLE_PASSWORD,title,infostring,"Valider","");
				inscription_Step[playerid]=3;
            }
        }
        // [PARRAINAGE] Step 11 : saisie du nom du parrain (Prenom_Nom) ou vide.
        // DOIT �tre verifie AVANT le "if(!response)" generique ci-dessous, sinon
        // le bouton "Passer" (response=0) serait intercepte et renverrait le
        // joueur a l'�tape mot de passe au lieu de finaliser l'inscription.
        if(inscription_Step[playerid] == 11)
        {
            return Referral_OnDialogResponse(playerid, response, inputtext);
        }

        if(!response)
		{
		    // FIX BUG : au lieu de kick le joueur (qui peut le bloquer en spectator),
		    // on lui represente le dialog de mot de passe. Comme ca il peut continuer son inscription.
		    msg_Client(playerid, COLOR_SERVER, "{005660} Serveur {C8C8C8} Vous devez creer votre compte pour jouer.");
		    format(title,sizeof(title),"{33CCFF} Inscription {FFFFFF} Mot de passe");
		    format(infostring,sizeof(infostring),"{FFFFFF}Entrez un mot de passe pour votre connexion (4-32 caract�res) :");
		    ShowPlayerDialog(playerid,81,DIALOG_STYLE_PASSWORD,title,infostring,"Valider","Quitter");
		    inscription_Step[playerid]=3;
		    return 1;
		}

        // ============================================
        // INSCRIPTION SIMPLIFIEE - 3 ETAPES
        // Etape 1 (step 2) : Mot de passe
        // Etape 2 (step 5) : Sexe
        // Etape 3 (step 10): Recapitulatif + Creer
        // ============================================
        if(inscription_Step[playerid] == 2)
        {
            format(title,sizeof(title),"{33CCFF} Inscription {FFFFFF} Mot de passe");
			format(infostring,sizeof(infostring),"{FFFFFF}Bienvenue ! Entrez un mot de passe pour creer votre compte :");
			ShowPlayerDialog(playerid,81,DIALOG_STYLE_PASSWORD,title,infostring,"Valider","");
			inscription_Step[playerid]=3;
            return 1;
        }
        if(inscription_Step[playerid] == 3)
        {
            if(!strlen(inputtext))
			{
				format(infostring,sizeof(infostring),"{FF0000}Entrez un mot de passe pour votre connexion :");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_PASSWORD,"{33CCFF} Inscription {FFFFFF} Mot de passe",infostring,"Valider","");
			}
			if(strlen(inputtext) < 3)
			{
				format(infostring,sizeof(infostring),"{FF0000}Quatre caract�res minimum !\n{FFFFFF}Entrez un mot de passe pour votre connexion :");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_PASSWORD,"{33CCFF} Inscription {FFFFFF} Mot de passe",infostring,"Valider","");
			}
			if(strlen(inputtext) > 32)
			{
				format(infostring,sizeof(infostring),"{FF0000}32 caract�res maximum !\n{FFFFFF}Entrez un mot de passe pour votre connexion :");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_PASSWORD,"{33CCFF} Inscription {FFFFFF} Mot de passe",infostring,"Valider","");
			}
			strmid(PlayerInfo[playerid][pKey], inputtext, 0, strlen(inputtext), 255);
			// Valeurs par defaut (modifiables a la mairie)
			PlayerInfo[playerid][pOrigin] = 1;
			PlayerInfo[playerid][pLang1]  = 7;
			PlayerInfo[playerid][pAge]    = 25;
			PlayerInfo[playerid][pCity]   = 0;
			PlayerInfo[playerid][pSex]    = 1;
			PlayerInfo[playerid][pSpawn]  = 0;
			SetPlayerSkin(playerid, 26);
			PlayerInfo[playerid][pChar] = 26;
			strmid(PlayerInfo[playerid][pEmail],"noemail@serveur.com",0,32,32);
			// Demander le sexe avant l'email
			format(infostring, sizeof(infostring), "{DABB3E}* Choisissez votre sexe *{FFFFFF}\n  Homme\n  Femme");
			ShowPlayerDialog(playerid, 81, DIALOG_STYLE_LIST, "{33CCFF} Inscription {FFFFFF} Sexe", infostring, "Valider", "");
			inscription_Step[playerid] = 8;
			return 1;
        }
        // Step 8 : choix du sexe
        if(inscription_Step[playerid] == 8)
        {
            if(listitem == 0) // bouton "Valider" sans choix
            {
                format(infostring, sizeof(infostring), "{DABB3E}* Choisissez votre sexe *{FFFFFF}\n  Homme\n  Femme");
                return ShowPlayerDialog(playerid, 81, DIALOG_STYLE_LIST, "{33CCFF} Inscription {FFFFFF} Sexe", infostring, "Valider", "");
            }
            if(listitem == 1) { PlayerInfo[playerid][pSex]=1; SetPlayerSkin(playerid,26);  PlayerInfo[playerid][pChar]=26;  } // Homme
            if(listitem == 2) { PlayerInfo[playerid][pSex]=2; SetPlayerSkin(playerid,298); PlayerInfo[playerid][pChar]=298; } // Femme
            // Passer a l'email
            format(infostring, sizeof(infostring), "{FFFFFF}Entrez votre adresse email :\n{AAAAAA}(Necessaire pour recuperer votre compte)");
            ShowPlayerDialog(playerid, 81, DIALOG_STYLE_INPUT, "{33CCFF} Inscription {FFFFFF} Email", infostring, "Valider", "");
            inscription_Step[playerid] = 4;
            return 1;
        }
        // Step 4 : validation email + spawn
        if(inscription_Step[playerid] == 4)
        {
            if(!strlen(inputtext) || !server_CheckEmail(inputtext))
            {
                format(infostring, sizeof(infostring), "{FF0000}Adresse email invalide.\n{FFFFFF}Entrez votre adresse email :");
                return ShowPlayerDialog(playerid, 81, DIALOG_STYLE_INPUT, "{33CCFF} Inscription {FFFFFF} Email", infostring, "Valider", "");
            }
            strmid(PlayerInfo[playerid][pEmail], inputtext, 0, 32, 32);
            // [PARRAINAGE] Email valide -> on demande le nom du parrain avant de finaliser
            // (la creation du compte + spawn se fait dans Referral_Finalize, step 11)
            Referral_AskName(playerid);
            inscription_Step[playerid] = 11;
            return 1;
        }
        if(inscription_Step[playerid] == 5)
        {
            if(listitem==0)
			{
			    format(infostring,sizeof(infostring),"{DABB3E}* Choisissez votre sexe *{FFFFFF}\n  Homme\n  Femme");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_LIST,"{33CCFF} Inscription {FFFFFF} Sexe - Etape {FF0000}2{FFFFFF}/3",infostring,"Valider","");
			}
			if(listitem==1){ PlayerInfo[playerid][pSex]=1;SetPlayerSkin(playerid, 26);PlayerInfo[playerid][pChar] = 26;}  // homme
			if(listitem==2){ PlayerInfo[playerid][pSex]=2;SetPlayerSkin(playerid, 298);PlayerInfo[playerid][pChar] = 298;} // femme
			format(infostring,sizeof(infostring),"{FFFFFF}Entrer votre adresse email :");
			ShowPlayerDialog(playerid,81,DIALOG_STYLE_INPUT,"{33CCFF} Inscription {FFFFFF} Email - Etape {FF0000}5{FFFFFF}/10",infostring,"Valider","");
			inscription_Step[playerid]=6;
			return 1;
        }
        if(inscription_Step[playerid] == 6)
        {
            if(!server_CheckEmail(inputtext))
			{
				format(infostring,sizeof(infostring),"{FF0000}Erreur dans l'adresse email.\n{FFFFFF}Entrer votre adresse email :");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_INPUT,"{33CCFF} Inscription {FFFFFF} Email - Etape {FF0000}5{FFFFFF}/10",infostring,"Valider","");
			}
			strmid(PlayerInfo[playerid][pEmail],inputtext,0,32,32);
			inscription_Step[playerid]=7;
			format(infostring,sizeof(infostring),"{DABB3E}* Choisissez une langue *{FFFFFF}\n  - Japonais\n  - Espagnol\n  - Russe\n  - Arabe\n  - Italien\n  - Allemand\n  - Franais\n  - Chinois\n  - Portugais\n  - Turc\n  - Antillais\n  - Mexicain\n  - Crole\n  - Jamaicain\n  - Coren\n  - Cantonais\n  - Ukrainien");
			ShowPlayerDialog(playerid,81,DIALOG_STYLE_LIST,"{33CCFF} Inscription {FFFFFF} Langue - Etape {FF0000}6{FFFFFF}/10",infostring,"Valider","");
            return 1;
        }
        if(inscription_Step[playerid] == 7)
        {
            if(listitem==0)
			{
			    format(infostring,sizeof(infostring),"{DABB3E}* Choisissez une langue *{FFFFFF}\n  - Japonais\n  - Espagnol\n  - Russe\n  - Arabe\n  - Italien\n  - Allemand\n  - Franais\n  - Chinois\n  - Portugais\n  - Turc\n  - Antillais\n  - Mexicain\n  - Crole\n  - Jamaicain\n  - Coren\n  - Cantonais\n  - Ukrainien");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_LIST,"{33CCFF} Inscription {FFFFFF} Langue - Etape {FF0000}6{FFFFFF}/10",infostring,"Valider","");
   			}
			PlayerInfo[playerid][pLang1]=listitem;
			inscription_Step[playerid]=8;
			format(infostring,sizeof(infostring),"{FFFFFF}Entrez votre ge :");
			ShowPlayerDialog(playerid,81,DIALOG_STYLE_INPUT,"{33CCFF} Inscription {FFFFFF} Age - Etape {FF0000}7{FFFFFF}/10",infostring,"Valider","");
            return 1;
        }
        if(inscription_Step[playerid] == 8)
        {
            if(!strlen(inputtext) || strval(inputtext) > 70 || strval(inputtext) < 16)
			{
			    format(infostring,sizeof(infostring),"{FF0000}Erreur dans l'ge, il doit tre compris entre 16 et 70 ans.\n{FFFFFF}Entrez votre ge :");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_INPUT,"{33CCFF} Inscription {FFFFFF} Age - Etape {FF0000}7{FFFFFF}/10",infostring,"Valider","");
   			}
			PlayerInfo[playerid][pAge]=strval(inputtext);
			inscription_Step[playerid]=9;
			format(infostring,sizeof(infostring),"{DABB3E}* Choisissez votre ville de rsidence *{FFFFFF}\n  - Los Santos\n  - San Fierro\n  - Las Venturas\n  - Fort Carson\n  - Bay Side\n  - Angel Pine\n  - Dillimore\n  - Blueberry\n  - Montgomery\n  - Palomino Creek\n  - Las Payasdas\n  - Las Barbancas\n  - El Quebrados");
			ShowPlayerDialog(playerid,81,DIALOG_STYLE_LIST,"{33CCFF} Inscription {FFFFFF} Ville - Etape {FF0000}8{FFFFFF}/10",infostring,"Valider","");
            return 1;
        }
        if(inscription_Step[playerid] == 9)
        {
   			if(listitem==0)
   			{
   			    format(infostring,sizeof(infostring),"{DABB3E}* Choisissez votre ville de rsidence *{FFFFFF}\n  - Los Santos\n  - San Fierro\n  - Las Venturas\n  - Fort Carson\n  - Bay Side\n  - Angel Pine\n  - Dillimore\n  - Blueberry\n  - Montgomery\n  - Palomino Creek\n  - Las Payasdas\n  - Las Barbancas\n  - El Quebrados");
				return ShowPlayerDialog(playerid,81,DIALOG_STYLE_LIST,"{33CCFF} Inscription {FFFFFF} Ville - Etape {FF0000}8{FFFFFF}/10",infostring,"Valider","");
   			}
   			PlayerInfo[playerid][pCity]=listitem-1;
			new sex[24];
			if(PlayerInfo[playerid][pSex] == 1) { sex = "Homme"; }
			else if(PlayerInfo[playerid][pSex] == 2) { sex = "Femme"; }
			format(title,sizeof(title),"{33CCFF} Inscription {FFFFFF} Recapitulatif - Etape {FF0000}3{FFFFFF}/3");
			format(infostring,sizeof(infostring),"{FFFFFF}Nom : %s\nMot de passe : ******\nSexe : %s\n\n{33AA33}Cliquez sur Creer pour finaliser.",PlayerInfo[playerid][pRealName],sex);
			ShowPlayerDialog(playerid,81,DIALOG_STYLE_MSGBOX,title,infostring,"Creer","Modifier");
			inscription_Step[playerid]=10;
			return 1;
        }
		if(listitem==0)
		    {inscription_Question(playerid); return 1;}
        
		if(listitem==inscription_ValidQuestion[playerid])
			{inscription_Note[playerid]++;}
        inscription_QuestionNumber[playerid]++;
        if(inscription_QuestionNumber[playerid]>=15)
		{
		    if(inscription_Note[playerid]>=12)
		    {
		        format(string,sizeof(string),"{FFFFFF}Vous avez russi le questionnaire de connaissance avec une note de %d/15.\nVous allez maintenant passer  la cration de votre compte.",inscription_Note[playerid]);
				ShowPlayerDialog(playerid,81,DIALOG_STYLE_MSGBOX,"{33CCFF} Inscription {FFFFFF} Information - {FF0000}1{FFFFFF}/8",string,"Valider","");
		        inscription_Step[playerid]=2;
		        inscription_Note[playerid]=0;
		        inscription_QuestionNumber[playerid]=0;
		        inscription_ValidQuestion[playerid]=0;
		        inscription_RandomList[playerid]=0;
		        return 1;
		    }
		    else
			{
			    format(string,sizeof(string),"{005660} Serveur {C8C8C8} Vous avez ratt le questionnaire avec une note de %d/15.");
			    msg_Client(playerid, COLOR_SERVER, string);
				MySQLKick(playerid,-1,"Questionnaire chou");
				return 1;
			}
		}
        else
			{inscription_Question(playerid); return 1;}
	}
	if(dialogid == 73)
	{
	    if(!response)
	    {
	        if(Dialogue_Admin_Panel[playerid] == 0){ Clicked[playerid] = -1; return 1;}
