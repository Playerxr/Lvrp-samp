stock Fix_FPSCameraOnDeath(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(gPlayerFPS[playerid] == true)
    {
        // Reset le mode FPS au respawn pour eviter cam coincee sur l'objet
        SetCameraBehindPlayer(playerid);
        gPlayerFPS[playerid] = false;
        if(IsValidObject(fpsObject[playerid]))
            DestroyObject(fpsObject[playerid]);
    }
    return 1;
}


