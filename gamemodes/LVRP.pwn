				    {
				        if(totalZones >= MAX_ZONE)
				            {return msg_Client(playerid,COLOR_WHITE,"{FF2727}\xbb Admin \xab{FFABAD} Maximum de zones Anti-DM atteint.");}
				        format(sql,sizeof(sql),"INSERT INTO lvrp_server_zones SET id=%d, min_X=%f, min_Y=%f, max_X=%f, max_Y=%f",totalZones+1,x1,y1,x2,y2);
				        mysql_pquery(MYSQL,sql);
				        ID = totalZones;
				        totalZones++;
				    }
				    ZoneInfo[ID][zMin][0] = x1;
				    ZoneInfo[ID][zMin][1] = y1;
				    ZoneInfo[ID][zMax][0] = x2;
				    ZoneInfo[ID][zMax][1] = y2;
				    ZoneInfo[ID][zSQLid] = totalZones;
				    if(IsValidDynamicArea(ZoneInfo[ID][zZone]))
				        {DestroyDynamicArea(ZoneInfo[ID][zZone]);}
				    ZoneInfo[ID][zZone] = CreateDynamicRectangle(x1,y1,x2,y2,0,0,-1);
				    format(string,sizeof(string),"{FF2727}\xbb Admin \xab{FFABAD} Zone Anti-DM %d cr\xe9\xe9e (50x50). Modifiez: /a edit zone.",ID);
				    msg_Client(playerid,COLOR_WHITE,string);
				    return 1;
				}
				return 1;
