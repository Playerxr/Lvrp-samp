stock Vote_OpenDialog(playerid)
{
    if(Vote_Active != 1)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756} Vote {FFFFFF} Aucun vote en cours actuellement.");
        return 1;
    }
    if(Vote_HasVoted[playerid] == 1)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756} Vote {FFFFFF} Vous avez d\xe9j\xe0 vot\xe9.");
        return 1;
    }
    new dialogStr[1500];
    new line[200];
    new restant = (Vote_StartTime + VOTE_DUREE_SEC) - gettime();
    new heures = restant / 3600;
    format(dialogStr, sizeof(dialogStr), "{FFAA00}=== ELECTION PRESIDENTIELLE ===\n{FFFFFF}Temps restant : {FFFF00}%dh{FFFFFF}\n\nChoisissez votre candidat :\n\n", heures);
    new countActive = 0;
    for(new c=0; c<MAX_CANDIDATS; c++)
    {
        if(Candidats[c][cActive] != 1) continue;
        format(line, sizeof(line), "{00FF00}%s {FFFFFF}- %s\n", Candidats[c][cName], Candidats[c][cParti]);
        strcat(dialogStr, line, sizeof(dialogStr));
        countActive++;
    }
    if(countActive == 0)
    {
        msg_Client(playerid, COLOR_INFO, "{CF9756} Vote {FFFFFF} Aucun candidat enregistr\xe9.");
        return 1;
    }
    ShowPlayerDialog(playerid, 9994, DIALOG_STYLE_LIST, "{FFAA00} Election Pr\xe9sidentielle ", dialogStr, "Voter", "Annuler");
    return 1;
}

stock Vote_OpenResults(playerid)
{
    new dialogStr[1500];
    new line[200];
    new totalVotes = 0;
    for(new c=0; c<MAX_CANDIDATS; c++)
    {
        if(Candidats[c][cActive] != 1) continue;
        totalVotes += Candidats[c][cVotes];
    }
    format(dialogStr, sizeof(dialogStr), "{FFAA00}=== RESULTATS DU VOTE ===\n");
    format(line, sizeof(line), "{FFFFFF}President actuel : {00FF00}%s{FFFFFF} ({FFFF00}%s{FFFFFF})\n\n", President_Current, President_Parti);
    strcat(dialogStr, line, sizeof(dialogStr));

    if(Vote_Active == 1)
    {
        format(line, sizeof(line), "{FFFFFF}Vote en cours - Total votes : {FFFF00}%d{FFFFFF}\n\n", totalVotes);
        strcat(dialogStr, line, sizeof(dialogStr));
        for(new c=0; c<MAX_CANDIDATS; c++)
        {
            if(Candidats[c][cActive] != 1) continue;
            new pct = 0;
            if(totalVotes > 0)
                pct = (Candidats[c][cVotes] * 100) / totalVotes;
            format(line, sizeof(line), "{00BFFF}%s {FFFFFF}({FFFF00}%s{FFFFFF}) : {00FF00}%d votes{FFFFFF} ({FFFF00}%d%%{FFFFFF})\n",
                Candidats[c][cName], Candidats[c][cParti], Candidats[c][cVotes], pct);
            strcat(dialogStr, line, sizeof(dialogStr));
        }
    }
    else
    {
        strcat(dialogStr, "{AAAAAA}Aucun vote en cours.\n", sizeof(dialogStr));
    }
    ShowPlayerDialog(playerid, 9995, DIALOG_STYLE_MSGBOX, "{FFAA00} R\xe9sultats Vote ", dialogStr, "OK", "");
    return 1;
}

stock Vote_End()
{
    if(Vote_Active != 1) return 0;
    new winnerIdx = -1;
    new maxVotes = 0;
    for(new c=0; c<MAX_CANDIDATS; c++)
    {
        if(Candidats[c][cActive] != 1) continue;
        if(Candidats[c][cVotes] > maxVotes)
        {
            maxVotes = Candidats[c][cVotes];
            winnerIdx = c;
        }
    }
    if(winnerIdx != -1)
    {
        format(President_Current, 64, "%s", Candidats[winnerIdx][cName]);
        format(President_Parti, 40, "%s", Candidats[winnerIdx][cParti]);
        new annonce[200];
        format(annonce, sizeof(annonce), "{FFAA00} Election {FFFFFF} Le nouveau Pr\xe9sident est : {00FF00}%s{FFFFFF} ({FFFF00}%s{FFFFFF}) avec {FF6347}%d votes{FFFFFF} !", President_Current, President_Parti, maxVotes);
        for(new p=0; p<MAX_PLAYERS_CURRENT+1; p++)
        {
            if(IsPlayerConnected(p) && !IsPlayerNPC(p))
                msg_Client(p, COLOR_WHITE, annonce);
        }
    }
    Vote_Active = 0;
    // Reset des candidats et votes pour la prochaine election
    for(new c=0; c<MAX_CANDIDATS; c++)
    {
        Candidats[c][cVotes] = 0;
        Candidats[c][cActive] = 0;
    }
    for(new p=0; p<MAX_PLAYERS; p++)
        Vote_HasVoted[p] = 0;
    return 1;
}

