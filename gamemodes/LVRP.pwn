						{msg_Client(playerid, COLOR_USAGE, "{A98500}Rang {FFFFFF}6{FFFFB2}: inviter - rang - virer - garer - ann(once) - gestion - feu - feumanuel - vrang");}
					return 1;
				}
				if(strcmp(tmp,"ann",true) == 0 || strcmp(tmp,"annonce",true) == 0)
