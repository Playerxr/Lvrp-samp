	            spike[i][pos][0]=0.0;
	            spike[i][pos][1]=0.0;
	            spike[i][pos][2]=0.0;
	            spike[i][faction]=0;
	            if(IsValidDynamicObject(spike_Object[i]))
	                {DestroyDynamicObject(spike_Object[i]);}
				if(IsValidDynamicArea(spike_Area[i]))
