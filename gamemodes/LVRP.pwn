            return i;
    }
    return -1;
}

stock Phone_AddMissedCall(playerid, fromnum, const fromname[])
{
    if(!IsPlayerConnected(playerid)) return 0;
    // Decale les anciens appels (FIFO)
    for(new i = MAX_PHONE_MISSED - 1; i > 0; i--)
    {
        PhoneMissed_Num[playerid][i] = PhoneMissed_Num[playerid][i-1];
        strmid(PhoneMissed_Name[playerid][i], PhoneMissed_Name[playerid][i-1], 0, 31, 32);
        PhoneMissed_Time[playerid][i] = PhoneMissed_Time[playerid][i-1];
    }
    PhoneMissed_Num[playerid][0] = fromnum;
    strmid(PhoneMissed_Name[playerid][0], fromname, 0, 31, 32);
    PhoneMissed_Time[playerid][0] = gettime();
    if(PhoneMissed_Count[playerid] < MAX_PHONE_MISSED)
        PhoneMissed_Count[playerid]++;
    return 1;
}

