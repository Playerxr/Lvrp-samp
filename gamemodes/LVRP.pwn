	            msg_Client(playerid, COLOR_USAGE, "{A98500} Usage {FFFFB2} /san <nom>");
	            msg_Client(playerid, COLOR_USAGE, "{A98500}Rang {FFFFFF}1{FFFFB2}: live - finlive - j(ournalist) - gagnant");
	            if(PlayerInfo[playerid][pRank] >= 5)
