public OnRconLoginAttempt(ip[], password[], success)
{
    if(!success)
    {
        printf("[RCON AC] Echec de %s : %s",ip, password);
        new pip[16];
        for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
        {
            GetPlayerIp(i, pip, sizeof(pip));
            if(!strcmp(ip, pip, true))
            {
                if(tentativeconexionrcon != 3)
                	{tentativeconexionrcon++;}
                else
                {
                    msg_Client(i, 0xFFFFFFFF, "Vous avez t banni pour tentative de conexion en RCON.");
                    MySQLBan(i,-1,"3 Echec RCON",-1);
                }
            }
        }
    }
    else
    	{tentativeconexionrcon = 0;}
    return 1;
}

public AutoSave_Tick()
{
    // === 1) Sauvegarde des joueurs connect�s (echelonnee) ===
    new saved = 0, delay = 0;
    for(new i=0; i<MAX_PLAYERS_CURRENT+1; i++)
    {
        if(!IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
        if(gPlayerLogged[i] != 1) continue;
        SetTimerEx("AutoSave_Player", delay * 2000, false, "i", i);
        delay++;
        saved++;
    }
    if(saved > 0)
        printf("[AUTOSAVE] %d joueurs sauvegardes a %d", saved, gettime());

    // === 2) Sauvegarde periodique des entites administratives ===
    // Sans ca, les changements (cash faction, prix bizz, gas vehicule, etc.)
    // sont perdus si le serveur crash entre 2 reboots.
    // Echelonne avec SetTimerEx pour eviter de bloquer le serveur.
    SetTimer("AutoSave_Vehicles", 1000, 0);
    SetTimer("AutoSave_Factions", 3000, 0);
    SetTimer("AutoSave_Bizz", 5000, 0);
    SetTimer("AutoSave_Garages", 7000, 0);
    SetTimer("AutoSave_UniqueBizz", 9000, 0);
    SetTimer("AutoSave_Houses", 11000, 0);
    return 1;
}

public AutoSave_Vehicles()
{
    new count=0;
    for(new i=1; i<=totalVehicles; i++)
    {
        // [SAFETY] Ignorer les slots invalides ou supprimes
        if(vehicle[i][SQLID] <= 0) continue;
        if(vehicle[i][used] != 1) continue;

        vehicle_Save(i, 0, 0); // pas de tuning/trunk pour limiter la charge
        count++;
    }
    if(count > 0) printf("[AUTOSAVE] %d v�hicules sauvegardes", count);
    return 1;
}

public AutoSave_Factions()
{
    new count=0;
    for(new i=0; i<totalFactions; i++)
    {
        // [SAFETY] Ignorer les factions non creees
        if(FactionInfo[i][fCreate] != 1) continue;

        faction_Save(i);
        count++;
    }
    if(count > 0) printf("[AUTOSAVE] %d factions sauvegard�es (LSPD/SFPD/LVPD/ill�gales)", count);
    return 1;
}

