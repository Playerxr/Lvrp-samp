public CreateDynamicLvrpActor(modelid, Float:X, Float:Y, Float:Z, Float:Rotation, vworld, bool:vulnera, type, varia, labelHead[])
{
	new tmpId = CreateDynamicActor(modelid, X, Y, Z, Rotation);
	SetDynamicActorVirtualWorld(tmpId,vworld);
	SetDynamicActorInvulnerable(tmpId,vulnera);
	actor[tmpId][pos][0]=X;
	actor[tmpId][pos][1]=Y;
	actor[tmpId][pos][2]=Z;
	actor[tmpId][world]=vworld;
	actor[tmpId][typeZ]=type;
	actor[tmpId][variable]=varia;
	actor[tmpId][label] = CreateDynamic3DTextLabel(labelHead,0xFFFFFFDD,actor[tmpId][pos][0], actor[tmpId][pos][1], actor[tmpId][pos][2]+1.05,NAME_DISTANCE,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0, actor[tmpId][world], -1, -1, 100.0);
	return tmpId;
}

stock GetCityCounty(playerid)
{
	if(PlayerInfo[playerid][pCity] == 0 || PlayerInfo[playerid][pCity] == 6 || PlayerInfo[playerid][pCity] == 7 || PlayerInfo[playerid][pCity] == 8 || PlayerInfo[playerid][pCity] == 9)
		{return 0;}
    else if(PlayerInfo[playerid][pCity] == 1 || PlayerInfo[playerid][pCity] == 5)
		{return 1;}
    else if(PlayerInfo[playerid][pCity] == 2 || PlayerInfo[playerid][pCity] == 3 || PlayerInfo[playerid][pCity] == 4 || PlayerInfo[playerid][pCity] == 10 || PlayerInfo[playerid][pCity] == 11 || PlayerInfo[playerid][pCity] == 12)
		{return 2;}
	else return 3;
}

stock GetFactionPaie(member, rank)
{
    // FIX : clamp rank en fonction du nombre de rangs de la faction
    new maxRank = 8;
    if(member == 14) maxRank = 6;  // Justice : 6 rangs seulement
    if(rank < 1) rank = 1;
    if(rank > maxRank) rank = maxRank;
    switch(member)
    {
        case 1, 2, 3, 4:  // Polices (LSPD, SFPD, LVPD, SASD)
            return 8000 + (rank-1) * 6000;   // 8k -> 50k
        case 5:            // FBI
            return 10000 + (rank-1) * 6500;  // 10k -> 49k
        case 6, 7, 8:      // Mairies (LS, SF, LV)
            return 15000 + (rank-1) * 3500;  // 15k -> 36k
        case 9:            // CIA
            return 25000 + (rank-1) * 5000;  // 25k -> 60k
        case 10:           // Pompiers
            return 8000 + (rank-1) * 3000;   // 8k -> 29k
        case 11, 12, 13:   // Armee (Terre, Air, Marine)
            return 10000 + (rank-1) * 4000;  // 10k -> 38k
        case 14:           // Cour de Justice (6 rangs)
            // 10k (Greffier) -> 50k (Procureur Republique)
            return 10000 + (rank-1) * 8000;
        case 15:           // Hopital (8 rangs)
            // 10k (Aide-Soignant) -> 50k (Directeur)
            return 10000 + ((rank-1) * 40000) / 7;
    }
    return 0;
}

stock ConvertirTexte (Texte[])
{
	new coriginal[22] = {192, 199, 200, 201, 202, 203, 207, 217, 219, 220, 224, 226, 231, 232, 233, 234, 235, 238, 239, 249, 251, 252};
    new cconvertis[22] = {128, 133, 134, 135, 136, 137, 141, 146, 148, 149, 151, 153, 156, 157, 158, 159, 160, 163, 164, 169, 171, 172};
    new len = strlen(Texte);
    for (new i; i < len; i++)
    {
        for(new j;j < 22;j++)
        {
             if(Texte[i] == coriginal[j])
             {
                  Texte[i] = cconvertis[j];
                  break;
             }
        }
    }
}

public MySQLCreateAccount(newplayersname[], newpassword[], mail[], sex, origin, lang, age, regcity)
{
	new sqlplyname[32],sqlpassword[64],sqlmail[32],cryptepass[128];
	mysql_escape_string(newplayersname, sqlplyname);
	mysql_escape_string(newpassword, sqlpassword);
	mysql_escape_string(mail, sqlmail);
	sha1(sqlpassword,cryptepass);
	format(sql, sizeof(sql), "INSERT INTO lvrp_users Set Name='%s', Pass='%s', Email='%s', Sex=%d, Origin=%d, Lang1=%d, Age=%d, City=%d, Inscription=UNIX_TIMESTAMP()", sqlplyname, cryptepass, sqlmail, sex, origin, lang, age, regcity);
	mysql_query(MYSQL,sql);
	new newplayersid = MySQLCheckAccount(newplayersname);
	if (newplayersid != 0)
	{
	    for(new i=0; i<5; i++)
	        {format(sql, sizeof(sql), "INSERT INTO lvrp_users_accessories Set SQLid=%d, IndexZ=%d", newplayersid, i);mysql_query(MYSQL,sql);}
	    format(sql, sizeof(sql), "INSERT INTO lvrp_users_inventories Set SQLid=%d", newplayersid);
		mysql_query(MYSQL,sql);
		format(sql, sizeof(sql), "INSERT INTO lvrp_users_phones SET SQLid=%d",newplayersid);
		mysql_query(MYSQL,sql);
		return newplayersid;
	}
	return 0;
}

// === AFRP PHONE - Callbacks de chargement (FIX CRASH) ===
// Ces fonctions etaient appelees via mysql_tquery mais n'existaient pas,
// ce qui faisait planter le serveur des qu'un joueur se loguait.
forward Phone_LoadUser(playerid);
public Phone_LoadUser(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new count = 0;
    cache_get_row_count(count);
    if(count > 0)
    {
        cache_get_value_name_int(0, "HasPhone", hasPhone[playerid]);
        cache_get_value_name_int(0, "Number", playerNumber[playerid]);
        cache_get_value_name_int(0, "PhoneModel", phoneModel[playerid]);
        cache_get_value_name_int(0, "Trade0", tradeHolding[playerid][0]);
        cache_get_value_name_int(0, "Trade1", tradeHolding[playerid][1]);
        cache_get_value_name_int(0, "Trade2", tradeHolding[playerid][2]);
        cache_get_value_name_int(0, "Trade3", tradeHolding[playerid][3]);
    }
    else
    {
        hasPhone[playerid] = 0;
        playerNumber[playerid] = 0;
        phoneModel[playerid] = 0;
        tradeHolding[playerid][0] = 0;
        tradeHolding[playerid][1] = 0;
        tradeHolding[playerid][2] = 0;
        tradeHolding[playerid][3] = 0;
    }
    return 1;
}

forward Phone_LoadSettings(playerid);
public Phone_LoadSettings(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new count = 0;
    cache_get_row_count(count);
    if(count > 0)
    {
        cache_get_value_name_int(0, "Credit", playerCredit[playerid]);
    }
    else
    {
        playerCredit[playerid] = 0;
    }
    return 1;
}

// === [APP IMMO] Callback de chargement (FIX CRASH) ===
// Meme bug que Phone_LoadUser/Phone_LoadSettings ci-dessus : appelee via
// mysql_tquery depuis /immo et l'app telephone (case 10) mais n'existait
// pas -> plantait le serveur des qu'un joueur ouvrait l'app Immobilier.
forward Immo_ListHouses(playerid);
public Immo_ListHouses(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    new rows = 0;
    cache_get_row_count(rows);
    if(rows <= 0)
    {
        return SendClientMessage(playerid, -1, "{FF4444}[Immo]{FFFFFF} Aucune maison a vendre pour le moment.");
    }
    if(rows > 15) rows = 15;
    new list[1200];
    list[0] = EOS;
    new line[90];
    for(new r = 0; r < rows; r++)
    {
        new hid = 0, hPrice = 0;
        new Float:hx = 0.0, Float:hy = 0.0;
        cache_get_value_name_int(r, "id", hid);
        cache_get_value_name_int(r, "Price", hPrice);
        cache_get_value_name_float(r, "Pos_x", hx);
        cache_get_value_name_float(r, "Pos_y", hy);
        new hPriceStr[16];
        FormatMoney(hPrice, hPriceStr, 16);
        format(line, sizeof(line), "{FFAA00}Maison #%d{FFFFFF} - %s$ (%.0f, %.0f)\n", hid, hPriceStr, hx, hy);
        strcat(list, line, sizeof(list));
    }
    ShowPlayerDialog(playerid, 9372, DIALOG_STYLE_LIST, "{00BFFF}Immobilier - Maisons a vendre", list, "OK", "Retour");
    return 1;
}

public OnPlayerLogin(playerid,pass[])
{
    // === AFRP PHONE - Charger telephone a chaque login ===
    new fooPhone[120];
    mysql_format(MYSQL, fooPhone, sizeof(fooPhone), "SELECT * FROM `lvrp_afrp_phone` WHERE `Username` = '%e'", PlayerInfo[playerid][pName]);
    mysql_tquery(MYSQL, fooPhone, "Phone_LoadUser", "d", playerid);
    mysql_tquery(MYSQL, fooPhone, "Phone_LoadSettings", "d", playerid);
    // CreateNotificationTD(playerid); // AFRP: fonction TD notification supprim�e
	new string2[128],cryptepass[128],playernamesplit[3][MAX_PLAYER_NAME];
	split(PlayerInfo[playerid][pRealName], playernamesplit, '_');

	MySQLCheckConnexion();
	sha1(pass,cryptepass);
	MySQLFetchAcctSingle(PlayerInfo[playerid][pSQLID], "Pass", PlayerInfo[playerid][pKey]);
	if(strcmp(PlayerInfo[playerid][pKey],cryptepass, false ) == 0 )
	{
	    MySQLCheckConnexion();
		format(sql, sizeof(sql), "SELECT * FROM lvrp_users WHERE id = %d LIMIT 1", PlayerInfo[playerid][pSQLID]);
		mysql_query(MYSQL,sql);
		new count = 0;
		if(cache_get_row_count(count) && count > 0)
		{
		    cache_get_value_name(0,"Pass",PlayerInfo[playerid][pKey], 64);
		    cache_get_value_name_int(0,"Level", PlayerInfo[playerid][pLevel]);
		    cache_get_value_name_int(0,"AdminLevel", PlayerInfo[playerid][pAdmin]);
		    
		    // FIX BUG : Mode admin-only - rejett� les non-admins
		    if(AdminOnlyMode == 1 && PlayerInfo[playerid][pAdmin] < AdminOnly_MinLevel)
		    {
		        msg_Client(playerid, COLOR_INFO, "{FF0000}\xbb Serveur \xab{FFFFFF} Le serveur est en mode {FFFF00}admin-only{FFFFFF}.");
		        msg_Client(playerid, COLOR_INFO, "{FF0000}\xbb Serveur \xab{FFFFFF} Maintenance/test en cours. Reessayez plus tard.");
		        SetTimerEx("TimerKick", 2000, 0, "i", playerid);
		        return 1;
		    }
		    
		    cache_get_value_name_int(0,"Age", PlayerInfo[playerid][pAge]);
		    cache_get_value_name_int(0,"DonateRank", PlayerInfo[playerid][pDonateRank]);
		    cache_get_value_name_int(0,"City", PlayerInfo[playerid][pCity]);
		    cache_get_value_name_int(0,"VipTime", PlayerInfo[playerid][pVipTime]);
		    cache_get_value_name_int(0,"ConnectedTime", PlayerInfo[playerid][pConnectTime]);
		    cache_get_value_name_int(0,"Sex", PlayerInfo[playerid][pSex]);
		    cache_get_value_name_int(0,"Origin", PlayerInfo[playerid][pOrigin]);
		    cache_get_value_name_int(0,"Respect", PlayerInfo[playerid][pExp]);
		    cache_get_value_name_int(0,"Cash", PlayerInfo[playerid][pCash]);
		    cache_get_value_name_int(0,"Bank", PlayerInfo[playerid][pAccount]);
		    cache_get_value_name_int(0,"Deaths", PlayerInfo[playerid][pDeaths]);

			SafeResetPlayerMoney(playerid,PlayerInfo[playerid][pCash]);
			
			cache_get_value_name_int(0,"Wanted", PlayerInfo[playerid][pWanted]);
			cache_get_value_name_int(0,"LottoNr", PlayerInfo[playerid][plottoNr]);
			cache_get_value_name_int(0,"Fishes", PlayerInfo[playerid][pFishes]);
		 	cache_get_value_name_int(0,"Job", PlayerInfo[playerid][pJob]);
			cache_get_value_name_int(0,"JobLvl", PlayerInfo[playerid][pJobLvl]);
			cache_get_value_name_int(0,"JobExp", PlayerInfo[playerid][pJobExp]);
			cache_get_value_name_int(0,"JobTime", PlayerInfo[playerid][pJobTime]);
			cache_get_value_name_int(0,"JobBonnus", PlayerInfo[playerid][pJobBonus]);
			cache_get_value_name_int(0,"Paycheck", PlayerInfo[playerid][pPayCheck]);
			cache_get_value_name_int(0,"Jailed", PlayerInfo[playerid][pJailed]);
			// Hardcore RP
			cache_get_value_name_int(0,"ComaTime", PlayerInfo[playerid][pComaTime]);
			// Cap a 600 (10 min) au cas ou un ancien coma long aurait �t� sauve en DB
			if(PlayerInfo[playerid][pComaTime] > 600)
				{PlayerInfo[playerid][pComaTime] = 600;}
			if(PlayerInfo[playerid][pComaTime] > 0)
			{
			    medic_PlayerNeedMedic[playerid] = 2;
			    medic_PlayerMedicTime[playerid] = PlayerInfo[playerid][pComaTime];
			    msg_Client(playerid, COLOR_INFO, "{CF9756}\xbb Coma \xab{FFFFFF} Vous etes toujours en coma !");
			}
			cache_get_value_name_int(0,"JailTime", PlayerInfo[playerid][pJailTime]);
			cache_get_value_name_int(0,"Leader", PlayerInfo[playerid][pLeader]);
			cache_get_value_name_int(0,"Member", PlayerInfo[playerid][pMember]);
			
			cache_get_value_name_int(0,"Rank", PlayerInfo[playerid][pRank]);
			// FIX : valider le skin charge de la DB (skins 74, 265-272 cassent)
			{
			    new skinFromDB = 26;
			    cache_get_value_name_int(0, "Skin", skinFromDB);
			    if(skinFromDB < 0 || skinFromDB > 311) skinFromDB = 26;
			    else if(skinFromDB == 74) skinFromDB = 26;
			    else if(skinFromDB >= 265 && skinFromDB <= 272) skinFromDB = 26;
			    PlayerInfo[playerid][pChar] = skinFromDB;
			}
			cache_get_value_name_int(0,"Spawn", PlayerInfo[playerid][pSpawn]);
			cache_get_value_name_int(0,"Faim", PlayerInfo[playerid][pFaim]);
			cache_get_value_name_int(0,"Soif", PlayerInfo[playerid][pSoif]);
			cache_get_value_name_int(0,"ComaTime", PlayerInfo[playerid][pComaTime]);
			// Cap a 600 (10 min) au cas ou un ancien coma long aurait �t� sauve en DB
			if(PlayerInfo[playerid][pComaTime] > 600)
				{PlayerInfo[playerid][pComaTime] = 600;}
			// Reprendre le coma apres reconnexion
			if(PlayerInfo[playerid][pComaTime] > 0)
			{
			    medic_PlayerNeedMedic[playerid] = 2;
			    medic_PlayerMedicTime[playerid] = PlayerInfo[playerid][pComaTime];
			    TogglePlayerControllable(playerid, 0);
			    // [FIX AGONIE] Lecture unique + gel au sol (voir OnPlayerSpawn) : plus de glitch "sur pied"
			    ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 0, 1, 1, 1, 0, 1);
			    new comaStr[40];
			    format(comaStr,sizeof(comaStr),"~r~COMA~n~~w~%d:%02d",PlayerInfo[playerid][pComaTime]/60,PlayerInfo[playerid][pComaTime]%60);
			    GameTextForPlayer(playerid, comaStr, 5000, 3);
			    msg_Client(playerid,COLOR_INFO,"{CF9756}\xbb Coma \xab{FFFFFF} Vous etes toujours en coma. Attendez ou appelez un medecin (/appel 15).");
			}
			// [HP PERSIST] Charge la vie/armure sauvees pour les restaurer au spawn
			HpPersist_LoadFromCache(playerid);
			cache_get_value_name_int(0,"Disease", PlayerInfo[playerid][pDisease]);
			cache_get_value_name_int(0,"Interior", PlayerInfo[playerid][pInt]);
			cache_get_value_name_int(0,"PhoneNr", PlayerInfo[playerid][pNumber]);
